-export function safeAIError(error: unknown): { httpStatus: number | null } {
+export type AiErrorClass =
+  | 'quota_refused'
+  | 'rate_limited'
+  | 'upstream_4xx'
+  | 'upstream_5xx'
+  | 'timeout'
+  | 'network_error'
+  | 'auth_error'
+  | 'schema_invalid'
