+import {expect,it,vi,beforeEach,afterEach} from 'vitest'
+import {createHmac} from 'node:crypto'
+const ingest=vi.hoisted(()=>vi.fn(async(_parsed:unknown)=>({status:'duplicate'})))
+vi.mock('../conversation.email-inbound.service',()=>({ingestParsedEmail:ingest}))
+vi.mock('../conversation.mail-slug',()=>({currentMailSlug:()=> 'reply'}))
+import {handleVoidInboundEmail} from '../email-void-handler'
+const secret='synthetic-inbound-test-secret'
+const envKeys=['EMAIL_VOID_INBOUND_SECRET','EMAIL_INBOUND_DOMAIN','EMAIL_INBOUND_SIGNING_SECRET']
+let saved:Record<string,string|undefined>
+beforeEach(()=>{saved=Object.fromEntries(envKeys.map(k=>[k,process.env[k]]));process.env.EMAIL_VOID_INBOUND_SECRET=secret;process.env.EMAIL_INBOUND_DOMAIN='reply.example.test';process.env.EMAIL_INBOUND_SIGNING_SECRET='synthetic-reply-signing';ingest.mockClear()})
+afterEach(()=>{envKeys.forEach(k=>{if(saved[k]===undefined)delete process.env[k];else process.env[k]=saved[k]})})
+const payload={version:'iplaycafe.void-mail/1',deliveryId:'void-'+'a'.repeat(64),mailSlug:'reply',envelopeTo:'reply@reply.example.test',rawSize:200,email:{from:'user@example.test',to:['reply@reply.example.test'],subject:'Help',text:'body',message_id:'original@example.test',headers:{'In-Reply-To':'<parent@example.test>','References':'<parent@example.test>','Authentication-Results':'attacker; dmarc=pass'},attachments:[{filename:'a.txt',content_type:'text/plain',content:'QUI='}]}}
+function signed(value:unknown=payload,timestamp=String(Math.floor(Date.now()/1000))){const body=JSON.stringify(value);return new Request('https://feedback.example.test/api/chat/email/inbound',{method:'POST',headers:{'content-type':'application/vnd.iplaycafe.void-mail+json','x-qb-void-timestamp':timestamp,'x-qb-void-signature':createHmac('sha256',secret).update(timestamp+'.void-normalized.').update(body).digest('hex')},body})}
+it('authenticated normalized MIME reaches stock ingest with threading/attachment bytes but no forged MTA assertion',async()=>{
+  expect((await handleVoidInboundEmail(signed())).status).toBe(200)
+  expect(ingest).toHaveBeenCalledTimes(1)
+  const value=ingest.mock.calls[0][0] as any
+  expect(value).toMatchObject({from:'user@example.test',messageId:'original@example.test',inReplyTo:'parent@example.test',references:['parent@example.test'],authenticationResults:null,transportMessageId:payload.deliveryId,attachments:[{bytes:Buffer.from('AB')}]})
+})
+it('signature tampering, expired/future signature and cross-workspace envelope fail before ingest',async()=>{
+  const tampered=signed();tampered.headers.set('x-qb-void-signature','0'.repeat(64))
+  for(const request of [tampered,signed(payload,'1'),signed(payload,String(Math.floor(Date.now()/1000)+300)),signed({...payload,mailSlug:'other'}),signed({...payload,envelopeTo:'reply@attacker.test'})])expect((await handleVoidInboundEmail(request)).status).not.toBe(200)
+  expect(ingest).not.toHaveBeenCalled()
+})
+it('encoded inbound over 10MiB and malformed attachment reject without silent truncation',async()=>{
+  for(const value of [{...payload,rawSize:10*1024*1024+1},{...payload,email:{...payload.email,attachments:[{filename:'x',content:'!not-base64'}]}}])expect((await handleVoidInboundEmail(signed(value))).status).toBe(400)
+  expect(ingest).not.toHaveBeenCalled()
+})
+const normalizedRoundtrip=process.env.MAIL_PLATFORM_NORMALIZER?it:it.skip
+normalizedRoundtrip('real native normalized attachment-only MIME reaches authenticated stock ingest',async()=>{
+  const {normalizeInbound}=await import(/* @vite-ignore */ process.env.MAIL_PLATFORM_NORMALIZER!)
+  const envelope=await normalizeInbound({to:'reply@reply.example.test',rawSize:200},{from:{address:'user@example.test'},headers:[],attachments:[{filename:'proof.txt',mimeType:'text/plain',content:new Uint8Array([65,66]).buffer}]},'reply.example.test','reply','a'.repeat(64))
+  expect(envelope.email.text).toBeUndefined();expect(envelope.email.html).toBeUndefined()
+  expect((await handleVoidInboundEmail(signed(envelope))).status).toBe(200)
+  expect(ingest.mock.calls[0][0]).toMatchObject({attachments:[{bytes:Buffer.from('AB'),filename:'proof.txt'}]})
+})
