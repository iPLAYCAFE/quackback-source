+++ b/apps/web/src/components/shared/__tests__/visitor-beacon-off.test.tsx
@@ -0,0 +1,142 @@
+// @vitest-environment happy-dom
+/**
+ * iPLAYCAFE fork: the portal sends no visitor pageview beacon and keeps no
+ * device id.
+ *
+ * Upstream's VisitorBeacon, mounted on every page by the root document, posts
+ * a pageview to /api/track on the portal, changelog and help-center routes and
+ * writes a one-year first-party `qb_device` cookie carrying a device id. Our
+ * portals have no consent or privacy disclosure for either (PDPA), so the
+ * component must send nothing and set no cookie, and must expire a `qb_device`
+ * cookie an earlier build left so a returning visitor loses the old id.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, render, screen } from '@testing-library/react'
+import {
+  Outlet,
+  RouterProvider,
+  createMemoryHistory,
+  createRootRoute,
+  createRoute,
+  createRouter,
+} from '@tanstack/react-router'
+import { VisitorBeacon } from '../visitor-beacon'
+
+const sendBeacon = vi.fn(() => true)
+const fetchSpy = vi.fn(
+  async (_input: RequestInfo | URL, _init?: RequestInit) => new Response(null, { status: 204 })
+)
+const cookieWrites: string[] = []
+// The DOM's own cookie accessor, wherever the environment defines it on the prototype chain.
+const cookieDescriptor = (() => {
+  for (let proto = Object.getPrototypeOf(document); proto; proto = Object.getPrototypeOf(proto)) {
+    const descriptor = Object.getOwnPropertyDescriptor(proto, 'cookie')
+    if (descriptor?.get && descriptor.set) return descriptor
+  }
+  throw new Error('document.cookie accessor not found')
+})()
+
+function clearCookies() {
+  for (const pair of document.cookie.split('; ').filter(Boolean)) {
+    cookieDescriptor.set!.call(document, `${pair.split('=')[0]}=; Max-Age=0; Path=/`)
+  }
+}
+
+beforeEach(() => {
+  clearCookies()
+  cookieWrites.length = 0
+  vi.stubGlobal('navigator', { ...navigator, sendBeacon, doNotTrack: null })
+  vi.stubGlobal('fetch', fetchSpy)
+  Object.defineProperty(document, 'cookie', {
+    configurable: true,
+    get: () => cookieDescriptor.get!.call(document),
+    set: (value: string) => {
+      cookieWrites.push(value)
+      cookieDescriptor.set!.call(document, value)
+    },
+  })
+})
+
+afterEach(() => {
+  cleanup()
+  delete (document as unknown as Record<string, unknown>).cookie
+  clearCookies()
+  vi.unstubAllGlobals()
+  sendBeacon.mockClear()
+  fetchSpy.mockClear()
+})
+
+function buildRouter(initial: string) {
+  const rootRoute = createRootRoute({
+    component: () => (
+      <>
+        <VisitorBeacon />
+        <Outlet />
+      </>
+    ),
+  })
+  const portal = createRoute({ getParentRoute: () => rootRoute, id: '/_portal', component: () => <Outlet /> })
+  const portalHome = createRoute({
+    getParentRoute: () => portal,
+    path: '/',
+    validateSearch: (search: Record<string, unknown>) => search as { page?: string },
+    component: () => <p>portal page</p>,
+  })
+  const changelog = createRoute({
+    getParentRoute: () => rootRoute,
+    path: '/changelog',
+    component: () => <p>changelog page</p>,
+  })
+  const help = createRoute({ getParentRoute: () => rootRoute, path: '/hc', component: () => <p>help page</p> })
+  return createRouter({
+    routeTree: rootRoute.addChildren([portal.addChildren([portalHome]), changelog, help]),
+    history: createMemoryHistory({ initialEntries: [initial] }),
+  })
+}
+
+async function mount(initial: string, text: string) {
+  const router = buildRouter(initial)
+  render(<RouterProvider router={router} />)
+  await screen.findByText(text)
+  return router
+}
+
+function trackCalls() {
+  return fetchSpy.mock.calls.filter(([input]) => String(input).includes('/api/track'))
+}
+
+describe('portal visitor beacon (fork: off)', () => {
+  it('sends no pageview and sets no device cookie on a portal page', async () => {
+    const router = await mount('/', 'portal page')
+    await act(() => router.navigate({ to: '/', search: { page: '2' } } as never))
+
+    expect(sendBeacon).not.toHaveBeenCalled()
+    expect(trackCalls()).toHaveLength(0)
+    expect(cookieWrites).toEqual([])
+    expect(document.cookie).not.toContain('qb_device=')
+  })
+
+  it('sends nothing from the standalone changelog and help-center trees', async () => {
+    const router = await mount('/changelog', 'changelog page')
+    await act(() => router.navigate({ to: '/hc' } as never))
+    await screen.findByText('help page')
+
+    expect(sendBeacon).not.toHaveBeenCalled()
+    expect(trackCalls()).toHaveLength(0)
+    expect(cookieWrites).toEqual([])
+  })
+
+  it('expires a device id cookie an earlier build left', async () => {
+    cookieDescriptor.set!.call(document, 'qb_device=11111111-2222-4333-8444-555555555555; Path=/')
+    cookieDescriptor.set!.call(document, 'other=kept; Path=/')
+    expect(document.cookie).toContain('qb_device=')
+
+    await mount('/', 'portal page')
+
+    expect(cookieWrites).toEqual(['qb_device=; Max-Age=0; Path=/; SameSite=Lax'])
+    expect(document.cookie).not.toContain('qb_device=')
+    expect(document.cookie).toContain('other=kept')
+    expect(sendBeacon).not.toHaveBeenCalled()
+    expect(trackCalls()).toHaveLength(0)
+  })
+})
