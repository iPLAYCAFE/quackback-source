+      await first.execute(sql`set lock_timeout = '8s'`)
+      await first.execute(sql`set statement_timeout = '10s'`)
+      await second.execute(sql`set lock_timeout = '8s'`)
+      await second.execute(sql`set statement_timeout = '10s'`)
+      const [winningPid] = await first.execute(sql`select pg_backend_pid() as pid`)
+      const [retryPid] = await second.execute(sql`select pg_backend_pid() as pid`)
+      winner = routing.run(winnerDb, () => createTicketCore(input, actor))
+      void winner.catch(() => {})
+      try {
+        await Promise.race([reachedCommit,
