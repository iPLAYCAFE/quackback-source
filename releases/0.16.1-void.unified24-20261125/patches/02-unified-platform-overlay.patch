+/**
+ * Real-DB coverage for one person's support erasure: plan reads only, apply
+ * erases exactly the planned set and refuses a stale token, a storage failure
+ * changes no row, and another person's data, shared files and the team stay.
+ * Each case below was a confirmed review finding (2026-10-20) before the fix.
+ */
+import { describe, it, expect, beforeEach, afterEach, afterAll, vi } from 'vitest'
+import { createDbTestFixture, testDb } from '@/lib/server/__tests__/db-test-fixture'
+import {
+  boards,
+  channelIdentities,
+  conversationMessages,
+  conversations,
+  emailLog,
+  eq,
+  files,
+  inAppNotifications,
+  postComments,
+  posts,
+  principal,
+  ticketConversations,
+  tickets,
+  ticketStatuses,
+  user,
+} from '@/lib/server/db'
+import { createId, type ConversationId, type PrincipalId } from '@quackback/ids'
+
+vi.mock('@/lib/server/db', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/db')>()),
+  db: (await import('@/lib/server/__tests__/db-test-fixture')).testDb,
+}))
+
+const deleted: string[] = []
+const failingKeys = new Set<string>()
+vi.mock('@/lib/server/storage/s3', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/storage/s3')>()),
+  deleteObject: vi.fn(async (key: string) => {
+    if (failingKeys.has(key)) throw new Error(`storage unavailable for ${key}`)
+    deleted.push(key)
+  }),
+}))
+vi.mock('@/lib/server/cache', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/cache')>()),
+  cacheDel: vi.fn(async () => {}),
+}))
+
+import { applySupportErasure, planSupportErasure, SupportErasureRefused } from '../support-erasure'
+import { DELETED_USER_PRINCIPAL_ID } from '@/lib/server/domains/principals/principal-reattribute'
+import { removePortalUser } from '@/lib/server/domains/users/user.service'
+
+const fixture = await createDbTestFixture({
+  probe: async (db) => {
+    await db.select({ id: files.id }).from(files).limit(0)
+    await db.select({ id: channelIdentities.principalId }).from(channelIdentities).limit(0)
+  },
+})
+
+let seq = 0
+const next = () => (seq += 1)
+
+async function person(opts: { externalId?: string; email?: string; role?: string } = {}) {
+  const n = next()
+  const userId = createId('user')
+  const principalId = createId('principal')
+  await testDb.insert(user).values({
+    id: userId,
+    name: `Person ${n}`,
+    email: opts.email ?? `person-${n}@example.test`,
+    externalId: opts.externalId ?? null,
+    imageKey: `avatars/person-${n}.webp`,
+  })
+  await testDb.insert(principal).values({
+    id: principalId,
+    userId,
+    role: opts.role ?? 'user',
+    type: 'user',
+    displayName: `Person ${n}`,
+    createdAt: new Date(),
+  })
+  return { userId, principalId }
+}
+
+async function anonymous(contactEmail: string | null = null) {
+  const principalId = createId('principal')
+  await testDb.insert(principal).values({
+    id: principalId,
+    role: 'user',
+    type: 'anonymous',
+    contactEmail,
+    createdAt: new Date(),
+  })
+  return principalId
+}
+
+async function file(uploadedById: PrincipalId | null, messageId: string | null) {
+  const n = next()
+  const [f] = await testDb
+    .insert(files)
+    .values({
+      storageKey: `files/2026/10/erase-${n}.png`,
+      name: `erase-${n}.png`,
+      contentType: 'image/png',
+      family: 'image',
+      size: 1,
+      sha256: 'd'.repeat(64),
+      source: 'visitor',
+      uploadedById,
+      messageId: messageId as typeof files.$inferInsert.messageId,
+      attachedAt: new Date(),
+      meta: { thumbKey: `files/2026/10/erase-${n}-thumb.webp` },
+    })
+    .returning()
+  return f!
+}
+
+const attach = (f: { id: string; name: string }) => [
+  {
+    url: '/api/storage/x',
+    name: f.name,
+    contentType: 'image/png',
+    size: 1,
+    fileId: f.id,
+    family: 'image',
+  },
+]
+
+async function say(
+  conversationId: ConversationId,
+  principalId: PrincipalId | null,
+  values: Partial<typeof conversationMessages.$inferInsert> = {}
+) {
+  const [m] = await testDb
+    .insert(conversationMessages)
+    .values({
+      conversationId,
+      principalId,
+      senderType: principalId ? 'visitor' : 'system',
+      content: 'text',
+      ...values,
+    })
+    .returning()
+  return m!
+}
+
+/** A thread with one visitor message carrying an uploaded file. */
+async function thread(
+  visitor: PrincipalId,
+  extra: Partial<typeof conversations.$inferInsert> = {}
+) {
+  const [c] = await testDb
+    .insert(conversations)
+    .values({ visitorPrincipalId: visitor, channel: 'messenger', ...extra })
+    .returning()
+  const m = await say(c!.id, visitor, { content: 'my screenshot' })
+  const f = await file(visitor, m.id)
+  await testDb
+    .update(conversationMessages)
+    .set({ attachments: attach(f) as never })
+    .where(eq(conversationMessages.id, m.id))
+  return { conversation: c!, message: m, file: f }
+}
+
+async function ticketFor(
+  requester: PrincipalId | null,
+  type: 'customer' | 'back_office' = 'customer'
+) {
+  const n = next()
+  const [s] = await testDb
+    .insert(ticketStatuses)
+    .values({ name: `e${n}`, slug: `erase-status-${n}`, category: 'open' })
+    .returning()
+  const [t] = await testDb
+    .insert(tickets)
+    .values({ title: 'report', statusId: s!.id, type, requesterPrincipalId: requester })
+    .returning()
+  return t!
+}
+
+async function feedbackPost(author: PrincipalId, canonicalPostId: string | null = null) {
+  const boardId = createId('board')
+  await testDb.insert(boards).values({ id: boardId, slug: `erase-board-${next()}`, name: 'Bugs' })
+  const postId = createId('post')
+  await testDb.insert(posts).values({
+    id: postId,
+    boardId,
+    title: 'Bug',
+    content: 'details',
+    principalId: author,
+    canonicalPostId: canonicalPostId as typeof posts.$inferInsert.canonicalPostId,
+  })
+  return postId
+}
+
+type Table =
+  | typeof conversations
+  | typeof tickets
+  | typeof files
+  | typeof principal
+  | typeof user
+  | typeof posts
+const count = async (table: Table, id: string) =>
