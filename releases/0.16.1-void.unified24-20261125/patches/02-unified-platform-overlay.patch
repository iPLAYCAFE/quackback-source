+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createSDK } from '../src/core/sdk'
+const origin = 'https://feedback.example.test'
+const source = { postMessage: vi.fn() } as unknown as Window
+vi.mock('../src/core/panel', () => ({
+  createPanel: () => ({
+    iframe: document.createElement('iframe'),
+    show() {},
+    hide() {},
+    destroy() {},
+    setPlacement() {},
+    setExpanded() {},
+  }),
+}))
+beforeEach(() => {
+  document.body.innerHTML = ''
+  document.head.innerHTML = ''
+  vi.spyOn(HTMLIFrameElement.prototype, 'contentWindow', 'get').mockReturnValue(source)
+  vi.stubGlobal(
+    'matchMedia',
+    vi.fn(() => ({ matches: false, addEventListener() {}, removeEventListener() {} }))
+  )
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(async () => ({ ok: true, json: async () => ({}) }))
+  )
+  vi.mocked(source.postMessage).mockClear()
+})
+afterEach(() => {
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+})
+function ready() {
+  window.dispatchEvent(
+    new MessageEvent('message', { origin, source, data: { type: 'quackback:ready' } })
+  )
+}
+const nativeCalls = () =>
+  vi.mocked(source.postMessage).mock.calls.filter(([data]) => data.type === 'quackback:native')
+function upload(file: Blob) {
+  return {
+    contract: 'iplaycafe.feedback/native-1',
+    operationId: crypto.randomUUID(),
+    type: 'upload-attachment',
+    payload: { file, name: 'report.png' },
+  }
+}
+describe('native upload-attachment transport', () => {
+  it('queues before readiness and posts the identical Blob for structured cloning', () => {
+    const sdk = createSDK()
+    sdk.dispatch('init', { instanceUrl: origin })
+    const file = new Blob([new Uint8Array([1, 2, 3])], { type: 'image/png' })
+    const command = upload(file)
+    sdk.dispatch('native', command)
+    expect(nativeCalls()).toHaveLength(0)
+    ready()
+    expect(nativeCalls()).toHaveLength(1)
+    const [message, target] = nativeCalls()[0]
+    expect(target).toBe(origin)
+    expect(message.data).toBe(command)
+    expect(message.data.payload.file).toBe(file)
+    expect(message.data.payload.file).toBeInstanceOf(Blob)
+    sdk.dispatch('destroy')
+  })
+  it('posts a ready-time Blob command directly without serialising it', () => {
+    const sdk = createSDK()
+    sdk.dispatch('init', { instanceUrl: origin })
+    sdk.dispatch('native', {
+      contract: 'iplaycafe.feedback/native-1',
+      operationId: crypto.randomUUID(),
+      type: 'list-tickets',
+      payload: {},
+    })
+    ready()
+    expect(nativeCalls()).toHaveLength(1)
+    const file = new Blob([new Uint8Array([4, 5])], { type: 'video/webm' })
+    sdk.dispatch('native', upload(file))
+    expect(nativeCalls()).toHaveLength(2)
+    expect(nativeCalls()[1][0].data.payload.file).toBe(file)
+    expect(typeof nativeCalls()[1][0].data).toBe('object')
+    sdk.dispatch('destroy')
+  })
+})
