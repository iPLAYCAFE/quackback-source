+    await expect(invoke({data: {context, action: {type: 'reply-ticket', payload: {ticketId: own.ticketId, content: 'Visitor reply'}}}})).resolves.toEqual({id: 'native-reply'})
+    expect(ports.reply).toHaveBeenCalledWith(ctx, {conversationId: own.conversationId, content: 'Visitor reply'})
+  })
+  it.each(['widget', 'portal'])('revokes only the bound %s bearer and confirms a repeated identical retirement', async scope => {
+    const ctx = await owner(), other = await owner()
+    ports.auth.mockResolvedValue(ctx)
+    const ownId = crypto.randomUUID(), otherId = crypto.randomUUID()
+    await testDb.insert(session).values([{id: ownId, token: ports.bearer, userId: ctx.user.id, scope, updatedAt: new Date(), expiresAt: new Date(Date.now()+60_000)}, {id: otherId, token: 'other-bearer', userId: other.user.id, scope, updatedAt: new Date(), expiresAt: new Date(Date.now()+60_000)}])
+    await testDb.insert(widgetIdentifiedSession).values({sessionId: ownId, hmacVerified: true, identitySource: 'hmac'})
+    const now = Math.floor(Date.now()/1000)
+    const claim = {aud: 'https://feedback.example.test', jti: crypto.randomUUID(), iat: now, exp: now+60, ipc: context}
+    expect(await consumeNativeHostToken(claim)).toBe(true)
+    await bindNativeHostSession(ownId, ctx.principal.id, claim)
