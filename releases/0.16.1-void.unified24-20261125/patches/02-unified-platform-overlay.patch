+      const pair = await first.select().from(ticketConversations).where(eq(ticketConversations.ticketId, created.id))
+      expect(await first.select().from(tickets).where(eq(tickets.requesterPrincipalId, principalId))).toHaveLength(1)
+      expect(pair).toHaveLength(1)
+      expect(await first.select().from(conversations).where(eq(conversations.visitorPrincipalId, principalId))).toHaveLength(1)
+      const messages = await first.select().from(conversationMessages).where(eq(conversationMessages.conversationId, pair[0].conversationId))
+      expect(messages).toHaveLength(1)
+      expect(messages[0]).toMatchObject({principalId, senderType: 'visitor', content: input.description, ticketId: null})
+      expect(await first.select().from(conversationMessages).where(eq(conversationMessages.ticketId, created.id))).toHaveLength(0)
+      expect(await routing.run(second, () => createTicketCore(input, actor))).toMatchObject({id: created.id})
+      await expect(routing.run(second, () => createTicketCore({...input, title: 'Conflicting native report',
+        nativeSubmission: {...input.nativeSubmission, digest: nativeSubmissionDigest({
+          title: 'Conflicting native report', description: input.description,
+        })}}, actor))).rejects.toMatchObject({code: 'SUBMISSION_CONFLICT'})
+      const mapping = await first.execute(sql`select ticket_id from ipc_native_submission where principal_id = ${principalId} and submission_id = ${submissionId}`)
+      expect(mapping).toHaveLength(1); expect(mapping[0].ticket_id).toBe(created.id)
+      expect(await first.select().from(tickets).where(eq(tickets.requesterPrincipalId, principalId))).toHaveLength(1)
+      expect(await first.select().from(conversationMessages).where(eq(conversationMessages.conversationId, pair[0].conversationId))).toHaveLength(1)
+    } finally {
+      clearTimeout(commitTimer)
+      release()
+      await Promise.allSettled([...(winner ? [winner] : []), ...(loser ? [loser] : [])])
+      // Exact generated owner bounds all cleanup, including partially failed
+      // intake rows. Cascading message/pair/watcher children are native FKs.
+      await first.transaction(async tx => {
+        await tx.execute(sql`delete from ipc_native_submission where principal_id = ${principalId} and submission_id = ${submissionId}`)
+        await tx.delete(tickets).where(eq(tickets.requesterPrincipalId, principalId))
+        await tx.delete(conversations).where(eq(conversations.visitorPrincipalId, principalId))
+        await tx.delete(principal).where(eq(principal.id, principalId))
+        await tx.delete(user).where(eq(user.id, userId))
+        await tx.delete(ticketStatuses).where(eq(ticketStatuses.id, statusId))
+        await tx.delete(settings).where(eq(settings.id, settingsId))
+      })
+    }
+  }, 30_000)
+})
