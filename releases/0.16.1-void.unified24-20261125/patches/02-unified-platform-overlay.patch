+      settings.openaiBaseUrl = 'https://openrouter.ai/api/v1'
+      settings.aiReasoningEffort = 'high'
+      const bodies: WireBody[] = []
+      vi.stubGlobal(
+        'fetch',
+        vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+          const request = new Request(input, init)
+          expect(request.url).toBe(settings.aiCustomerAgentBaseUrl + '/chat/completions')
+          expect(request.redirect).toBe('error')
+          expect(request.headers.get('authorization')).toBe('Bearer synthetic-customer-workers-key')
+          expect(request.headers.get('cf-aig-gateway-id')).toBe('customer')
+          expect(request.headers.has('cf-aig-authorization')).toBe(false)
+          const body = JSON.parse(await request.text())
+          bodies.push(body)
+          expect(bodies.length).toBeLessThanOrEqual(tools ? 2 : 1)
+          return completion(body.stream)
+        })
+      )
+      const outcome = await runSynthesis({
+        customerAgentRoute: true,
+        model: 'synthetic-customer-model',
+        systemPrompts: ['Return synthetic JSON.'],
+        messages: [{ role: 'user', content: 'Synthetic fixture.' }],
+        outputSchema: z.object({ ok: z.boolean() }),
+        deltaField: 'ok',
+        salvageMode: 'strict',
+        salvage: () => null,
