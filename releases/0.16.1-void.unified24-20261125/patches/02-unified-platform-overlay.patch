+}
+async function pair(requester: Awaited<ReturnType<typeof owner>>, type = 'customer', deletedAt: Date | null = null) {
+  const statusId = createId('ticket_status'), conversationId = createId('conversation'), ticketId = createId('ticket')
+  await testDb.insert(ticketStatuses).values({id: statusId, name: 'Synthetic open', slug: statusId, category: 'open', position: 0})
+  await testDb.insert(conversations).values({id: conversationId, visitorPrincipalId: requester.principal.id, channel: 'messenger'})
+  await testDb.insert(tickets).values({id: ticketId, title: 'Private report', statusId, type: type as 'customer', requesterPrincipalId: requester.principal.id, deletedAt})
+  await testDb.insert(ticketConversations).values({ticketId, conversationId, ticketType: 'customer'})
+  return {ticketId, conversationId}
+}
+describe.skipIf(!fixture.available)('native Ticket facade real PostgreSQL ownership and retirement', () => {
