@@ -0,0 +1,51 @@
+import { useSyncExternalStore } from 'react'
+import { NATIVE_HOST_CONTRACT } from '@/lib/shared/widget/native-host'
+
+let config: { origin: string; enabled: boolean; label: string } = {
+  origin: '',
+  enabled: false,
+  label: '',
+}
+const listeners = new Set<() => void>()
+const empty = { origin: '', enabled: false, label: '' }
+export function configureNativeCapture(origin: string, payload: Record<string, unknown>) {
+  config = {
+    origin,
+    enabled: payload.enabled === true,
+    label: typeof payload.label === 'string' ? payload.label.slice(0, 100) : 'Report an issue',
+  }
+  for (const listener of listeners) listener()
+}
+
+/** Host owns capture/editor/consent; this is only the one native Home action.
+ *  Null unless an armed host origin configured it; the Home overview renders it
+ *  as its first action card. `request` asks that host (and only it) to capture. */
+export function useNativeCaptureAction(): { label: string; request: () => void } | null {
+  const value = useSyncExternalStore(
+    (callback) => {
+      listeners.add(callback)
+      return () => {
+        listeners.delete(callback)
+      }
+    },
+    () => config,
+    () => empty
+  )
+  if (!value.enabled || !value.origin) return null
+  return {
+    label: value.label,
+    request: () =>
+      window.parent.postMessage(
+        {
+          type: 'quackback:event',
+          name: 'native-capture-request',
+          payload: {
+            contract: NATIVE_HOST_CONTRACT,
+            audience: window.location.origin,
+            hostOrigin: value.origin,
+          },
+        },
+        value.origin
+      ),
+  }
+}
