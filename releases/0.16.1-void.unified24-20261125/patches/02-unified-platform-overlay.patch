+import { beforeEach, describe, expect, it, vi } from 'vitest'
+vi.mock('@tanstack/react-router', () => ({createFileRoute: () => (options: unknown) => ({options})}))
+vi.mock('@/lib/server/config', () => ({config: {baseUrl: 'https://feedback.example.test'}}))
+vi.mock('@/lib/server/domains/settings/settings.widget', () => ({getWidgetConfig: vi.fn(async () => ({enabled: true})), getWidgetSecret: vi.fn(async () => 'fake')}))
+vi.mock('@/lib/server/auth/widget-rate-limit', () => ({checkWidgetIdentifyRateLimit: vi.fn(async () => ({allowed: true}))}))
+vi.mock('@/lib/server/domains/api/rate-limit', () => ({getClientIp: () => '127.0.0.1'}))
+vi.mock('@/lib/server/widget/identity-token', () => ({verifyHS256JWT: vi.fn(() => null)}))
+vi.mock('@/lib/server/widget/native-host-token', async original => ({
+  ...await original<typeof import('@/lib/server/widget/native-host-token')>(), revokePreviousNativeHostSession: vi.fn(async () => {}),
+}))
+import { Route } from '../identify'
+import { getWidgetConfig } from '@/lib/server/domains/settings/settings.widget'
+import { checkWidgetIdentifyRateLimit } from '@/lib/server/auth/widget-rate-limit'
+import { revokePreviousNativeHostSession } from '@/lib/server/widget/native-host-token'
+const POST = (Route as unknown as {options: {server: {handlers: {POST: (input: {request: Request}) => Promise<Response>}}}}).options.server.handlers.POST
+const ipc = {contract: 'iplaycafe.feedback/native-1', operationId: crypto.randomUUID(), hostOrigin: 'https://app.example.test'}
+const body = {ssoToken: 'invalid-SSO', previousToken: 'previous-owned-token', ipc}
+function request(value = body, bearer = body.previousToken) {
+  return POST({request: new Request('https://feedback.example.test/api/widget/identify', {method: 'POST',
