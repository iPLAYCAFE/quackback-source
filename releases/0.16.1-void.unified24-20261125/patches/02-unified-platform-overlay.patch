+    const ctx = await owner(), other = await owner()
+    ports.auth.mockResolvedValue(ctx)
+    const foreign = await pair(other), deleted = await pair(ctx, 'customer', new Date()), tracker = await pair(ctx, 'back_office')
+    for (const ticketId of [foreign.ticketId, deleted.ticketId, tracker.ticketId, 'malformed-ticket']) {
+      await expect(invoke({data: {context, action: {type, payload: {ticketId, content: 'Visitor reply'}}}})).rejects.toThrow('Ticket not found')
+    }
+    expect(ports.read).not.toHaveBeenCalled(); expect(ports.reply).not.toHaveBeenCalled(); expect(ports.summary).not.toHaveBeenCalled()
