diff --git a/apps/web/src/lib/server/widget/__tests__/native-host-session.integration.test.ts b/apps/web/src/lib/server/widget/__tests__/native-host-session.integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c5f8d502f65041577db8a0e4001d792798c1887e
--- /dev/null
+++ b/apps/web/src/lib/server/widget/__tests__/native-host-session.integration.test.ts
@@ -0,0 +1,100 @@
+import { afterAll, afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createId } from '@quackback/ids'
+vi.mock('@/lib/server/db', async original => ({
+  ...await original<typeof import('@/lib/server/db')>(),
+  db: (await import('@/lib/server/__tests__/db-test-fixture')).testDb,
+}))
+vi.mock('@/lib/server/config', () => ({config: {baseUrl: 'https://feedback.example.test'}}))
+import { createDbTestFixture, testDb } from '@/lib/server/__tests__/db-test-fixture'
+import { session, user, widgetIdentifiedSession, sql } from '@/lib/server/db'
+import { findOrCreateSession } from '@/routes/api/widget/identify'
+import { bindNativeHostSession, consumeNativeHostToken, requireBoundNativeHostSession, revokePreviousNativeHostSession, retireNativeHostSession } from '../native-host-token'
+
+const context = {contract: 'iplaycafe.feedback/native-1' as const, operationId: crypto.randomUUID(), hostOrigin: 'https://app.example.test'}
+const fixture = await createDbTestFixture({probe: async db => {await db.execute(sql`select 1 from ipc_native_session_binding limit 0`)}})
+afterAll(fixture.close)
+async function seed(scope: 'widget' | 'portal' | 'dashboard' = 'widget') {
+    const userId = createId('user'), principalId = createId('principal'), sessionId = crypto.randomUUID(), token = crypto.randomUUID()
+    const now = Math.floor(Date.now()/1000)
+    const claims = {aud: 'https://feedback.example.test', jti: crypto.randomUUID(), iat: now, exp: now+60, ipc: context}
+    await testDb.insert(user).values({id: userId, name: 'Synthetic native session regression'})
+    await testDb.insert(session).values({id: sessionId, token, userId, scope,
+      expiresAt: new Date(Date.now()+60_000), createdAt: new Date(), updatedAt: new Date()})
+    // Native provenance insertion correctly demotes a dashboard scope. A
+    // dashboard-refusal witness must retain the actual stored dashboard scope.
+    if (scope !== 'dashboard') await testDb.insert(widgetIdentifiedSession).values({sessionId, hmacVerified: true, identitySource: 'hmac'})
+    expect(await testDb.execute(sql`select scope from session where id=${sessionId}`))
+      .toMatchObject([{scope}])
+    expect(await consumeNativeHostToken(claims)).toBe(true)
+    await bindNativeHostSession(sessionId, principalId, claims)
+    return {userId, principalId, sessionId, token, claims}
+  }
+
+describe.skipIf(!fixture.available)('native bound-session revocation on real PostgreSQL', () => {
+  beforeEach(fixture.begin)
+  afterEach(fixture.rollback)
+  it('reconciles a lost logout response through the exact durable receipt without restoring access', async () => {
+    const value = await seed()
+    await expect(retireNativeHostSession(value.token, context)).resolves.toEqual({loggedOut: true})
+    expect(await testDb.execute(sql`select id from session where id=${value.sessionId}`)).toHaveLength(0)
+    await expect(requireBoundNativeHostSession(value.principalId, context, value.token)).rejects.toThrow('NATIVE_SESSION_BINDING_REQUIRED')
+    await expect(retireNativeHostSession(value.token + '.synthetic-signature', context)).resolves.toEqual({loggedOut: true})
+    expect(await testDb.execute(sql`select token_sha256 from ipc_native_retirement`)).toHaveLength(1)
+    await expect(retireNativeHostSession(value.token, {...context, operationId: crypto.randomUUID()})).rejects.toThrow('NATIVE_SESSION_REVOCATION_FAILED')
+    await expect(retireNativeHostSession(value.token, {...context, hostOrigin: 'https://other.example.test'})).rejects.toThrow('NATIVE_SESSION_REVOCATION_FAILED')
+    await testDb.execute(sql`update ipc_native_retirement set audience='https://other-feedback.example.test'`)
+    await expect(retireNativeHostSession(value.token, context)).rejects.toThrow('NATIVE_SESSION_REVOCATION_FAILED')
+  })
+  it('refuses unknown, dashboard, expired-receipt and unbound bearers without a success confirmation', async () => {
+    await expect(retireNativeHostSession(crypto.randomUUID(), context)).rejects.toThrow('NATIVE_SESSION_REVOCATION_FAILED')
+    const dashboard = await seed('dashboard')
+    await expect(retireNativeHostSession(dashboard.token, context)).rejects.toThrow('NATIVE_SESSION_REVOCATION_FAILED')
+    expect(await testDb.execute(sql`select id from session where id=${dashboard.sessionId}`)).toHaveLength(1)
+    const value = await seed()
+    await testDb.execute(sql`delete from ipc_native_session_binding where session_id=${value.sessionId}`)
+    await expect(retireNativeHostSession(value.token, context)).rejects.toThrow('NATIVE_SESSION_REVOCATION_FAILED')
+    expect(await testDb.execute(sql`select id from session where id=${value.sessionId}`)).toHaveLength(1)
+    const retired = await seed()
+    await retireNativeHostSession(retired.token, context)
+    await testDb.execute(sql`update ipc_native_retirement set expires_at=now()-interval '1 second'`)
+    await expect(retireNativeHostSession(retired.token, context)).rejects.toThrow('NATIVE_SESSION_REVOCATION_FAILED')
+  })
+  it.each(['widget', 'portal'] as const)('revokes exact %s binding while keeping JWT redemption terminal', async scope => {
+    const value = await seed(scope)
+    expect(await requireBoundNativeHostSession(value.principalId, context, value.token)).toBe(value.sessionId)
+    await revokePreviousNativeHostSession(value.token, context)
+    await expect(requireBoundNativeHostSession(value.principalId, context, value.token)).rejects.toThrow('NATIVE_SESSION_BINDING_REQUIRED')
+    expect(await testDb.execute(sql`select session_id from ipc_native_session_binding where session_id=${value.sessionId}`)).toHaveLength(0)
+    expect(await consumeNativeHostToken(value.claims)).toBe(false)
+  })
+  it('does not revoke a dashboard token, another bearer or a different host origin', async () => {
+    const value = await seed()
+    await revokePreviousNativeHostSession(crypto.randomUUID(), context)
+    await revokePreviousNativeHostSession(value.token, {...context, hostOrigin: 'https://other.example.test'})
+    expect(await requireBoundNativeHostSession(value.principalId, context, value.token)).toBe(value.sessionId)
+    const dashboard = await seed('dashboard')
+    await revokePreviousNativeHostSession(dashboard.token, context)
+    expect(await testDb.execute(sql`select id from session where id=${dashboard.sessionId}`)).toHaveLength(1)
+    await expect(requireBoundNativeHostSession(dashboard.principalId, context, dashboard.token)).rejects.toThrow('NATIVE_SESSION_BINDING_REQUIRED')
+  })
+})
+
+
+// Uses the exact repository query and session creation path on the required
+// disposable PostgreSQL fixture. No test returns production bearer values.
+describe.skipIf(!fixture.available)('ordinary SSO cannot reuse an issuer-owned native bearer', () => {
+  beforeEach(fixture.begin)
+  afterEach(fixture.rollback)
+  const request = () => new Request('https://feedback.example.test/api/widget/identify')
+  it.each(['widget', 'portal'] as const)('excludes bound %s sessions while reusing an unbound identified session', async scope => {
+    const native = await seed(scope)
+    const ordinary = await findOrCreateSession(native.userId, request())
+    expect(ordinary.id).not.toBe(native.sessionId)
+    expect(ordinary.token).not.toBe(native.token)
+    expect(await testDb.execute(sql`select session_id from ipc_native_session_binding where session_id=${ordinary.id}`)).toHaveLength(0)
+    await testDb.insert(widgetIdentifiedSession).values({sessionId: ordinary.id, hmacVerified: true, identitySource: 'hmac'})
+    expect(await findOrCreateSession(native.userId, request())).toEqual(ordinary)
+    await revokePreviousNativeHostSession(native.token, context)
+    expect(await testDb.execute(sql`select id from session where id=${ordinary.id}`)).toHaveLength(1)
+  })
+})
