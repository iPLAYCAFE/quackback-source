diff --git a/packages/db/drizzle/0296_ipc_help_center_native_private.sql b/packages/db/drizzle/0296_ipc_help_center_native_private.sql
new file mode 100644
index 000000000..1e7dd38ac
--- /dev/null
+++ b/packages/db/drizzle/0296_ipc_help_center_native_private.sql
@@ -0,0 +1,26 @@
+-- The migrator runs this entire transition in its migration transaction.
+-- LOCK excludes concurrent category inserts/reparenting during subtree conversion.
+LOCK TABLE kb_categories IN ACCESS EXCLUSIVE MODE;
+--> statement-breakpoint
+DROP TRIGGER IF EXISTS ipc_kb_category_inherit_tier ON kb_categories;
+DROP TRIGGER IF EXISTS ipc_kb_category_cascade_tier ON kb_categories;
+DROP FUNCTION IF EXISTS ipc_kb_category_inherit_tier();
+DROP FUNCTION IF EXISTS ipc_kb_category_cascade_tier();
+--> statement-breakpoint
+DO $$ BEGIN
+  IF EXISTS (SELECT 1 FROM information_schema.columns
+    WHERE table_schema = current_schema() AND table_name = 'kb_categories' AND column_name = 'admin_only') THEN
+    -- UNION terminates even if legacy category data contains a cycle. No
+    -- deleted_at filter: an undeleted descendant must remain native private.
+    WITH RECURSIVE protected AS (
+      SELECT id FROM kb_categories WHERE admin_only
+      UNION
+      SELECT c.id FROM kb_categories c JOIN protected p ON c.parent_id = p.id
+    )
+    UPDATE kb_categories SET is_public = false WHERE id IN (SELECT id FROM protected);
+    ALTER TABLE kb_categories DROP CONSTRAINT IF EXISTS kb_categories_admin_only_not_public;
+    -- The archive preserves the original values. Clear the inert column so
+    -- replay cannot override subsequent native category visibility edits.
+    UPDATE kb_categories SET admin_only = false WHERE admin_only;
+  END IF;
+END $$;
