@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest'
+import { classificationModelOptions } from '../classification-model-options'
+
+describe('classificationModelOptions', () => {
+  it('keeps every non-Luna model option unchanged', () => {
+    const options = {
+      max_tokens: 100,
+      reasoning: { effort: 'high' },
+      provider: { require_parameters: true },
+    }
+    expect(classificationModelOptions('other-model', options)).toBe(options)
+  })
+
+  it('uses Luna Chat Completions fields and retains unrelated provider options', () => {
+    const result = classificationModelOptions('gpt-6-luna', {
+      max_tokens: 100,
+      reasoning: { effort: 'high' },
+      reasoning_effort: 'high',
+      response_format: { type: 'json_schema' },
+      provider: { require_parameters: true, data_collection: 'deny' },
+    })
+    expect(result).toEqual({
+      max_completion_tokens: 100,
+      reasoning_effort: 'none',
+      response_format: { type: 'json_schema' },
+      provider: { require_parameters: true, data_collection: 'deny' },
+    })
+    expect(result).not.toHaveProperty('max_tokens')
+    expect(result).not.toHaveProperty('reasoning')
+  })
+})
