@@ -0,0 +1,106 @@
+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const fixture = vi.hoisted(() => ({
+  config: {
+    openaiApiKey: 'synthetic-classification-key',
+    openaiBaseUrl: 'https://openrouter.ai/api/v1',
+    openaiDefaultHeaders: '{"x-classification-test":"synthetic-classification-header"}',
+    aiRequireParameters: undefined as boolean | undefined,
+  },
+  model: 'gpt-6-luna',
+  log: { info: () => {}, warn: () => {}, error: () => {}, debug: () => {} },
+}))
+
+vi.mock('@/lib/server/config', () => ({ config: fixture.config }))
+vi.mock('@/lib/server/domains/ai/models', () => ({
+  getChatModel: () => fixture.model,
+}))
+vi.mock('@/lib/server/domains/settings/tier-enforce', () => ({
+  enforceAiTokenBudget: async () => {},
+}))
+vi.mock('@/lib/server/domains/settings/settings.spam', () => ({
+  getSpamFilterConfig: async () => ({ trustedSenders: [], aiClassifier: true }),
+  isTrustedSender: () => false,
+}))
+vi.mock('@/lib/server/domains/ai/usage-middleware', () => ({
+  createUsageLoggingMiddleware: () => ({ name: 'synthetic-usage-middleware' }),
+}))
+vi.mock('@/lib/server/logger', () => ({
+  logger: { child: () => fixture.log },
+}))
+
+import { classifyInboundAsSpam } from '../conversation.spam-filter'
+
+const input = {
+  senderEmail: 'synthetic@example.test',
+  subject: 'Synthetic classification request',
+  content: 'Synthetic request body for the installed SDK wire test.',
+}
+
+beforeEach(() => {
+  fixture.config.openaiApiKey = 'synthetic-classification-key'
+  fixture.config.openaiBaseUrl = 'https://openrouter.ai/api/v1'
+  fixture.config.openaiDefaultHeaders =
+    '{"x-classification-test":"synthetic-classification-header"}'
+  fixture.config.aiRequireParameters = undefined
+})
+
+describe('classification request options on the installed OpenAI-compatible SDK', () => {
+  afterEach(() => vi.restoreAllMocks())
+
+  it('uses Luna completion options while retaining schema, gateway headers, and no-train routing', async () => {
+    fixture.model = 'gpt-6-luna'
+    const originalFetch = globalThis.fetch
+    const observed: Array<{ request: Request; body: Record<string, unknown> }> = []
+    globalThis.fetch = Object.assign(
+      async (input: string | URL | Request, init?: RequestInit) => {
+        const request = new Request(input, init)
+        observed.push({ request, body: await request.clone().json() })
+        return Response.json({ error: { message: 'synthetic transport stop' } }, { status: 400 })
+      },
+      { preconnect: originalFetch.preconnect }
+    )
+    try {
+      await expect(classifyInboundAsSpam(input)).resolves.toBe(false)
+    } finally {
+      globalThis.fetch = originalFetch
+    }
+
+    expect(observed).toHaveLength(1)
+    const { request, body } = observed[0]!
+    expect(request.url).toBe('https://openrouter.ai/api/v1/chat/completions')
+    expect(request.headers.get('authorization')).toBe('Bearer synthetic-classification-key')
+    expect(request.headers.get('x-classification-test')).toBe('synthetic-classification-header')
+    expect(body).toHaveProperty('max_completion_tokens', 100)
+    expect(body).not.toHaveProperty('max_tokens')
+    expect(body).toHaveProperty('reasoning_effort', 'none')
+    expect(body.response_format).toMatchObject({ type: 'json_schema' })
+    expect(body.provider).toEqual({ require_parameters: true, data_collection: 'deny' })
+  })
+
+  it('leaves other classification models on their existing max_tokens wire shape', async () => {
+    fixture.model = 'synthetic-legacy-classifier'
+    const originalFetch = globalThis.fetch
+    const observed: Array<Record<string, unknown>> = []
+    globalThis.fetch = Object.assign(
+      async (input: string | URL | Request, init?: RequestInit) => {
+        const request = new Request(input, init)
+        observed.push(await request.clone().json())
+        return Response.json({ error: { message: 'synthetic transport stop' } }, { status: 400 })
+      },
+      { preconnect: originalFetch.preconnect }
+    )
+    try {
+      await expect(classifyInboundAsSpam(input)).resolves.toBe(false)
+    } finally {
+      globalThis.fetch = originalFetch
+    }
+
+    expect(observed).toHaveLength(1)
+    expect(observed[0]).toHaveProperty('max_tokens', 100)
+    expect(observed[0]).not.toHaveProperty('max_completion_tokens')
+    expect(observed[0]).not.toHaveProperty('reasoning_effort')
+    expect(observed[0]?.provider).toEqual({ require_parameters: true, data_collection: 'deny' })
+  })
+})
