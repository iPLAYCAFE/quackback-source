+/**
+ * Preserve the existing classification option object for every model except
+ * the measured Chat Completions model that rejects `max_tokens`.
+ */
+export function classificationModelOptions(
+  model: string,
+  options: Record<string, unknown>
+): Record<string, unknown> {
+  if (model !== 'gpt-6-luna') return options
+
+  const providerOptions = { ...options }
+  delete providerOptions.max_tokens
+  delete providerOptions.reasoning
+  if (typeof options.max_tokens === 'number') {
+    providerOptions.max_completion_tokens = options.max_tokens
+  }
+  providerOptions.reasoning_effort = 'none'
+  return providerOptions
+}
