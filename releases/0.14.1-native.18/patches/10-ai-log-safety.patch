+// Fake provider only, with the application's exact installed SDK dependencies.
+// node logging-wire.regression.node.mjs EXACT_APP_DEPENDENCY_DIR
+import assert from 'node:assert/strict'
+import { readFileSync, readdirSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { createRequire } from 'node:module'
+import { pathToFileURL } from 'node:url'
+import { getAIChatOptions, getOpenAIClientOptions, safeAIError } from '../client-options.ts'
+
+const deps = resolve(process.argv[2])
+for (const [name, version] of Object.entries({
+  openai: '7.15.0',
+  '@tanstack/ai': '0.54.0',
+  '@tanstack/ai-openai': '0.22.6',
+})) {
+  assert.equal(
+    JSON.parse(readFileSync(resolve(deps, 'node_modules', name, 'package.json'))).version,
+    version
+  )
+}
+const require = createRequire(resolve(deps, 'package.json'))
+const { default: OpenAI } = await import(pathToFileURL(require.resolve('openai')))
+const { chat } = await import(
+  pathToFileURL(resolve(deps, 'node_modules/@tanstack/ai/dist/esm/index.js'))
+)
+const { openaiCompatibleText } = await import(
+  pathToFileURL(resolve(deps, 'node_modules/@tanstack/ai-openai/dist/esm/compatible/index.js'))
+)
+const { z } = await import(pathToFileURL(require.resolve('zod')))
+
+function files(folder) {
+  return readdirSync(folder, { withFileTypes: true }).flatMap((entry) =>
+    entry.name === '__tests__'
+      ? []
+      : entry.isDirectory()
+        ? files(resolve(folder, entry.name))
+        : entry.name.endsWith('.ts')
+          ? [resolve(folder, entry.name)]
+          : []
+  )
+}
+let calls = 0
+for (const file of files(resolve(import.meta.dirname, '../..'))) {
+  const source = readFileSync(file, 'utf8')
+  const chatCalls = [...source.matchAll(/^\s*[^\n]*\bchat\(\{\n/gm)].length
+  if (!chatCalls) continue
+  assert.equal(
+    [...source.matchAll(/^\s*[^\n]*\bchat\(\{\n\s*\.\.\.getAIChatOptions\(\),/gm)].length,
+    chatCalls
+  )
+  calls += chatCalls
+}
+assert.equal(calls, 12)
+const CANARY = 'synthetic-provider-secret-canary'
+const options = getOpenAIClientOptions({
+  openaiApiKey: 'synthetic-unused-key',
+  openaiBaseUrl: 'https://gateway.example/v1',
+  openaiDefaultHeaders: '{"Authorization":null,"cf-aig-authorization":"Bearer synthetic-gateway"}',
+})
+const originalFetch = globalThis.fetch
+const originalLogLevel = process.env.OPENAI_LOG
+const methods = ['error', 'warn', 'info', 'debug', 'log', 'dir']
+const originalConsole = Object.fromEntries(methods.map((method) => [method, console[method]]))
+const logs = []
+let requests = 0
+process.env.OPENAI_LOG = 'debug'
+for (const method of methods) console[method] = (...args) => logs.push(args)
+globalThis.fetch = async (input, init) => {
+  const request = new Request(input, init)
+  assert.equal(request.headers.has('authorization'), false)
+  requests++
+  return Response.json(
+    { error: { message: CANARY, code: CANARY, type: 'authentication_error' } },
+    { status: 401, headers: { 'x-provider-private': CANARY } }
+  )
+}
+try {
+  const sdk = new OpenAI(options)
+  await assert.rejects(
+    sdk.chat.completions.create({ model: 'synthetic', messages: [] }),
+    (error) => {
+      assert.equal(
+        error.message.includes(CANARY),
+        true,
+        'Internal provider error remains available for classification'
+      )
+      assert.deepEqual(safeAIError(error), { httpStatus: 401 })
+      return true
+    }
+  )
+  await assert.rejects(sdk.embeddings.create({ model: 'synthetic', input: 'synthetic' }))
+  const adapter = openaiCompatibleText('synthetic', options)
+  for (const stream of [false, true]) {
+    try {
+      const response = chat({
+        ...getAIChatOptions(),
+        adapter,
+        messages: [{ role: 'user', content: 'synthetic' }],
+        stream,
+      })
+      if (stream) {
+        for await (const _chunk of response) {
+        }
+      } else await response
+    } catch (error) {
+      assert.equal(error.message.includes(CANARY), true)
+    }
+  }
+  await assert.rejects(
+    chat({
+      ...getAIChatOptions(),
+      adapter,
+      messages: [{ role: 'user', content: 'synthetic' }],
+      stream: false,
+      outputSchema: z.object({ ok: z.boolean() }),
+    })
+  )
+  assert.equal(requests, 5)
+  assert.equal(logs.length, 0)
+  const malformed = Object.defineProperty({}, 'status', {
+    get() {
+      throw new Error(CANARY)
+    },
+  })
+  assert.deepEqual(safeAIError(malformed), { httpStatus: null })
+  const cycle = { message: CANARY }
+  cycle.cause = cycle
+  assert.deepEqual(safeAIError(cycle), { httpStatus: null })
+  for (const status of [0, 99, 600, '401', NaN])
+    assert.deepEqual(safeAIError({ status, body: CANARY }), { httpStatus: null })
+  process.stdout.write(
+    'AI production logging: exact SDK/adapter errors,12 chat policies, closed status and canaries PASS; no remote fetch\n'
+  )
+} finally {
+  globalThis.fetch = originalFetch
+  for (const method of methods) console[method] = originalConsole[method]
+  if (originalLogLevel === undefined) delete process.env.OPENAI_LOG
+  else process.env.OPENAI_LOG = originalLogLevel
+}
