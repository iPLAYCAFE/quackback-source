index 0000000..5afa2b0
--- /dev/null
+++ b/apps/web/src/lib/server/domains/conversation/__tests__/conversation-support-retention.test.ts
@@ -0,0 +1,603 @@
+/**
+ * Real-DB coverage for the support retention sweep: what each rule deletes,
+ * what it must keep (open, snoozed, reopened, held, back-office, a ticket
+ * still in progress), and that the files it orphans are then removed by the
+ * native file-retention sweep. Storage is the only double.
+ */
+import { describe, it, expect, beforeEach, afterEach, afterAll, vi } from 'vitest'
+import { createDbTestFixture, testDb } from '@/lib/server/__tests__/db-test-fixture'
+import {
+  conversationMessages,
+  conversations,
+  conversationTagAssignments,
+  conversationTags,
+  eq,
+  files,
+  principal,
+  ticketConversations,
+  tickets,
+  ticketStatuses,
+} from '@/lib/server/db'
+import type { ConversationAttachment } from '@/lib/server/db'
+import type { ConversationId, FileId, PrincipalId, TicketId } from '@quackback/ids'
+
+vi.mock('@/lib/server/db', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/db')>()),
+  db: (await import('@/lib/server/__tests__/db-test-fixture')).testDb,
+}))
+
+const deleted: string[] = []
+const failingKeys = new Set<string>()
+vi.mock('@/lib/server/storage/s3', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/storage/s3')>()),
+  deleteObject: vi.fn(async (key: string) => {
+    if (failingKeys.has(key)) throw new Error(`storage unavailable for ${key}`)
+    deleted.push(key)
+  }),
+}))
+
+import {
+  readSupportRetentionPolicy,
+  supportRetentionConfigured,
+  sweepSupportRetention,
+  SupportRetentionConfigError,
+  type SupportRetentionPolicy,
+} from '../conversation.support-retention'
+import { runSupportRetention, supportRetentionEnabled } from '../support-retention-queue'
+import { sweepFileRetention } from '@/lib/server/domains/files/files.retention'
+
+const fixture = await createDbTestFixture({
+  probe: async (db) => {
+    await db.select({ id: files.id }).from(files).limit(0)
+    await db.select({ id: tickets.id }).from(tickets).limit(0)
+  },
+})
+
+const DAY = 86_400_000
+const NOW = new Date('2027-03-01T04:10:00Z')
+const ago = (days: number) => new Date(NOW.getTime() - days * DAY)
+const POLICY: SupportRetentionPolicy = { closedDays: 90, idleDays: 365, holdTag: 'retention-hold' }
+
+let seq = 0
+async function visitor() {
+  const [p] = await testDb
+    .insert(principal)
+    .values({ role: 'user', type: 'anonymous', createdAt: ago(800) })
+    .returning()
+  return p!.id as PrincipalId
+}
+
+async function conversation(values: Partial<typeof conversations.$inferInsert> = {}) {
+  const [c] = await testDb
+    .insert(conversations)
+    .values({
+      visitorPrincipalId: await visitor(),
+      channel: 'messenger',
+      status: 'closed',
+      resolvedAt: ago(120),
+      lastMessageAt: ago(120),
+      createdAt: ago(130),
+      updatedAt: ago(120),
+      ...values,
+    })
+    .returning()
+  return c!
+}
+
+async function status(category: 'open' | 'pending' | 'closed') {
+  seq += 1
+  const [s] = await testDb
+    .insert(ticketStatuses)
+    .values({ name: `s${seq}`, slug: `support-retention-${category}-${seq}`, category })
+    .returning()
+  return s!.id
+}
+
+async function ticket(
+  category: 'open' | 'pending' | 'closed',
+  values: Partial<typeof tickets.$inferInsert> = {}
+) {
+  const [t] = await testDb
+    .insert(tickets)
+    .values({
+      title: 'report',
+      statusId: await status(category),
+      type: 'customer',
+      resolvedAt: category === 'closed' ? ago(120) : null,
+      createdAt: ago(130),
+      updatedAt: ago(120),
+      ...values,
+    })
+    .returning()
+  return t!
+}
+
+async function link(ticketId: TicketId, conversationId: ConversationId, ticketType = 'customer') {
+  await testDb
+    .insert(ticketConversations)
+    .values({ ticketId, conversationId, ticketType: ticketType as 'customer' })
+}
+
+async function message(
+  parent: { conversationId?: ConversationId; ticketId?: TicketId },
+  values: Partial<typeof conversationMessages.$inferInsert> = {}
+) {
+  const [m] = await testDb
+    .insert(conversationMessages)
+    .values({
+      ...parent,
+      principalId: null,
+      senderType: 'system',
+      content: 'screenshot attached',
+      createdAt: ago(125),
+      ...values,
+    })
+    .returning()
+  return m!
+}
+
+async function attachedFile(messageId: string) {
+  seq += 1
+  const [f] = await testDb
+    .insert(files)
+    .values({
+      storageKey: `files/2026/11/support-${seq}.png`,
+      name: `shot-${seq}.png`,
+      contentType: 'image/png',
+      family: 'image',
+      size: 10,
+      sha256: 'b'.repeat(64),
+      source: 'visitor',
+      messageId: messageId as typeof files.$inferInsert.messageId,
+      attachedAt: ago(125),
+      createdAt: ago(125),
+    })
+    .returning()
+  return f!
+}
+
+const attachmentFor = (id: FileId): ConversationAttachment => ({
+  url: '/api/storage/files/x.png',
+  name: 'x.png',
+  contentType: 'image/png',
+  size: 10,
+  fileId: id,
+  family: 'image',
+})
+
+async function hold(conversationId: ConversationId, deletedAt: Date | null = null) {
+  // The hold is matched by name; each test runs in its own rolled-back transaction.
+  const [tag] = await testDb
+    .insert(conversationTags)
+    .values({ name: POLICY.holdTag, deletedAt })
+    .returning()
+  await testDb
+    .insert(conversationTagAssignments)
+    .values({ conversationId, conversationTagId: tag!.id })
+}
+
+const exists = async (table: typeof conversations | typeof tickets | typeof files, id: string) =>
+  (
+    await testDb
+      .select({ id: table.id })
+      .from(table)
+      .where(eq(table.id, id as never))
+  ).length === 1
+const messageExists = async (id: string) =>
+  (
+    await testDb
+      .select({ id: conversationMessages.id })
+      .from(conversationMessages)
+      .where(eq(conversationMessages.id, id as never))
+  ).length === 1
+
+const sweep = (policy: SupportRetentionPolicy = POLICY) =>
+  sweepSupportRetention(policy, { now: NOW })
+
+describe('support retention policy (no database)', () => {
+  it('is inert while the window is unset', () => {
+    expect(supportRetentionConfigured({})).toBe(false)
+    expect(readSupportRetentionPolicy({})).toBeNull()
+    expect(readSupportRetentionPolicy({ SUPPORT_RETENTION_CLOSED_DAYS: '  ' })).toBeNull()
+  })
+
+  it('reads the window, the idle window and the hold tag', () => {
+    expect(
+      readSupportRetentionPolicy({
+        SUPPORT_RETENTION_CLOSED_DAYS: '90',
+        SUPPORT_RETENTION_IDLE_DAYS: '365',
+        SUPPORT_RETENTION_HOLD_TAG: 'legal-hold',
+      })
+    ).toEqual({ closedDays: 90, idleDays: 365, holdTag: 'legal-hold' })
+    expect(readSupportRetentionPolicy({ SUPPORT_RETENTION_CLOSED_DAYS: '90' })).toEqual({
+      closedDays: 90,
+      idleDays: null,
+      holdTag: 'retention-hold',
+    })
+  })
+
+  it.each([
+    [{ SUPPORT_RETENTION_CLOSED_DAYS: '90d' }],
+    [{ SUPPORT_RETENTION_CLOSED_DAYS: '29' }],
+    [{ SUPPORT_RETENTION_CLOSED_DAYS: '3651' }],
+    [{ SUPPORT_RETENTION_CLOSED_DAYS: '-90' }],
+    [{ SUPPORT_RETENTION_CLOSED_DAYS: '90', SUPPORT_RETENTION_IDLE_DAYS: '60' }],
+    [{ SUPPORT_RETENTION_CLOSED_DAYS: '90', SUPPORT_RETENTION_IDLE_DAYS: 'year' }],
+    // An idle window or a hold tag set without the closed window is incomplete, never inert.
+    [{ SUPPORT_RETENTION_IDLE_DAYS: '365' }],
+    [{ SUPPORT_RETENTION_HOLD_TAG: 'legal-hold' }],
+  ])('refuses a malformed window loudly: %j', (env) => {
+    expect(supportRetentionConfigured(env)).toBe(true)
+    expect(() => readSupportRetentionPolicy(env)).toThrow(SupportRetentionConfigError)
+  })
+
+  it('arms the cron once the window is set, even when it is malformed, and fails that job terminally', async () => {
+    const previous = process.env.SUPPORT_RETENTION_CLOSED_DAYS
+    try {
+      delete process.env.SUPPORT_RETENTION_CLOSED_DAYS
+      expect(await supportRetentionEnabled()).toBe(false)
+      process.env.SUPPORT_RETENTION_CLOSED_DAYS = 'ninety'
+      expect(await supportRetentionEnabled()).toBe(true)
+      await expect(runSupportRetention()).rejects.toMatchObject({ name: 'TerminalJobError' })
+    } finally {
+      if (previous === undefined) delete process.env.SUPPORT_RETENTION_CLOSED_DAYS
+      else process.env.SUPPORT_RETENTION_CLOSED_DAYS = previous
+    }
+  })
+})
+
+describe.skipIf(!fixture.available)('support retention sweep (real DB, rolled back)', () => {
+  beforeEach(async () => {
+    await fixture.begin()
+    deleted.length = 0
+    failingKeys.clear()
+  })
+  afterEach(fixture.rollback)
+  afterAll(fixture.close)
+
+  it('deletes a conversation closed past the window, with its paired ticket and every message', async () => {
+    const c = await conversation()
+    const t = await ticket('closed')
+    await link(t.id, c.id)
+    const inConversation = await message({ conversationId: c.id })
+    const inTicket = await message({ ticketId: t.id })
+
+    const result = await sweep()
+
+    expect(result).toMatchObject({ conversations: 1, tickets: 1, truncated: false })
+    expect(await exists(conversations, c.id)).toBe(false)
+    expect(await exists(tickets, t.id)).toBe(false)
+    expect(await messageExists(inConversation.id)).toBe(false)
+    expect(await messageExists(inTicket.id)).toBe(false)
+  })
+
+  it('keeps open, snoozed and recently closed conversations', async () => {
+    const open = await conversation({ status: 'open', resolvedAt: null })
+    const snoozed = await conversation({ status: 'snoozed', resolvedAt: null })
+    const recent = await conversation({ resolvedAt: ago(30), lastMessageAt: ago(30) })
+    // Closed long ago but answered recently (closed again after a late reply).
+    const lateReply = await conversation({ resolvedAt: ago(200), lastMessageAt: ago(10) })
+
+    const result = await sweep()
+
+    expect(result.conversations).toBe(0)
+    for (const c of [open, snoozed, recent, lateReply])
+      expect(await exists(conversations, c.id)).toBe(true)
+  })
+
+  it('a conversation reopened before the run is kept even with an old resolved_at', async () => {
+    const reopened = await conversation({
+      status: 'open',
+      resolvedAt: ago(200),
+      lastMessageAt: ago(200),
+    })
+    expect((await sweep({ ...POLICY, idleDays: null })).conversations).toBe(0)
+    expect(await exists(conversations, reopened.id)).toBe(true)
+  })
+
+  it('a held conversation is kept with its tickets and deleted messages, whatever its age; a deleted hold tag still holds', async () => {
+    const held = await conversation({
+      resolvedAt: ago(900),
+      lastMessageAt: ago(900),
+      updatedAt: ago(900),
+    })
+    const t = await ticket('closed', {
+      resolvedAt: ago(900),
+      updatedAt: ago(900),
+      deletedAt: ago(800),
+    })
+    await link(t.id, held.id)
+    const gone = await message({ conversationId: held.id }, { deletedAt: ago(800) })
+    await hold(held.id, new Date())
+
+    const result = await sweep()
+
+    expect(result).toMatchObject({ conversations: 0, tickets: 0, messages: 0 })
+    expect(await exists(conversations, held.id)).toBe(true)
+    expect(await exists(tickets, t.id)).toBe(true)
+    expect(await messageExists(gone.id)).toBe(true)
+  })
+
+  it('a paired ticket still in progress keeps the whole conversation', async () => {
+    const c = await conversation()
+    const t = await ticket('open')
+    await link(t.id, c.id)
+
+    expect((await sweep()).conversations).toBe(0)
+    expect(await exists(conversations, c.id)).toBe(true)
+    expect(await exists(tickets, t.id)).toBe(true)
+  })
+
+  it('a ticket closed only recently keeps the conversation too', async () => {
+    const c = await conversation()
+    const t = await ticket('closed', { resolvedAt: ago(10), updatedAt: ago(10) })
+    await link(t.id, c.id)
+
+    expect((await sweep()).conversations).toBe(0)
+    expect(await exists(conversations, c.id)).toBe(true)
+  })
+
+  it('a back-office ticket linked to the conversation is never deleted; only its link goes', async () => {
+    const c = await conversation()
+    const backOffice = await ticket('open', { type: 'back_office' })
+    await link(backOffice.id, c.id, 'back_office')
+    const note = await message({ ticketId: backOffice.id })
+
+    expect((await sweep()).conversations).toBe(1)
+    expect(await exists(tickets, backOffice.id)).toBe(true)
+    expect(await messageExists(note.id)).toBe(true)
+  })
+
+  it('idle rule: any status past the idle window, unless a snooze timer is still ahead', async () => {
+    const idle = await conversation({
+      status: 'open',
+      resolvedAt: null,
+      lastMessageAt: ago(400),
+      updatedAt: ago(400),
+    })
+    const waking = await conversation({
+      status: 'snoozed',
+      resolvedAt: null,
+      lastMessageAt: ago(400),
+      updatedAt: ago(400),
+      snoozedUntil: new Date(NOW.getTime() + DAY),
+    })
+    const touched = await conversation({
+      status: 'open',
+      resolvedAt: null,
+      lastMessageAt: ago(400),
+      updatedAt: ago(5),
+    })
+
+    expect((await sweep()).conversations).toBe(1)
+    expect(await exists(conversations, idle.id)).toBe(false)
+    expect(await exists(conversations, waking.id)).toBe(true)
+    expect(await exists(conversations, touched.id)).toBe(true)
+    // Without an idle window the open thread stays.
+    const again = await conversation({
+      status: 'open',
+      resolvedAt: null,
+      lastMessageAt: ago(400),
+      updatedAt: ago(400),
+    })
+    expect((await sweep({ ...POLICY, idleDays: null })).conversations).toBe(0)
+    expect(await exists(conversations, again.id)).toBe(true)
+  })
+
+  it('manually filed spam is deleted on the same window', async () => {
+    const spam = await conversation({ endReason: 'spam', spamReason: 'manual' })
+    expect((await sweep()).conversations).toBe(1)
+    expect(await exists(conversations, spam.id)).toBe(false)
+  })
+
+  it('unlinked customer tickets follow the window; soft-deleted tickets go after it even when linked to a live conversation', async () => {
+    const standalone = await ticket('closed')
+    const standaloneRecent = await ticket('closed', { resolvedAt: ago(10), updatedAt: ago(10) })
+    const standaloneOpen = await ticket('open')
+    const live = await conversation({ status: 'open', resolvedAt: null, lastMessageAt: ago(1) })
+    const softDeleted = await ticket('open', { deletedAt: ago(100) })
+    await link(softDeleted.id, live.id)
+    const softRecent = await ticket('open', { deletedAt: ago(10) })
+    const tracker = await ticket('closed', { type: 'tracker' })
+
+    const result = await sweep({ ...POLICY, idleDays: null })
+
+    expect(result.tickets).toBe(2)
+    expect(await exists(tickets, standalone.id)).toBe(false)
+    expect(await exists(tickets, softDeleted.id)).toBe(false)
+    for (const kept of [standaloneRecent, standaloneOpen, softRecent, tracker]) {
+      expect(await exists(tickets, kept.id)).toBe(true)
+    }
+    expect(await exists(conversations, live.id)).toBe(true)
+  })
+
+  it('soft-deleted messages go after the window; their files are then removed by file-retention', async () => {
+    const live = await conversation({ status: 'open', resolvedAt: null, lastMessageAt: ago(1) })
+    const old = await message({ conversationId: live.id }, { deletedAt: ago(100) })
+    const recent = await message({ conversationId: live.id }, { deletedAt: ago(10) })
+    const kept = await message({ conversationId: live.id })
+    const file = await attachedFile(old.id)
+    await testDb
+      .update(conversationMessages)
+      .set({ attachments: [attachmentFor(file.id)] })
+      .where(eq(conversationMessages.id, old.id))
+
+    expect((await sweep()).messages).toBe(1)
+    expect(await messageExists(old.id)).toBe(false)
+    expect(await messageExists(recent.id)).toBe(true)
+    expect(await messageExists(kept.id)).toBe(true)
+
+    const files_ = await sweepFileRetention({ now: NOW })
+    expect(files_.removed).toBe(1)
+    expect(deleted).toContain(file.storageKey)
+  })
+
+  it('an orphaned file another message still carries keeps its bytes', async () => {
+    const c = await conversation()
+    const m = await message({ conversationId: c.id })
+    const file = await attachedFile(m.id)
+    const backOffice = await ticket('open', { type: 'back_office' })
+    await message({ ticketId: backOffice.id }, { attachments: [attachmentFor(file.id)] })
+
+    await sweep()
+    await sweepFileRetention({ now: NOW })
+
+    expect(deleted).not.toContain(file.storageKey)
+    expect(await exists(files, file.id)).toBe(true)
+  })
+
+  it('removes file tombstones past the window, deleting the object again first; a storage failure keeps the row', async () => {
+    seq += 1
+    const insertTombstone = async (deletedAt: Date, key: string) =>
+      (
+        await testDb
+          .insert(files)
+          .values({
+            storageKey: key,
