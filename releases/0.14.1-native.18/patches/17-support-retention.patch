@@ -0,0 +1,31 @@
+/**
+ * Support retention — a daily job that applies the workspace's support
+ * retention window (see conversation.support-retention.ts, which states every
+ * rule). Inert until `SUPPORT_RETENTION_CLOSED_DAYS` is set; a set but invalid
+ * value fails the job terminally so it shows as a failure, never as a quiet
+ * no-op.
+ */
+import { TerminalJobError } from '@/lib/server/jobs/definitions'
+import {
+  readSupportRetentionPolicy,
+  SupportRetentionConfigError,
+  supportRetentionConfigured,
+  sweepSupportRetention,
+} from './conversation.support-retention'
+
+/** The cron gate: armed once the window is set at all. */
+export async function supportRetentionEnabled(): Promise<boolean> {
+  return supportRetentionConfigured()
+}
+
+export async function runSupportRetention(): Promise<void> {
+  let policy
+  try {
+    policy = readSupportRetentionPolicy()
+  } catch (err) {
+    if (err instanceof SupportRetentionConfigError) throw new TerminalJobError(err.message)
+    throw err
+  }
+  if (!policy) return
+  await sweepSupportRetention(policy)
+}
