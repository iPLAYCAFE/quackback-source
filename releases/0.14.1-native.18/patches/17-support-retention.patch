+/**
+ * `support-erase` — erase one person's support data (iPLAYCAFE overlay).
+ *
+ * ```
+ * bun /app/support-erase.mjs plan  --external-id <sub> [--email <address>] [--delete-posts] [--include-removed-threads]
+ * bun /app/support-erase.mjs apply <the same selector and flags> --token <plan token>
+ * ```
+ *
+ * `plan` reads only and prints counts plus the token; `apply` erases only when
+ * the token still matches (see support-erasure.ts). Output is counts, the
+ * token and refusal or error classes, never content, names or addresses.
+ * Single-workspace installs only.
+ *
+ * Exit codes: 0 done, 1 refused or failed, 2 the invocation was wrong.
+ */
+import {
+  applySupportErasure,
+  planSupportErasure,
+  SupportErasureRefused,
+} from '@/lib/server/domains/conversation/support-erasure'
+import {
+  normaliseSelector,
+  type SupportErasureSelector,
+} from '@/lib/server/domains/conversation/support-data'
+
+const USAGE =
+  'support-erase <plan|apply> --external-id <sub> | --email <address> ' +
+  '[--delete-posts] [--include-removed-threads] [--token <token>]'
+const FLAGS = ['delete-posts', 'include-removed-threads']
+const VALUES = ['external-id', 'email', 'token']
+
+function parse(argv: string[]) {
+  const [command, ...rest] = argv
+  if (command !== 'plan' && command !== 'apply') throw new Error('command must be plan or apply')
+  const opts: Record<string, string | true> = {}
+  for (let i = 0; i < rest.length; i += 1) {
+    const arg = rest[i]!
+    if (!arg.startsWith('--')) throw new Error(`unexpected argument ${arg}`)
+    const name = arg.slice(2)
+    if (name in opts) throw new Error(`--${name} given twice`)
+    if (FLAGS.includes(name)) {
+      opts[name] = true
+    } else if (VALUES.includes(name)) {
+      const value = rest[i + 1]
+      if (value === undefined || value.startsWith('--')) throw new Error(`--${name} needs a value`)
+      opts[name] = value
+      i += 1
+    } else {
+      throw new Error(`unknown option --${name}`)
+    }
+  }
+  const selector: SupportErasureSelector = {
+    externalId: typeof opts['external-id'] === 'string' ? opts['external-id'] : undefined,
+    email: typeof opts.email === 'string' ? opts.email : undefined,
+    deletePosts: opts['delete-posts'] === true,
+    includeRemovedThreads: opts['include-removed-threads'] === true,
+  }
+  normaliseSelector(selector) // throws on an empty or malformed selector
+  const token = typeof opts.token === 'string' ? opts.token.trim() : undefined
+  if (command === 'apply' && !token) throw new Error('apply needs --token from a plan')
+  if (command === 'plan' && token) throw new Error('plan takes no --token')
+  return { command, selector, token }
+}
+
+async function main(): Promise<number> {
+  if (process.env.QUACKBACK_TENANCY === 'pooled') {
+    console.error(JSON.stringify({ refused: 'pooled tenancy is not supported' }))
+    return 2
+  }
+  let parsed
+  try {
+    parsed = parse(process.argv.slice(2))
+  } catch (err) {
+    console.error(`${(err as Error).message}\n${USAGE}`)
+    return 2
+  }
+  try {
+    const plan =
+      parsed.command === 'plan'
+        ? await planSupportErasure(parsed.selector)
+        : await applySupportErasure(parsed.selector, parsed.token!)
+    console.log(JSON.stringify({ command: parsed.command, ...plan }, null, 2))
+    return plan.refused && parsed.command === 'plan' ? 1 : 0
+  } catch (err) {
+    if (err instanceof SupportErasureRefused) {
+      console.error(JSON.stringify({ command: parsed.command, refused: err.message }))
+      return 1
+    }
+    // The class and a Postgres error code at most: messages can quote row data.
+    const code = (err as { code?: unknown }).code
+    console.error(
+      JSON.stringify({
+        command: parsed.command,
+        failed: (err as Error).name,
+        code: typeof code === 'string' && /^[0-9A-Z]{5}$/.test(code) ? code : undefined,
+      })
+    )
+    return 1
+  }
+}
+
+main().then(
+  (code) => process.exit(code),
+  () => process.exit(1)
+)
diff --git a/apps/web/src/lib/server/domains/conversation/__tests__/conversation-support-retention.test.ts b/apps/web/src/lib/server/domains/conversation/__tests__/conversation-support-retention.test.ts
