--- /dev/null
+++ b/apps/web/src/lib/server/domains/conversation/conversation.support-retention.ts
@@ -0,0 +1,493 @@
+/**
+ * Support retention: permanently deletes support conversations, customer
+ * tickets and soft-deleted messages once a workspace-chosen window has passed,
+ * so a published retention period is something the software keeps rather than
+ * a promise someone has to remember.
+ *
+ * OFF UNLESS CONFIGURED. Nothing runs while every `SUPPORT_RETENTION_*`
+ * variable is unset. Once any is set the job is armed, and a malformed or
+ * incomplete configuration fails it loudly instead of turning the sweep off: a
+ * silent no-op here is a broken privacy promise no dashboard would show.
+ *
+ * What goes, each by its own rule:
+ *
+ *  - CLOSED CONVERSATIONS, `closedDays` after they were closed AND after every
+ *    sign of activity: the last visitor-facing message, any message at all
+ *    (internal notes and system events included), and the row's own
+ *    `updated_at` (tags, assignment, attributes). A reopen leaves the thread
+ *    `open` or `snoozed`; a note or edit on a closed thread restarts its clock.
+ *    Spam included: an agent's manual filing is still a person's data
+ *    (machine-filed spam already goes at 30 days through spam-retention).
+ *  - IDLE CONVERSATIONS (optional, `SUPPORT_RETENTION_IDLE_DAYS`), any status,
+ *    when nothing about them moved for that long. A snooze timer still ahead
+ *    keeps a thread. This is the workspace's own rule that a thread untouched
+ *    for that long is no longer needed, open or not.
+ *  - CUSTOMER TICKETS go with their conversation, in the same transaction, but
+ *    only when every customer ticket linked to it is finished: closed past the
+ *    window, untouched past the idle window, or soft-deleted. An open ticket
+ *    inside the window keeps the whole conversation. Unlinked customer tickets
+ *    follow the same rules on their own. Back-office and tracker tickets are
+ *    the team's records and are never touched.
+ *  - SOFT-DELETED TICKETS AND MESSAGES, `closedDays` after the delete. A
+ *    deleted message keeps its text and attachments until then.
+ *  - FILE TOMBSTONES (name, size, hash of a file whose bytes are already gone),
+ *    `closedDays` after the bytes went.
+ *
+ * A HOLD keeps a conversation: one tagged with the hold tag
+ * (`SUPPORT_RETENTION_HOLD_TAG`, default `retention-hold`, compared without
+ * letter case like every tag name; a soft-deleted tag still holds) is skipped,
+ * with its tickets and deleted messages. Renaming or hard-deleting the tag
+ * releases every hold, so a run with no such tag logs a warning.
+ *
+ * BYTES. Attached files follow without new storage code: `files.message_id`
+ * is ON DELETE SET NULL, so a deleted message orphans its file and the next
+ * `file-retention` run (scheduled after this one) deletes the objects unless a
+ * message that stays still names the file. Inline images (`chat-images/`,
+ * `widget-images/` refs in a message body or a legacy attachment) have no file
+ * row, so this sweep deletes those objects itself, before the rows, and only
+ * when no message that stays names them; a storage failure keeps the thread
+ * for the next run.
+ *
+ * LOCKING. Each batch locks its conversations and their customer tickets with
+ * `FOR UPDATE SKIP LOCKED` (never waiting, so it cannot deadlock with a ticket
+ * status sync), then reads the tickets' status in a fresh statement, so a
+ * reopen committed while the batch ran is seen. A row someone else holds is
+ * left for the next run.
+ */
+import { sql } from 'drizzle-orm'
+import { db, type Transaction } from '@/lib/server/db'
+import { getExecuteRows } from '@/lib/server/utils/execute-rows'
+import { logger } from '@/lib/server/logger'
+import { deleteObject } from '@/lib/server/storage/s3'
+import { FILES_PREFIX } from '@/lib/server/domains/files/files.service'
+import {
+  deleteInlineImages,
+  deleteNotificationsFor,
+  uuidArray,
+  type MessageMedia,
+} from './support-data'
+
+const log = logger.child({ component: 'support-retention' })
+
+const DAY_MS = 86_400_000
+export const SUPPORT_RETENTION_MIN_DAYS = 30
+export const SUPPORT_RETENTION_MAX_DAYS = 3650
+export const DEFAULT_SUPPORT_RETENTION_HOLD_TAG = 'retention-hold'
+const VARIABLES = [
+  'SUPPORT_RETENTION_CLOSED_DAYS',
+  'SUPPORT_RETENTION_IDLE_DAYS',
+  'SUPPORT_RETENTION_HOLD_TAG',
+] as const
+
+export interface SupportRetentionPolicy {
+  closedDays: number
+  idleDays: number | null
+  holdTag: string
+}
+
+export class SupportRetentionConfigError extends Error {
+  constructor(message: string) {
+    super(message)
+    this.name = 'SupportRetentionConfigError'
+  }
+}
+
+const isSet = (value: string | undefined) => (value ?? '').trim() !== ''
+
+/** True once an operator has set any retention variable; a malformed value still counts. */
+export function supportRetentionConfigured(env: NodeJS.ProcessEnv = process.env): boolean {
+  return VARIABLES.some((name) => isSet(env[name]))
+}
+
+function parseDays(name: string, raw: string): number {
+  const value = raw.trim()
+  if (!/^\d+$/.test(value)) {
+    throw new SupportRetentionConfigError(`${name} must be a whole number of days`)
+  }
+  const days = Number(value)
+  if (days < SUPPORT_RETENTION_MIN_DAYS || days > SUPPORT_RETENTION_MAX_DAYS) {
+    throw new SupportRetentionConfigError(
+      `${name} must be between ${SUPPORT_RETENTION_MIN_DAYS} and ${SUPPORT_RETENTION_MAX_DAYS} days`
+    )
+  }
+  return days
+}
+
+/** The configured policy, null when nothing is set; throws on anything set but invalid. */
+export function readSupportRetentionPolicy(
+  env: NodeJS.ProcessEnv = process.env
+): SupportRetentionPolicy | null {
+  if (!supportRetentionConfigured(env)) return null
+  if (!isSet(env.SUPPORT_RETENTION_CLOSED_DAYS)) {
+    throw new SupportRetentionConfigError(
+      'SUPPORT_RETENTION_CLOSED_DAYS is required when any support retention variable is set'
+    )
+  }
+  const closedDays = parseDays('SUPPORT_RETENTION_CLOSED_DAYS', env.SUPPORT_RETENTION_CLOSED_DAYS!)
+  const idleDays = isSet(env.SUPPORT_RETENTION_IDLE_DAYS)
+    ? parseDays('SUPPORT_RETENTION_IDLE_DAYS', env.SUPPORT_RETENTION_IDLE_DAYS!)
+    : null
+  if (idleDays !== null && idleDays < closedDays) {
+    throw new SupportRetentionConfigError(
+      'SUPPORT_RETENTION_IDLE_DAYS cannot be shorter than SUPPORT_RETENTION_CLOSED_DAYS'
+    )
+  }
+  const holdTag =
+    (env.SUPPORT_RETENTION_HOLD_TAG ?? '').trim() || DEFAULT_SUPPORT_RETENTION_HOLD_TAG
+  return { closedDays, idleDays, holdTag }
+}
+
+export interface SupportRetentionResult {
+  conversations: number
+  tickets: number
+  messages: number
+  fileTombstones: number
+  /** Inline image objects deleted with the rows that named them. */
+  inlineImages: number
+  /** True when the time budget ran out before every rule was drained. */
+  truncated: boolean
+}
+
+interface Cutoffs {
+  closed: string
+  /** Null when no idle window is configured. */
+  idle: string | null
+  now: string
+  holdTag: string
+}
+
+const holdFor = (conversationId: ReturnType<typeof sql>, holdTag: string) => sql`
+  EXISTS (
+    SELECT 1 FROM conversation_tag_assignments a
+    JOIN conversation_tags t ON t.id = a.conversation_tag_id
+    WHERE a.conversation_id = ${conversationId} AND lower(t.name) = lower(${holdTag})
+  )`
+
+/**
+ * A customer ticket counts as finished: soft-deleted past the window, closed
+ * past the window, or untouched past the idle window. `t` and `s` are the
+ * ticket and its status.
+ */
+const ticketFinished = (c: Cutoffs) => sql`(
+  (t.deleted_at IS NOT NULL AND t.deleted_at < ${c.closed}::timestamptz)
+  OR (s.category = 'closed' AND coalesce(t.resolved_at, t.updated_at) < ${c.closed}::timestamptz
+      AND t.updated_at < ${c.closed}::timestamptz)
+  OR (${c.idle}::timestamptz IS NOT NULL AND t.updated_at < ${c.idle}::timestamptz)
+)`
+
+/** No message of any kind in the conversation since `cutoff`. */
+const quietSince = (cutoff: string) => sql`NOT EXISTS (
+  SELECT 1 FROM conversation_messages m
+  WHERE m.conversation_id = c.id AND m.created_at >= ${cutoff}::timestamptz
+)`
+
+/** One batch of conversations, with the customer tickets that go with them. */
+async function deleteConversationBatch(
+  tx: Transaction,
+  c: Cutoffs,
+  after: string | null,
+  batchSize: number
+): Promise<{ scanned: string[]; conversations: number; tickets: number; inlineImages: number }> {
+  const candidates = getExecuteRows<{ id: string }>(
+    await tx.execute(sql`
+      SELECT c.id FROM conversations c
+      WHERE (
+          (c.status = 'closed'
+            AND coalesce(c.resolved_at, c.last_message_at) < ${c.closed}::timestamptz
+            AND c.last_message_at < ${c.closed}::timestamptz
+            AND coalesce(c.updated_at, c.created_at) < ${c.closed}::timestamptz
+            AND ${quietSince(c.closed)})
+          OR (${c.idle}::timestamptz IS NOT NULL
+            AND c.last_message_at < ${c.idle}::timestamptz
+            AND coalesce(c.updated_at, c.created_at) < ${c.idle}::timestamptz
+            AND ${quietSince(c.idle ?? c.now)}
+            AND NOT (c.status = 'snoozed' AND c.snoozed_until IS NOT NULL
+                     AND c.snoozed_until > ${c.now}::timestamptz))
+        )
+        AND NOT ${holdFor(sql`c.id`, c.holdTag)}
+        AND (${after}::uuid IS NULL OR c.id > ${after}::uuid)
+      ORDER BY c.id
+      LIMIT ${batchSize}
+      FOR UPDATE OF c SKIP LOCKED
+    `)
+  ).map((r) => r.id)
+  const none = { scanned: candidates, conversations: 0, tickets: 0, inlineImages: 0 }
+  if (candidates.length === 0) return none
+
+  // Every customer ticket linked to a candidate, and which of them this batch could lock.
+  const linked = getExecuteRows<{ conversation_id: string; ticket_id: string }>(
+    await tx.execute(sql`
+      SELECT tc.conversation_id, tc.ticket_id FROM ticket_conversations tc
+      JOIN tickets t ON t.id = tc.ticket_id
+      WHERE tc.conversation_id = ANY(${uuidArray(candidates)}) AND t.type = 'customer'
+    `)
+  )
+  const lockedTickets = new Set(
+    getExecuteRows<{ id: string }>(
+      await tx.execute(sql`
+        SELECT t.id FROM tickets t
+        WHERE t.id = ANY(${uuidArray(linked.map((l) => l.ticket_id))})
+        FOR UPDATE OF t SKIP LOCKED
+      `)
+    ).map((r) => r.id)
+  )
+  // A fresh statement: a status change committed while this batch ran is seen here.
+  const finishedTickets = new Set(
+    getExecuteRows<{ id: string }>(
+      await tx.execute(sql`
+        SELECT t.id FROM tickets t
+        JOIN ticket_statuses s ON s.id = t.status_id
+        WHERE t.id = ANY(${uuidArray([...lockedTickets])}) AND ${ticketFinished(c)}
+      `)
+    ).map((r) => r.id)
+  )
+  const blocked = new Set(
+    linked.filter((l) => !finishedTickets.has(l.ticket_id)).map((l) => l.conversation_id)
+  )
+  let doomed = candidates.filter((id) => !blocked.has(id))
+  if (doomed.length === 0) return none
+  const ticketOf = new Map(linked.map((l) => [l.ticket_id, l.conversation_id]))
+  const doomedTickets = linked
+    .filter((l) => doomed.includes(l.conversation_id))
+    .map((l) => l.ticket_id)
+
+  const media = getExecuteRows<MessageMedia>(
+    await tx.execute(sql`
+      SELECT m.id, coalesce(m.conversation_id, m.ticket_id) AS owner, m.content,
+             m.content_json::text AS content_json, m.attachments::text AS attachments
+      FROM conversation_messages m
+      WHERE m.conversation_id = ANY(${uuidArray(doomed)}) OR m.ticket_id = ANY(${uuidArray(doomedTickets)})
+    `)
+  )
+  const images = await deleteInlineImages(tx, media)
+  const failed = new Set([...images.failedOwners].map((owner) => ticketOf.get(owner) ?? owner))
+  doomed = doomed.filter((id) => !failed.has(id))
+  if (doomed.length === 0) return { ...none, inlineImages: images.deleted }
+
+  // A ticket goes only when every conversation it is linked to goes with it.
+  const ticketIds = linked.filter((l) => doomed.includes(l.conversation_id)).map((l) => l.ticket_id)
+  const tickets = getExecuteRows<{ id: string }>(
+    await tx.execute(sql`
+      DELETE FROM tickets t
+      WHERE t.id = ANY(${uuidArray(ticketIds)})
+        AND NOT EXISTS (
+          SELECT 1 FROM ticket_conversations tc
+          WHERE tc.ticket_id = t.id AND NOT (tc.conversation_id = ANY(${uuidArray(doomed)}))
+        )
+      RETURNING t.id
+    `)
+  ).length
+  const conversations = getExecuteRows<{ id: string }>(
+    await tx.execute(
+      sql`DELETE FROM conversations WHERE id = ANY(${uuidArray(doomed)}) RETURNING id`
+    )
+  ).length
+  await deleteNotificationsFor(tx, doomed, ticketIds)
+  return { scanned: candidates, conversations, tickets, inlineImages: images.deleted }
+}
+
+/** Customer tickets that no conversation links to, or that were soft-deleted. */
+async function deleteTicketBatch(
+  tx: Transaction,
+  c: Cutoffs,
+  after: string | null,
+  batchSize: number
+): Promise<{ scanned: string[]; deleted: number; inlineImages: number }> {
+  const candidates = getExecuteRows<{ id: string }>(
+    await tx.execute(sql`
+      SELECT t.id FROM tickets t
+      JOIN ticket_statuses s ON s.id = t.status_id
+      WHERE t.type = 'customer'
+        AND (
+          (t.deleted_at IS NOT NULL AND t.deleted_at < ${c.closed}::timestamptz)
+          OR (NOT EXISTS (SELECT 1 FROM ticket_conversations tc WHERE tc.ticket_id = t.id)
+              AND ${ticketFinished(c)})
+        )
+        AND NOT EXISTS (
+          SELECT 1 FROM ticket_conversations tc
+          WHERE tc.ticket_id = t.id AND ${holdFor(sql`tc.conversation_id`, c.holdTag)}
+        )
+        AND (${after}::uuid IS NULL OR t.id > ${after}::uuid)
+      ORDER BY t.id
+      LIMIT ${batchSize}
+      FOR UPDATE OF t SKIP LOCKED
+    `)
+  ).map((r) => r.id)
+  if (candidates.length === 0) return { scanned: [], deleted: 0, inlineImages: 0 }
+  const media = getExecuteRows<MessageMedia>(
+    await tx.execute(sql`
+      SELECT m.id, m.ticket_id AS owner, m.content, m.content_json::text AS content_json,
+             m.attachments::text AS attachments
+      FROM conversation_messages m WHERE m.ticket_id = ANY(${uuidArray(candidates)})
+    `)
+  )
+  const images = await deleteInlineImages(tx, media)
+  const doomed = candidates.filter((id) => !images.failedOwners.has(id))
+  const deleted = getExecuteRows<{ id: string }>(
+    await tx.execute(sql`DELETE FROM tickets WHERE id = ANY(${uuidArray(doomed)}) RETURNING id`)
+  ).length
+  await deleteNotificationsFor(tx, [], doomed)
+  return { scanned: candidates, deleted, inlineImages: images.deleted }
+}
+
+/** Messages soft-deleted longer ago than the window, outside held conversations. */
+async function deleteMessageBatch(
+  tx: Transaction,
+  c: Cutoffs,
+  after: string | null,
+  batchSize: number
+): Promise<{ scanned: string[]; deleted: number; inlineImages: number }> {
+  const media = getExecuteRows<MessageMedia>(
+    await tx.execute(sql`
+      SELECT m.id, m.id AS owner, m.content, m.content_json::text AS content_json,
+             m.attachments::text AS attachments
+      FROM conversation_messages m
+      WHERE m.deleted_at IS NOT NULL AND m.deleted_at < ${c.closed}::timestamptz
+        AND (m.conversation_id IS NULL OR NOT ${holdFor(sql`m.conversation_id`, c.holdTag)})
+        AND (m.ticket_id IS NULL OR NOT EXISTS (
+          SELECT 1 FROM ticket_conversations tc
+          WHERE tc.ticket_id = m.ticket_id AND ${holdFor(sql`tc.conversation_id`, c.holdTag)}
+        ))
+        AND (${after}::uuid IS NULL OR m.id > ${after}::uuid)
+      ORDER BY m.id
+      LIMIT ${batchSize}
+      FOR UPDATE OF m SKIP LOCKED
+    `)
+  )
+  if (media.length === 0) return { scanned: [], deleted: 0, inlineImages: 0 }
+  const images = await deleteInlineImages(tx, media)
+  const doomed = media.map((m) => m.id).filter((id) => !images.failedOwners.has(id))
+  const deleted = getExecuteRows<{ id: string }>(
+    await tx.execute(
+      sql`DELETE FROM conversation_messages WHERE id = ANY(${uuidArray(doomed)}) RETURNING id`
+    )
+  ).length
+  return { scanned: media.map((m) => m.id), deleted, inlineImages: images.deleted }
+}
+
+/**
+ * Tombstones of files whose objects were removed longer ago than the window.
+ * The object is deleted again first (a no-op when it is already gone): a
+ * file-retention run that died between its claim and its storage delete leaves
+ * a tombstone whose bytes remain, and dropping that row would lose the only
+ * record of them. A storage failure keeps the row for the next run.
+ */
+async function deleteTombstoneBatch(c: Cutoffs, after: string | null, batchSize: number) {
+  const rows = getExecuteRows<{ id: string; storage_key: string }>(
+    await db.execute(sql`
+      SELECT f.id, f.storage_key FROM files f
+      WHERE f.deleted_at IS NOT NULL AND f.deleted_at < ${c.closed}::timestamptz
+        AND f.message_id IS NULL
+        AND f.storage_key LIKE ${`${FILES_PREFIX}/%`}
+        AND (${after}::uuid IS NULL OR f.id > ${after}::uuid)
+      ORDER BY f.id
+      LIMIT ${batchSize}
+    `)
+  )
+  const removable: string[] = []
+  for (const row of rows) {
+    try {
+      await deleteObject(row.storage_key)
+      removable.push(row.id)
+    } catch (err) {
+      log.warn({ err, fileId: row.id }, 'tombstone object delete failed; the next run retries it')
+    }
+  }
+  const deleted = getExecuteRows<{ id: string }>(
+    await db.execute(sql`
+      DELETE FROM files
+      WHERE id = ANY(${uuidArray(removable)}) AND deleted_at IS NOT NULL AND message_id IS NULL
+      RETURNING id
+    `)
+  ).length
+  return { scanned: rows.map((r) => r.id), deleted }
+}
+
+type Phase = 'conversations' | 'tickets' | 'messages' | 'fileTombstones'
+const PHASES: Phase[] = ['conversations', 'tickets', 'messages', 'fileTombstones']
+
+/**
+ * Apply `policy` once: every rule in batches of `batchSize`. Each rule gets its
+ * share of what is left of `budgetMs`, so one large backlog cannot starve the
+ * others; whatever is left over runs on the next daily run.
+ */
+export async function sweepSupportRetention(
+  policy: SupportRetentionPolicy,
+  opts?: { now?: Date; batchSize?: number; budgetMs?: number }
+): Promise<SupportRetentionResult> {
+  const now = opts?.now ?? new Date()
+  const batchSize = opts?.batchSize ?? 200
+  const end = Date.now() + (opts?.budgetMs ?? 45_000)
+  const c: Cutoffs = {
+    closed: new Date(now.getTime() - policy.closedDays * DAY_MS).toISOString(),
+    idle:
+      policy.idleDays === null
+        ? null
+        : new Date(now.getTime() - policy.idleDays * DAY_MS).toISOString(),
+    now: now.toISOString(),
+    holdTag: policy.holdTag,
+  }
+  const result: SupportRetentionResult = {
+    conversations: 0,
+    tickets: 0,
+    messages: 0,
+    fileTombstones: 0,
+    inlineImages: 0,
+    truncated: false,
+  }
+
+  const tag = getExecuteRows<{ found: number }>(
+    await db.execute(
+      sql`SELECT 1 AS found FROM conversation_tags WHERE lower(name) = lower(${policy.holdTag}) LIMIT 1`
+    )
+  )
+  if (tag.length === 0) {
+    log.warn(
+      { hold_tag: policy.holdTag },
+      'support retention hold tag does not exist; no conversation is on hold'
+    )
+  }
+
+  for (const [index, phase] of PHASES.entries()) {
+    const deadline = Date.now() + Math.max(0, end - Date.now()) / (PHASES.length - index)
+    let after: string | null = null
+    for (;;) {
+      if (Date.now() >= deadline) {
+        result.truncated = true
+        break
+      }
+      let scanned: string[]
+      if (phase === 'conversations') {
+        const batch = await db.transaction((tx) => deleteConversationBatch(tx, c, after, batchSize))
+        result.conversations += batch.conversations
+        result.tickets += batch.tickets
+        result.inlineImages += batch.inlineImages
+        scanned = batch.scanned
+      } else if (phase === 'tickets') {
+        const batch = await db.transaction((tx) => deleteTicketBatch(tx, c, after, batchSize))
+        result.tickets += batch.deleted
+        result.inlineImages += batch.inlineImages
+        scanned = batch.scanned
+      } else if (phase === 'messages') {
+        const batch = await db.transaction((tx) => deleteMessageBatch(tx, c, after, batchSize))
+        result.messages += batch.deleted
+        result.inlineImages += batch.inlineImages
+        scanned = batch.scanned
+      } else {
+        const batch = await deleteTombstoneBatch(c, after, batchSize)
+        result.fileTombstones += batch.deleted
+        scanned = batch.scanned
+      }
+      if (scanned.length < batchSize) break
+      after = scanned[scanned.length - 1]!
+    }
+  }
+
+  const fields = { ...result, closed_days: policy.closedDays, idle_days: policy.idleDays }
+  if (result.truncated) {
+    log.warn(fields, 'support retention sweep ran out of time; the next run continues')
+  } else {
+    log.info(fields, 'support retention sweep complete')
+  }
+  return result
+}
diff --git a/apps/web/src/lib/server/domains/conversation/support-data.ts b/apps/web/src/lib/server/domains/conversation/support-data.ts
new file mode 100644
index 0000000..c55f670
--- /dev/null
+++ b/apps/web/src/lib/server/domains/conversation/support-data.ts
@@ -0,0 +1,211 @@
+/**
+ * Shared pieces of support retention and support erasure (iPLAYCAFE overlay):
+ * id-array literals, inline message images (`chat-images/`, `widget-images/`
+ * objects that have no `files` row) and teammates' in-app notifications about
+ * a thread, which name it only in `metadata`.
+ */
+import { sql } from 'drizzle-orm'
+import { fromUuid } from '@quackback/ids'
+import type { Transaction } from '@/lib/server/db'
+import { getExecuteRows } from '@/lib/server/utils/execute-rows'
+import { logger } from '@/lib/server/logger'
+import { deleteObject } from '@/lib/server/storage/s3'
+import { storedAssetKeyFromSrc } from '@/lib/server/storage/asset-url'
+
+const log = logger.child({ component: 'support-data' })
+
+/** A uuid[] literal; empty matches nothing. */
+export const uuidArray = (values: string[]) =>
+  values.length === 0
+    ? sql`ARRAY[]::uuid[]`
+    : sql`ARRAY[${sql.join(
+        values.map((v) => sql`${v}`),
+        sql`, `
+      )}]::uuid[]`
+
+/** Prefixes of message images stored without a `files` row. */
+const INLINE_IMAGE_PREFIXES = ['chat-images/', 'widget-images/']
+const STORAGE_REF = /[^\s"'()<>\\]*\/api\/storage\/[^\s"'()<>\\]+/g
+
+/** Inline image keys a message body, rich body or legacy attachment list names. */
+export function inlineImageKeys(texts: Array<string | null | undefined>): string[] {
+  const keys = new Set<string>()
+  for (const text of texts) {
+    for (const ref of text?.match(STORAGE_REF) ?? []) {
+      const key = storedAssetKeyFromSrc(ref)
+      if (key && INLINE_IMAGE_PREFIXES.some((prefix) => key.startsWith(prefix))) keys.add(key)
+    }
+  }
+  return [...keys]
+}
+
+const likePattern = (key: string) => `%${key.replace(/[\\%_]/g, (c) => `\\${c}`)}%`
+
+/** The keys, among `keys`, that a message outside `excludedMessageIds` still names. */
+export async function inlineKeysStillReferenced(
+  reader: Pick<Transaction, 'execute'>,
+  keys: string[],
+  excludedMessageIds: string[]
+): Promise<Set<string>> {
+  const kept = new Set<string>()
+  for (const key of keys) {
+    const rows = getExecuteRows<{ found: number }>(
+      await reader.execute(sql`
+        SELECT 1 AS found FROM conversation_messages m
+        WHERE NOT (m.id = ANY(${uuidArray(excludedMessageIds)}))
+          AND (m.content LIKE ${likePattern(key)}
+            OR m.content_json::text LIKE ${likePattern(key)}
+            OR m.attachments::text LIKE ${likePattern(key)})
+        LIMIT 1
+      `)
+    )
+    if (rows.length > 0) kept.add(key)
+  }
+  return kept
+}
+
+export interface MessageMedia {
+  id: string
+  owner: string
+  content: string | null
+  content_json: string | null
+  attachments: string | null
+}
+
+/**
+ * Delete the inline images of the given messages that nothing else names.
+ * Returns the owners (conversation or ticket ids) whose images could not all be
+ * deleted, so their rows stay for the next run, and the count deleted.
+ */
+export async function deleteInlineImages(
+  tx: Transaction,
+  messages: MessageMedia[]
+): Promise<{ failedOwners: Set<string>; deleted: number }> {
+  const byOwner = new Map<string, string[]>()
+  for (const m of messages) {
+    const keys = inlineImageKeys([m.content, m.content_json, m.attachments])
+    if (keys.length > 0) byOwner.set(m.owner, [...(byOwner.get(m.owner) ?? []), ...keys])
+  }
+  const failedOwners = new Set<string>()
+  let deleted = 0
+  if (byOwner.size === 0) return { failedOwners, deleted }
+  const all = [...new Set([...byOwner.values()].flat())]
+  const kept = await inlineKeysStillReferenced(
+    tx,
+    all,
+    messages.map((m) => m.id)
+  )
+  const done = new Set<string>()
+  for (const [owner, keys] of byOwner) {
+    for (const key of keys) {
+      if (kept.has(key) || done.has(key)) continue
+      try {
+        await deleteObject(key)
+        done.add(key)
+        deleted += 1
+      } catch (err) {
+        log.warn({ err }, 'inline image delete failed; the thread stays for the next run')
+        failedOwners.add(owner)
+      }
+    }
+  }
+  return { failedOwners, deleted }
+}
+
+/**
+ * Teammates' in-app notifications about the deleted threads ("X replied on …"
+ * with a preview). They name the thread only in `metadata`, with no foreign
+ * key, so nothing cascades to them.
+ */
+export async function deleteNotificationsFor(
+  tx: Pick<Transaction, 'execute'>,
+  conversationIds: string[],
+  ticketIds: string[]
+): Promise<void> {
+  const refs = [
+    ...conversationIds.map((id) => fromUuid('conversation', id)),
+    ...ticketIds.map((id) => fromUuid('ticket', id)),
+  ]
+  if (refs.length === 0) return
+  await tx.execute(sql`
+    DELETE FROM in_app_notifications
+    WHERE metadata->>'conversationId' = ANY(${textArray(refs)})
+       OR metadata->>'ticketId' = ANY(${textArray(refs)})
+  `)
+}
+
+/** A text[] literal; empty matches nothing. */
+export const textArray = (values: string[]) =>
+  values.length === 0
+    ? sql`ARRAY[]::text[]`
+    : sql`ARRAY[${sql.join(
+        values.map((v) => sql`${v}`),
+        sql`, `
+      )}]::text[]`
+
+export interface SupportErasureSelector {
+  /** The host's identity `sub`, stored as `user.external_id`. */
+  externalId?: string
+  /** An email address: account email, email-channel identity or principal contact email. */
+  email?: string
+  /** Delete the person's feedback posts instead of re-attributing them. */
+  deletePosts?: boolean
+  /** Also delete threads native removal re-attributed to the placeholder, by visitor email. */
+  includeRemovedThreads?: boolean
+}
+
+export interface SupportErasurePlan {
+  /** Principals by how they were found. */
+  accounts: number
+  emailChannel: number
+  contacts: number
+  /** `user` rows, including ones native removal left without a principal. */
+  users: number
+  conversations: number
+  /** Placeholder threads carrying the email, deleted only with includeRemovedThreads. */
+  removedThreads: number
+  tickets: number
+  messages: number
+  files: number
+  objects: number
+  posts: number
+  emailLog: number
+  /** Signed-in principals whose typed contact email matched; never erased. */
+  otherAccountsSkipped: number
+  /** Why the request cannot be applied, or null. */
+  refused: string | null
+  token: string
+}
+
+/** A reader: the database or a transaction. */
+export type Reader = Pick<Transaction, 'execute'>
+
+export const sorted = (values: Iterable<string>) => [...new Set(values)].sort()
+
+export async function rows<T>(reader: Reader, query: ReturnType<typeof sql>): Promise<T[]> {
+  return getExecuteRows<T>(await reader.execute(query))
+}
+
+export function normaliseSelector(selector: SupportErasureSelector) {
+  const externalId = selector.externalId?.trim() || null
+  const email = selector.email?.trim().toLowerCase() || null
+  if (!externalId && !email) throw new Error('an external id or an email is required')
+  if (email && !/^[^\s@<>"]+@[^\s@<>"]+$/.test(email)) throw new Error('the email is malformed')
+  return {
+    externalId,
+    email,
+    deletePosts: selector.deletePosts === true,
+    includeRemovedThreads: selector.includeRemovedThreads === true,
+  }
+}
+
+/** Mail-log rows to or from the addresses (also `Name <address>`), or about the threads. */
+export function emailLogScope(emails: string[], conversationIds: string[], ticketIds: string[]) {
+  const wrapped = emails.map((e) => `%<${e.replace(/[\\%_]/g, (c) => `\\${c}`)}>%`)
+  return sql`(
+    lower(address) = ANY(${textArray(emails)})
+    OR lower(address) LIKE ANY(${textArray(wrapped)})
+    OR conversation_id = ANY(${uuidArray(conversationIds)})
+    OR ticket_id = ANY(${uuidArray(ticketIds)})
+  )`
+}
diff --git a/apps/web/src/lib/server/domains/conversation/support-erasure.ts b/apps/web/src/lib/server/domains/conversation/support-erasure.ts
new file mode 100644
index 0000000..25dedce
--- /dev/null
+++ b/apps/web/src/lib/server/domains/conversation/support-erasure.ts
@@ -0,0 +1,474 @@
+/**
+ * Support erasure: removes one person's support data for good, for a data
+ * subject's erasure request (iPLAYCAFE overlay).
+ *
+ * Native "remove user" is not an erasure: it re-attributes the person's
+ * conversations to the deleted-user placeholder and keeps their `user` row and
+ * email. This deletes instead.
+ *
+ * WHO. The person is found by the host's identity `sub` (`user.external_id`)
+ * and/or an email address, matched against the account email, the email
+ * channel identity and the `contact_email` of a principal with no account (a
+ * CC'd participant, a cold-inbound sender), never against a signed-in person's
+ * typed `contact_email` (counted as `otherAccountsSkipped`) or
+ * `conversations.visitor_email`: that is unverified text anyone can type, and
+ * matching it would erase whoever typed it. When both selectors are given,
+ * an email that belongs to a different account is refused. A `user` row left
+ * behind by native removal (no principal, external id cleared) is found by
+ * its email and deleted. Threads native removal re-attributed to the
+ * placeholder are counted in the plan and deleted only with
+ * `includeRemovedThreads`, matched by their visitor email, since nothing else
+ * ties them to the person any more. A team principal is refused.
+ *
+ * WHAT. Their conversations with every child row; tickets they requested, of
+ * any type, and customer tickets linked only to their conversations; messages
+ * they wrote anywhere (other threads' last-message previews are cleared);
+ * files they uploaded, and files and inline images their threads carry that no
+ * other message names: objects first, then rows, tombstones included; their
+ * avatar objects; teammates' in-app notifications about their threads; mail
+ * log rows to or from their addresses or about their threads; their help-centre
+ * feedback, analytics page views and devices, and widget origin sessions;
+ * optionally (`deletePosts`) their feedback posts, re-pointing other people's
+ * merged duplicates so they do not vanish; otherwise posts and comments are
+ * re-attributed to the placeholder as native removal does; then their
+ * principals and `user` rows (sessions, accounts, channel identities and their
+ * own notifications cascade).
+ *
+ * KEPT, and said so in SUPPORT-RETENTION.md: audit-log rows (actors, no
+ * content; native 365-day window), the event outbox and job queue (90 days and
+ * less), back-office and tracker tickets the person did not request, and the
+ * native-1 submission/evidence ledgers (ids and digests, no content).
+ *
+ * TWO STEPS. `planSupportErasure` reads only and returns counts and a token,
+ * a hash of every id (and principal role) the apply would touch.
+ * `applySupportErasure` locks the person's rows and threads, plans again under
+ * the locks and refuses unless the token matches and nothing is refused, then
+ * deletes objects and rows in that one transaction. A storage failure aborts
+ * it with the database unchanged (objects already deleted stay deleted; a
+ * re-plan and apply finishes the rest). Single-workspace installs only.
+ */
+import { createHash } from 'node:crypto'
+import { sql } from 'drizzle-orm'
+import { fromUuid, isTypeIdFormat, toUuid } from '@quackback/ids'
+import { db } from '@/lib/server/db'
+import { getExecuteRows } from '@/lib/server/utils/execute-rows'
+import { logger } from '@/lib/server/logger'
+import { deleteObject } from '@/lib/server/storage/s3'
+import {
+  DELETED_USER_PRINCIPAL_ID,
+  reattributeAuthoredContent,
+} from '@/lib/server/domains/principals/principal-reattribute'
+import {
+  deleteNotificationsFor,
+  emailLogScope,
+  inlineImageKeys,
+  inlineKeysStillReferenced,
+  normaliseSelector,
+  rows,
+  sorted,
+  textArray,
+  uuidArray,
+  type Reader,
+  type SupportErasurePlan,
+  type SupportErasureSelector,
+} from './support-data'
+
+const log = logger.child({ component: 'support-erasure' })
+
+export type { SupportErasurePlan, SupportErasureSelector } from './support-data'
+
+interface Resolved {
+  principals: Array<{ id: string; role: string; kind: 'account' | 'emailChannel' | 'contact' }>
+  userIds: string[]
+  emails: string[]
+  conversationIds: string[]
+  removedThreadIds: string[]
+  ticketIds: string[]
+  messageIds: string[]
+  fileIds: string[]
+  objectKeys: string[]
+  postIds: string[]
+  emailLog: number
+  otherAccountsSkipped: number
+  flags: { deletePosts: boolean; includeRemovedThreads: boolean }
+  refused: string | null
+}
+
+async function resolve(reader: Reader, selector: SupportErasureSelector): Promise<Resolved> {
+  const { externalId, email, deletePosts, includeRemovedThreads } = normaliseSelector(selector)
+  const placeholder = toUuid(DELETED_USER_PRINCIPAL_ID)
+
+  const users = await rows<{ id: string; by: 'externalId' | 'email' }>(
+    reader,
+    sql`
+      SELECT id, 'externalId' AS by FROM "user"
+      WHERE ${externalId}::text IS NOT NULL AND external_id = ${externalId}::text
+      UNION ALL
+      SELECT id, 'email' AS by FROM "user"
+      WHERE ${email}::text IS NOT NULL AND lower(email) = ${email}::text
+    `
+  )
+  const byExternal = new Set(users.filter((u) => u.by === 'externalId').map((u) => u.id))
+  const userIds = sorted(users.map((u) => u.id))
+  const accountPrincipals = await rows<{ id: string; role: string; user_id: string }>(
+    reader,
+    sql`SELECT id, role, user_id FROM principal WHERE user_id = ANY(${uuidArray(userIds)})`
+  )
+  // Email-channel and contact-email principals count only when they have no account: a
+  // contact_email is also typed text (pre-chat capture, an agent's edit), so a signed-in
+  // person who typed this address is someone else, never part of this erasure.
+  const emailMatches =
+    email === null
+      ? []
+      : await rows<{
+          id: string
+          role: string
+          kind: 'emailChannel' | 'contact'
+          user_id: string | null
+        }>(
+          reader,
+          sql`
+            SELECT p.id, p.role, 'emailChannel' AS kind, p.user_id FROM principal p
+            WHERE p.id IN (SELECT ci.principal_id FROM channel_identities ci
+                           WHERE ci.channel = 'email' AND ci.external_id = ${email}::text)
+            UNION
+            SELECT p.id, p.role, 'contact' AS kind, p.user_id FROM principal p
+            WHERE lower(p.contact_email) = ${email}::text
+          `
+        )
+  const emailPrincipals = emailMatches.filter((p) => p.user_id === null)
+  const otherAccountsSkipped = new Set(
+    emailMatches.filter((p) => p.user_id !== null && !userIds.includes(p.user_id)).map((p) => p.id)
+  ).size
+  const principalMap = new Map<string, Resolved['principals'][number]>()
+  for (const p of accountPrincipals) {
+    principalMap.set(p.id, { id: p.id, role: p.role, kind: 'account' })
+  }
+  for (const p of emailPrincipals) {
+    if (!principalMap.has(p.id)) principalMap.set(p.id, { id: p.id, role: p.role, kind: p.kind })
+  }
+  const principals = [...principalMap.values()].sort((a, b) => (a.id < b.id ? -1 : 1))
+  const principalIds = principals.map((p) => p.id)
+
+  let refused: string | null = null
+  if (externalId && email && users.some((u) => u.by === 'email' && !byExternal.has(u.id))) {
+    refused = 'the email belongs to a different account than the external id'
+  }
+  if (principals.some((p) => p.role !== 'user')) {
+    refused = 'a team principal matches; erase teammates through team management'
+  }
+  if (principalIds.includes(placeholder)) refused = 'the deleted-user placeholder matches'
+
+  const removedThreadIds =
+    email === null
+      ? []
+      : sorted(
+          (
+            await rows<{ id: string }>(
+              reader,
+              sql`SELECT id FROM conversations
+                  WHERE visitor_principal_id = ${placeholder}::uuid AND lower(visitor_email) = ${email}::text`
+            )
+          ).map((r) => r.id)
+        )
+  if (principals.length === 0 && userIds.length === 0 && removedThreadIds.length === 0) {
+    refused = refused ?? 'no matching person'
+  }
+
+  const emails = sorted([
+    ...(email ? [email] : []),
+    ...(
+      await rows<{ email: string }>(
+        reader,
+        sql`
+          SELECT lower(email) AS email FROM "user"
+            WHERE id = ANY(${uuidArray(userIds)}) AND email IS NOT NULL
+          UNION SELECT lower(contact_email) FROM principal
+            WHERE id = ANY(${uuidArray(principalIds)}) AND contact_email IS NOT NULL
+          UNION SELECT external_id FROM channel_identities
+            WHERE channel = 'email' AND principal_id = ANY(${uuidArray(principalIds)})
+        `
+      )
+    ).map((r) => r.email),
+  ])
+
+  const conversationIds = sorted([
+    ...(
+      await rows<{ id: string }>(
+        reader,
+        sql`SELECT id FROM conversations WHERE visitor_principal_id = ANY(${uuidArray(principalIds)})`
+      )
+    ).map((r) => r.id),
+    ...(includeRemovedThreads ? removedThreadIds : []),
+  ])
+  const ticketIds = sorted(
+    (
+      await rows<{ id: string }>(
+        reader,
+        sql`
+          SELECT t.id FROM tickets t
+          WHERE t.requester_principal_id = ANY(${uuidArray(principalIds)})
+             OR (t.type = 'customer'
+                 AND EXISTS (SELECT 1 FROM ticket_conversations tc WHERE tc.ticket_id = t.id)
+                 AND NOT EXISTS (
+                   SELECT 1 FROM ticket_conversations tc
+                   WHERE tc.ticket_id = t.id
+                     AND NOT (tc.conversation_id = ANY(${uuidArray(conversationIds)}))
+                 ))
+        `
+      )
+    ).map((r) => r.id)
+  )
+  const messages = await rows<{
+    id: string
+    content: string | null
+    content_json: string | null
+    attachments: string | null
+  }>(
+    reader,
+    sql`
+      SELECT m.id, m.content, m.content_json::text AS content_json,
+             m.attachments::text AS attachments
+      FROM conversation_messages m
+      WHERE m.principal_id = ANY(${uuidArray(principalIds)})
+         OR m.conversation_id = ANY(${uuidArray(conversationIds)})
+         OR m.ticket_id = ANY(${uuidArray(ticketIds)})
+    `
+  )
+  const messageIds = sorted(messages.map((m) => m.id))
+
+  // Files: theirs always; one their threads carry only when no other message names it.
+  const attachmentFileIds = new Set<string>()
+  for (const m of messages) {
+    for (const match of m.attachments?.matchAll(/"fileId"\s*:\s*"([^"]+)"/g) ?? []) {
+      if (isTypeIdFormat(match[1]!)) attachmentFileIds.add(toUuid(match[1]!))
+    }
+  }
+  const files = await rows<{
+    id: string
+    storage_key: string
+    meta: { thumbKey?: unknown; renditionKey?: unknown } | null
+    uploaded_by_id: string | null
+  }>(
+    reader,
+    sql`
+      SELECT f.id, f.storage_key, f.meta, f.uploaded_by_id FROM files f
+      WHERE f.uploaded_by_id = ANY(${uuidArray(principalIds)})
+         OR f.message_id = ANY(${uuidArray(messageIds)})
+         OR f.id = ANY(${uuidArray([...attachmentFileIds])})
+    `
+  )
+  const sharedFiles = new Set(
+    (
+      await rows<{ file_id: string }>(
+        reader,
+        sql`
+          SELECT DISTINCT elem->>'fileId' AS file_id FROM conversation_messages m
+          CROSS JOIN LATERAL jsonb_array_elements(
+            CASE WHEN jsonb_typeof(m.attachments) = 'array' THEN m.attachments ELSE '[]'::jsonb END
+          ) AS elem
+          WHERE m.attachments IS NOT NULL AND NOT (m.id = ANY(${uuidArray(messageIds)}))
+            AND elem->>'fileId' = ANY(${textArray(files.map((f) => fromUuid('file', f.id)))})
+        `
+      )
+    ).map((r) => toUuid(r.file_id))
+  )
+  const ownFiles = files.filter(
+    (f) =>
+      (f.uploaded_by_id !== null && principalIds.includes(f.uploaded_by_id)) ||
+      !sharedFiles.has(f.id)
+  )
+  const inline = inlineImageKeys(
+    messages.flatMap((m) => [m.content, m.content_json, m.attachments])
+  )
+  const sharedInline = await inlineKeysStillReferenced(reader, inline, messageIds)
+  const avatars = await rows<{ key: string }>(
+    reader,
+    sql`
+      SELECT avatar_key AS key FROM principal
+        WHERE id = ANY(${uuidArray(principalIds)}) AND avatar_key IS NOT NULL
+      UNION
+      SELECT image_key AS key FROM "user"
+        WHERE id = ANY(${uuidArray(userIds)}) AND image_key IS NOT NULL
+    `
+  )
+  const objectKeys = sorted([
+    ...ownFiles.flatMap((f) =>
+      [f.storage_key, f.meta?.thumbKey, f.meta?.renditionKey].filter(
+        (k): k is string => typeof k === 'string' && k.startsWith('files/')
+      )
+    ),
+    ...inline.filter((k) => !sharedInline.has(k)),
+    ...avatars.map((a) => a.key),
+  ])
+  const postIds = deletePosts
+    ? sorted(
+        (
+          await rows<{ id: string }>(
+            reader,
+            sql`SELECT id FROM posts WHERE principal_id = ANY(${uuidArray(principalIds)})`
+          )
+        ).map((r) => r.id)
+      )
+    : []
+  const emailLog =
+    (
+      await rows<{ count: number }>(
+        reader,
+        sql`SELECT count(*)::int AS count FROM email_log
+            WHERE ${emailLogScope(emails, conversationIds, ticketIds)}`
+      )
+    )[0]?.count ?? 0
+
+  return {
+    principals,
+    userIds,
+    emails,
+    conversationIds,
+    removedThreadIds,
+    ticketIds,
+    messageIds,
+    fileIds: sorted(ownFiles.map((f) => f.id)),
+    objectKeys,
+    postIds,
+    emailLog,
+    otherAccountsSkipped,
+    flags: { deletePosts, includeRemovedThreads },
+    refused,
+  }
+}
+
+function tokenFor(r: Resolved): string {
+  const { emailLog: _count, otherAccountsSkipped: _other, refused: _refused, ...touched } = r
+  return createHash('sha256').update(JSON.stringify(touched)).digest('hex')
+}
+
+function planOf(r: Resolved): SupportErasurePlan {
+  const kinds = (kind: string) => r.principals.filter((p) => p.kind === kind).length
+  return {
+    accounts: kinds('account'),
+    emailChannel: kinds('emailChannel'),
+    contacts: kinds('contact'),
+    users: r.userIds.length,
+    conversations: r.conversationIds.length,
+    removedThreads: r.removedThreadIds.length,
+    tickets: r.ticketIds.length,
+    messages: r.messageIds.length,
+    files: r.fileIds.length,
+    objects: r.objectKeys.length,
+    posts: r.postIds.length,
+    emailLog: r.emailLog,
+    otherAccountsSkipped: r.otherAccountsSkipped,
+    refused: r.refused,
+    token: tokenFor(r),
+  }
+}
+
+/** Read-only: what an apply would erase, and the token it must be given. */
+export async function planSupportErasure(
+  selector: SupportErasureSelector
+): Promise<SupportErasurePlan> {
+  return planOf(await resolve(db, selector))
+}
+
+export class SupportErasureRefused extends Error {
+  constructor(message: string) {
+    super(message)
+    this.name = 'SupportErasureRefused'
+  }
+}
+
+/** Erase what `planSupportErasure` reported, only if nothing changed since. */
+export async function applySupportErasure(
+  selector: SupportErasureSelector,
+  token: string
+): Promise<SupportErasurePlan> {
+  const outline = await resolve(db, selector)
+  if (outline.refused) throw new SupportErasureRefused(outline.refused)
+  if (tokenFor(outline) !== token) {
+    throw new SupportErasureRefused('the data changed since the plan; plan again and review it')
+  }
+  const outlinePrincipals = outline.principals.map((p) => p.id)
+
+  const result = await db.transaction(async (tx) => {
+    // Lock the person and their threads: a new message, ticket or principal
+    // needs one of these rows, so nothing can join the set until commit.
+    await tx.execute(
+      sql`SELECT id FROM "user" WHERE id = ANY(${uuidArray(outline.userIds)}) FOR UPDATE`
+    )
+    await tx.execute(
+      sql`SELECT id FROM principal WHERE id = ANY(${uuidArray(outlinePrincipals)}) FOR UPDATE`
+    )
+    await tx.execute(
+      sql`SELECT id FROM conversations WHERE id = ANY(${uuidArray(outline.conversationIds)}) FOR UPDATE`
+    )
+    await tx.execute(
+      sql`SELECT id FROM tickets WHERE id = ANY(${uuidArray(outline.ticketIds)}) FOR UPDATE`
+    )
+    const r = await resolve(tx, selector)
+    if (r.refused) throw new SupportErasureRefused(r.refused)
+    if (tokenFor(r) !== token) {
+      throw new SupportErasureRefused(
+        'the data changed during the erasure; plan again and review it'
+      )
+    }
+    const ids = r.principals.map((p) => p.id)
+
+    // Objects first: a failure throws and rolls the rows back.
+    for (const key of r.objectKeys) await deleteObject(key)
+
+    const touchedThreads = getExecuteRows<{ id: string }>(
+      await tx.execute(sql`
+        SELECT DISTINCT conversation_id AS id FROM conversation_messages
+        WHERE principal_id = ANY(${uuidArray(ids)}) AND conversation_id IS NOT NULL
+          AND NOT (conversation_id = ANY(${uuidArray(r.conversationIds)}))
+      `)
+    ).map((row) => row.id)
+    await tx.execute(
+      sql`DELETE FROM email_log WHERE ${emailLogScope(r.emails, r.conversationIds, r.ticketIds)}`
+    )
+    await deleteNotificationsFor(tx, r.conversationIds, r.ticketIds)
+    await tx.execute(sql`DELETE FROM files WHERE id = ANY(${uuidArray(r.fileIds)})`)
+    await tx.execute(sql`DELETE FROM tickets WHERE id = ANY(${uuidArray(r.ticketIds)})`)
+    await tx.execute(sql`DELETE FROM conversations WHERE id = ANY(${uuidArray(r.conversationIds)})`)
+    await tx.execute(
+      sql`DELETE FROM conversation_messages WHERE id = ANY(${uuidArray(r.messageIds)})`
+    )
+    await tx.execute(
+      sql`UPDATE conversations SET last_message_preview = NULL WHERE id = ANY(${uuidArray(touchedThreads)})`
+    )
+    if (r.postIds.length > 0) {
+      await tx.execute(
+        sql`UPDATE posts SET canonical_post_id = NULL WHERE canonical_post_id = ANY(${uuidArray(r.postIds)})`
+      )
+      await tx.execute(sql`DELETE FROM posts WHERE id = ANY(${uuidArray(r.postIds)})`)
+    }
+    await tx.execute(
+      sql`DELETE FROM kb_article_feedback WHERE principal_id = ANY(${uuidArray(ids)})`
+    )
+    await tx.execute(sql`DELETE FROM page_views WHERE principal_id = ANY(${uuidArray(ids)})`)
+    await tx.execute(sql`DELETE FROM visitor_devices WHERE principal_id = ANY(${uuidArray(ids)})`)
+    await tx.execute(sql`
+      DELETE FROM widget_origin_session
+      WHERE user_id = ANY(${textArray([...r.userIds, ...r.userIds.map((id) => fromUuid('user', id))])})
+    `)
+    for (const principalId of ids) {
+      await reattributeAuthoredContent(tx, fromUuid('principal', principalId))
+    }
+    await tx.execute(sql`DELETE FROM "user" WHERE id = ANY(${uuidArray(r.userIds)})`)
+    await tx.execute(sql`DELETE FROM principal WHERE id = ANY(${uuidArray(ids)})`)
+    return planOf(r)
+  })
+
+  try {
+    const { cacheDel, CACHE_KEYS } = await import('@/lib/server/cache')
+    for (const userId of outline.userIds) {
+      await cacheDel(CACHE_KEYS.PRINCIPAL_BY_USER(fromUuid('user', userId)))
+    }
+  } catch (err) {
+    log.warn({ err }, 'principal cache invalidation after erasure failed')
+  }
+  const { token: _token, ...counts } = result
+  log.info(counts, 'support erasure applied')
+  return result
+}
