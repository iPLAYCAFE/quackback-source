+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { z } from 'zod'
+import { maxIterations, toolDefinition } from '@tanstack/ai'
+
+const settings = vi.hoisted(() => ({
+  openaiApiKey: 'synthetic-local-wire-test-only',
+  openaiBaseUrl: 'https://gateway.ai.cloudflare.com/v1/test-account/test-gateway/workers-ai/v1',
+  aiReasoningEffort: 'low' as string | undefined,
+  aiRequireParameters: undefined as boolean | undefined,
+}))
+vi.mock('@/lib/server/config', () => ({ config: settings }))
+vi.mock('@/lib/server/logger', () => ({
+  logger: { child: () => ({ warn: vi.fn() }) },
+}))
+vi.mock('@/lib/server/domains/ai/usage-log', () => ({
+  withUsageLogging: async (_params: unknown, run: () => Promise<{ result: unknown }>) =>
+    (await run()).result,
+}))
+
+import { reasoningEffortProviderOptions } from '../config'
+import { resetStructuredFallbackMemory, structuredChat } from '../structured-chat'
+import { runSynthesis } from '../../assistant/synthesis-core'
+
+type WireBody = Record<string, unknown>
+
+function completion(stream: unknown) {
+  if (stream === true) {
+    const common = {
+      id: 'synthetic-completion',
+      object: 'chat.completion.chunk',
+      created: 1,
+      model: 'synthetic-model',
+    }
+    const chunks = [
+      {
+        ...common,
+        choices: [
+          { index: 0, delta: { role: 'assistant', content: '{"ok":true}' }, finish_reason: null },
+        ],
+      },
+      { ...common, choices: [{ index: 0, delta: {}, finish_reason: 'stop' }] },
+      {
+        ...common,
+        choices: [],
+        usage: { prompt_tokens: 10, completion_tokens: 5, total_tokens: 15 },
+      },
+    ]
+    return new Response(
+      chunks.map((chunk) => `data: ${JSON.stringify(chunk)}\n\n`).join('') + 'data: [DONE]\n\n',
+      {
+        headers: { 'Content-Type': 'text/event-stream' },
+      }
+    )
+  }
+  return Response.json({
+    id: 'synthetic-completion',
+    object: 'chat.completion',
+    created: 1,
+    model: 'synthetic-model',
+    choices: [
+      { index: 0, finish_reason: 'stop', message: { role: 'assistant', content: '{"ok":true}' } },
+    ],
+    usage: { prompt_tokens: 10, completion_tokens: 5, total_tokens: 15 },
+  })
+}
+
+function rejectFormat(message: string) {
+  return Response.json(
+    { error: { message, param: 'response_format', type: 'invalid_request_error' } },
+    { status: 400 }
+  )
+}
+
+async function runWire(rejections: string[]) {
+  const bodies: WireBody[] = []
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      const request = new Request(input, init)
+      expect(new URL(request.url).origin).toBe('https://gateway.ai.cloudflare.com')
+      expect(request.method).toBe('POST')
+      bodies.push(JSON.parse(await request.text()))
+      expect(bodies.length).toBeLessThanOrEqual(rejections.length + 1)
+      return bodies.length <= rejections.length
+        ? rejectFormat(rejections[bodies.length - 1])
+        : completion(bodies.at(-1)?.stream)
+    })
+  )
+  const result = await structuredChat({
+    model: 'synthetic-model',
+    systemPrompts: ['Return the requested synthetic JSON.'],
+    messages: [{ role: 'user', content: 'Synthetic fixture.' }],
+    schema: z.object({ ok: z.boolean() }),
+    maxTokens: 128,
+  })
+  expect(result).toEqual({ ok: true })
+  return bodies
+}
+
+describe('Cloudflare explicit reasoning through the installed TanStack/OpenAI SDK', () => {
+  beforeEach(() => {
+    settings.openaiBaseUrl =
+      'https://gateway.ai.cloudflare.com/v1/test-account/test-gateway/workers-ai/v1'
+    settings.aiReasoningEffort = 'low'
+    resetStructuredFallbackMemory()
+  })
+  afterEach(() => {
+    vi.unstubAllGlobals()
+  })
+
+  it('serializes explicit low with the primary strict schema request', async () => {
+    const bodies = await runWire([])
+    expect(bodies).toHaveLength(1)
+    expect(bodies[0]).toMatchObject({ reasoning_effort: 'low', max_tokens: 128 })
+    expect(bodies[0].response_format).toMatchObject({ type: 'json_schema' })
+    expect(bodies[0]).not.toHaveProperty('reasoning')
+    expect(bodies[0]).not.toHaveProperty('provider')
+  })
+
+  it('retains low on the json_object fallback without adding requests', async () => {
+    const bodies = await runWire(['json_schema is not supported'])
+    expect(bodies).toHaveLength(2)
+    expect(bodies.map((body) => body.reasoning_effort)).toEqual(['low', 'low'])
+    expect(bodies[1].response_format).toMatchObject({ type: 'json_object' })
+  })
+
+  it('retains low on the prompt-only fallback without adding requests', async () => {
+    const bodies = await runWire([
+      'json_schema is not supported',
+      'response_format is not supported',
+    ])
+    expect(bodies).toHaveLength(3)
+    expect(bodies.map((body) => body.reasoning_effort)).toEqual(['low', 'low', 'low'])
+    expect(bodies[2]).not.toHaveProperty('response_format')
+  })
+
+  it('preserves the existing OpenRouter nested option and ignores unrelated endpoints', () => {
+    settings.openaiBaseUrl = 'https://openrouter.ai/api/v1'
+    expect(reasoningEffortProviderOptions()).toEqual({ reasoning: { effort: 'low' } })
+    settings.openaiBaseUrl = 'https://api.openai.com/v1'
+    expect(reasoningEffortProviderOptions()).toEqual({})
+    settings.openaiBaseUrl = 'https://gateway.ai.cloudflare.com.evil.invalid/v1'
+    expect(reasoningEffortProviderOptions()).toEqual({})
+  })
+
+  it('accepts direct Workers AI and fails before inference for misleading effort aliases', () => {
+    settings.openaiBaseUrl = 'https://api.cloudflare.com/client/v4/accounts/synthetic/ai/v1'
+    expect(reasoningEffortProviderOptions()).toEqual({ reasoning_effort: 'low' })
+    for (const effort of ['none', 'minimal', 'medium', 'xhigh', 'invalid']) {
+      settings.aiReasoningEffort = effort
+      expect(() => reasoningEffortProviderOptions()).toThrow(
+        'Cloudflare AI_REASONING_EFFORT must be low, high or max'
+      )
+    }
+    settings.aiReasoningEffort = undefined
+    expect(reasoningEffortProviderOptions()).toEqual({})
+  })
+
+  it.each([false, true])(
+    'serializes low on public assistant synthesis (tools=%s)',
+    async (tools) => {
+      const bodies: WireBody[] = []
+      vi.stubGlobal(
+        'fetch',
+        vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+          const request = new Request(input, init)
+          expect(new URL(request.url).origin).toBe('https://gateway.ai.cloudflare.com')
+          expect(request.method).toBe('POST')
+          const body = JSON.parse(await request.text())
+          bodies.push(body)
+          expect(bodies.length).toBeLessThanOrEqual(tools ? 2 : 1)
+          return completion(body.stream)
+        })
+      )
+      const result = await runSynthesis({
+        model: 'synthetic-model',
+        systemPrompts: ['Return the requested synthetic JSON.'],
+        messages: [{ role: 'user', content: 'Synthetic fixture.' }],
+        outputSchema: z.object({ ok: z.boolean() }),
+        deltaField: 'ok',
+        salvageMode: 'strict',
+        salvage: () => null,
+        onFailure: 'throw',
+        retries: 0,
+        transportRetries: 0,
+        maxOutputTokens: 128,
+        ...(tools
+          ? {
+              tools: {
+                specs: [
+                  toolDefinition({
+                    name: 'synthetic_read',
+                    description: 'Synthetic unused read.',
+                    inputSchema: z.object({}),
+                  }).server(async () => {
+                    throw new Error('UNEXPECTED_TOOL_EXECUTION')
+                  }),
+                ],
+                context: {},
+                names: new Set(['synthetic_read']),
+                agentLoopStrategy: maxIterations(1),
+              },
+            }
+          : {}),
+        usageLogParams: {
+          pipelineStep: 'synthetic-wire',
+          callType: 'chat_completion',
+          model: 'synthetic-model',
+        },
+        deriveAnswerKind: () => 'answered',
+      })
+      expect(result).toMatchObject({ outcome: 'success', final: { ok: true } })
+      expect(bodies).toHaveLength(tools ? 2 : 1)
+      for (const body of bodies) {
+        expect(body).toMatchObject({ reasoning_effort: 'low', max_tokens: 128 })
+        expect(body).not.toHaveProperty('reasoning')
+      }
+      expect(bodies[0].stream).toBe(true)
+      if (tools) {
+        expect(bodies[0].tools).toHaveLength(1)
+        expect(bodies[0]).not.toHaveProperty('response_format')
+        expect(bodies[1].response_format).toMatchObject({ type: 'json_schema' })
+      }
+    }
+  )
+})
