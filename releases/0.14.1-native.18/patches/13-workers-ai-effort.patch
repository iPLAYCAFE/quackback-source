@@ -148,14 +148,44 @@ export function reasoningExcludeProviderOptions(): { reasoning?: { exclude: true
 }
 
 const REASONING_EFFORTS = new Set(['low', 'high', 'max', 'medium', 'minimal'])
+const CLOUDFLARE_REASONING_EFFORTS = new Set(['low', 'high', 'max'])
+
+function isWorkersAiEndpoint(baseUrl: string | undefined): boolean {
+  if (!baseUrl) return false
+  try {
+    const url = new URL(baseUrl)
+    if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash)
+      return false
+    return (
+      (url.origin === 'https://gateway.ai.cloudflare.com' &&
+        /^\/v1\/[^/]+\/[^/]+\/workers-ai\/v1\/?$/.test(url.pathname)) ||
+      (url.origin === 'https://api.cloudflare.com' &&
+        /^\/client\/v4\/accounts\/[^/]+\/ai\/v1\/?$/.test(url.pathname))
+    )
+  } catch {
+    return false
+  }
+}
 
 /**
- * OpenRouter `reasoning.effort` for models that cannot disable thinking.
- * Unset leaves the provider default.
+ * Explicit provider reasoning effort. Workers AI uses the top-level
+ * `reasoning_effort`; OpenRouter retains its nested `reasoning.effort`.
+ * Unset leaves the provider default. Reject Workers AI aliases which GLM
+ * silently maps to max rather than the requested lower reasoning budget.
  */
-export function reasoningEffortProviderOptions(): { reasoning?: { effort: string } } {
+export function reasoningEffortProviderOptions(): {
+  reasoning?: { effort: string }
+  reasoning_effort?: string
+} {
   const effort = config.aiReasoningEffort?.trim().toLowerCase()
-  if (!effort || !REASONING_EFFORTS.has(effort) || !config.openaiBaseUrl?.includes('openrouter.ai'))
-    return {}
-  return { reasoning: { effort } }
+  if (!effort) return {}
+  if (isWorkersAiEndpoint(config.openaiBaseUrl)) {
+    if (!CLOUDFLARE_REASONING_EFFORTS.has(effort)) {
+      throw new Error('Cloudflare AI_REASONING_EFFORT must be low, high or max')
+    }
+    return { reasoning_effort: effort }
+  }
+  return REASONING_EFFORTS.has(effort) && config.openaiBaseUrl?.includes('openrouter.ai')
+    ? { reasoning: { effort } }
+    : {}
 }
