+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createSDK } from '../src/core/sdk'
+import { createBridge } from '../src/core/postmessage'
+const origin = 'https://feedback.example.test'
+const source = {postMessage: vi.fn()} as unknown as Window
+vi.mock('../src/core/panel', () => ({createPanel: () => ({iframe: document.createElement('iframe'),
+  show() {}, hide() {}, destroy() {}, setPlacement() {}, setExpanded() {}})}))
+beforeEach(() => {
+  document.body.innerHTML = ''; document.head.innerHTML = ''
+  vi.spyOn(HTMLIFrameElement.prototype, 'contentWindow', 'get').mockReturnValue(source)
+  vi.stubGlobal('matchMedia', vi.fn(() => ({matches: false, addEventListener() {}, removeEventListener() {}})))
+  vi.stubGlobal('fetch', vi.fn(async () => ({ok: true, json: async () => ({})})))
+  vi.mocked(source.postMessage).mockClear()
+})
+afterEach(() => {vi.restoreAllMocks(); vi.unstubAllGlobals()})
+function receive(type: string, exact = false, rest = {}) {
+  window.dispatchEvent(new MessageEvent('message', {origin, source: exact ? source : window,
+    data: {type, ...rest}}))
+}
+describe('native iframe source admission', () => {
+  it('rejects native ACK and capture envelopes from same-origin sibling frames', () => {
+    const iframe = document.createElement('iframe')
+    const bridge = createBridge({origin, getIframe: () => iframe})
+    const received = vi.fn(); bridge.onMessage(received)
+    for (const name of ['native-result', 'native-capture-request']) {
+      receive('quackback:event', false, {name, payload: {success: true}})
+      expect(received).not.toHaveBeenCalled()
+    }
+    receive('quackback:event', true, {name: 'native-result', payload: {success: true}})
+    receive('quackback:event', true, {name: 'native-capture-request', payload: {}})
+    expect(received).toHaveBeenCalledTimes(2)
+    bridge.dispose()
+  })
+  it('keeps native commands pending after forged ordinary readiness and flushes on exact iframe readiness', () => {
+    const sdk = createSDK(); sdk.dispatch('init', {instanceUrl: origin})
+    sdk.dispatch('native', {type: 'identify', payload: {ssoToken: 'test-only-SSO'}})
+    receive('quackback:ready')
+    const nativeCalls = () => vi.mocked(source.postMessage).mock.calls.filter(([data]) => data.type === 'quackback:native')
+    expect(nativeCalls()).toHaveLength(0)
+    sdk.dispatch('native', {type: 'list-tickets', payload: {}})
+    expect(nativeCalls()).toHaveLength(0)
+    receive('quackback:ready', true)
+    expect(nativeCalls()).toHaveLength(2)
+    sdk.dispatch('native', {type: 'read-ticket', payload: {ticketId: 'ticket-test'}})
+    expect(nativeCalls()).toHaveLength(3)
+    sdk.dispatch('destroy')
+  })
+})
+
+
+it('queues abort through exact iframe readiness and admits its ACK only from that iframe',()=>{
+  const sdk=createSDK();sdk.dispatch('init',{instanceUrl:origin})
+  const command={contract:'iplaycafe.feedback/native-1',operationId:crypto.randomUUID(),type:'abort-evidence',payload:{reportId:'brp_00000000-0000-4000-8000-000000000001'}}
+  const ack=vi.fn();sdk.dispatch('on','native-result',ack)
+  sdk.dispatch('native',command);receive('quackback:ready')
+  expect(vi.mocked(source.postMessage).mock.calls.some(([data])=>data.type==='quackback:native')).toBe(false)
+  receive('quackback:ready',true)
+  expect(source.postMessage).toHaveBeenCalledWith({type:'quackback:native',data:command},origin)
+  const payload={...command,success:true,audience:origin,hostOrigin:window.location.origin,result:{reportId:command.payload.reportId,aborted:true}}
+  receive('quackback:event',false,{name:'native-result',payload});expect(ack).not.toHaveBeenCalled()
+  receive('quackback:event',true,{name:'native-result',payload});expect(ack).toHaveBeenCalledWith(payload)
+  sdk.dispatch('destroy')
+})
