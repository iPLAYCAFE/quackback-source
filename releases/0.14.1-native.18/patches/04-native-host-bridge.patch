+import { useSyncExternalStore } from 'react'
+import { NATIVE_HOST_CONTRACT } from '@/lib/shared/widget/native-host'
+
+let config: {origin: string; enabled: boolean; label: string} = {origin: '', enabled: false, label: ''}
+const listeners = new Set<() => void>()
+const empty = {origin: '', enabled: false, label: ''}
+export function configureNativeCapture(origin: string, payload: Record<string, unknown>) {
+  config = {origin, enabled: payload.enabled === true,
+    label: typeof payload.label === 'string' ? payload.label.slice(0, 100) : 'Report an issue'}
+  for (const listener of listeners) listener()
+}
+
+/** Host owns capture/editor/consent; this is only the one native Home action. */
+export function WidgetNativeCaptureAction() {
+  const value = useSyncExternalStore((callback) => {listeners.add(callback); return () => {listeners.delete(callback)}},
+    () => config, () => empty)
+  if (!value.enabled || !value.origin) return null
+  return <button type="button" className="mx-4 rounded-2xl border border-border/60 bg-card px-4 py-3 text-left hover:bg-accent"
+    onClick={() => window.parent.postMessage({type: 'quackback:event', name: 'native-capture-request',
+      payload: {contract: NATIVE_HOST_CONTRACT, audience: window.location.origin, hostOrigin: value.origin}}, value.origin)}>
+    {value.label}
+  </button>
+}
