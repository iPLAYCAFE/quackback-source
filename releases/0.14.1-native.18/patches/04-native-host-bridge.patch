+import { nativeHostCommandSchema, NATIVE_HOST_CONTRACT } from '@/lib/shared/widget/native-host'
+import type { NativeHostContext } from '@/lib/shared/widget/native-host'
+
+interface Ports {
+  audience: string
+  clearIdentity(): string | null
+  applyIdentity(result: Record<string, unknown>): void
+  identify(payload: Record<string, unknown>, context: NativeHostContext, previous: string | null): Promise<Record<string, unknown>>
+  action(type: string, payload: Record<string, unknown>, context: NativeHostContext, token?: string | null): Promise<unknown>
+  respond(origin: string, event: string, payload: Record<string, unknown>): void
+  configureCapture(origin: string, payload: Record<string, unknown>): void
+}
+
+/** One controller per iframe. Identity changes fence every older async result. */
+export function createNativeHostController(ports: Ports) {
+  let generation = 0
+  let identityOrigin: string | null = null
+  let retirement: {token: string | null; context: NativeHostContext; promise: Promise<void> | null} | null = null
+  const inFlight = new Set<string>()
+  const identifying = new Set<Promise<void>>()
+  function fence() { generation += 1; identityOrigin = null; ports.configureCapture('', {enabled: false}) }
+  function beginRetirement(token: string | null, hostOrigin: string, operationId: string = crypto.randomUUID()): Promise<void> {
+    if (retirement?.promise) return retirement.promise
+    const owned = retirement ?? {token, context: {contract: NATIVE_HOST_CONTRACT, operationId, hostOrigin}, promise: null}
+    const pending = (async () => {
+      if (!owned.token) throw new Error('NATIVE_SESSION_TOKEN_REQUIRED')
+      const result = await ports.action('logout', {}, owned.context, owned.token)
+      if (!result || typeof result !== 'object' || (result as Record<string, unknown>).loggedOut !== true)
+        throw new Error('NATIVE_SESSION_REVOCATION_FAILED')
+    })()
+    owned.promise = pending
+    retirement = owned
+    // Keep exact cleanup authority after uncertainty; only an explicit retry
+    // resends it. Concurrent callers share the pending attempt.
+    void pending.then(() => {if (retirement === owned) retirement = null}, () => {
+      if (retirement === owned && owned.promise === pending) owned.promise = null
+    })
+    return pending
+  }
+  /** Ordinary SDK logout/handoff retires only our own exact bound issuer. */
+  async function retire(): Promise<void> {
+    const previousOrigin = identityOrigin
+    fence()
+    const earlier = [...identifying]
+    if (previousOrigin) await beginRetirement(ports.clearIdentity(), previousOrigin)
+    else if (retirement) await beginRetirement(retirement.token, retirement.context.hostOrigin, retirement.context.operationId)
+    await Promise.all(earlier)
+    if (retirement) await beginRetirement(retirement.token, retirement.context.hostOrigin, retirement.context.operationId)
+  }
+  async function receive(raw: unknown, origin: string) {
+    const parsed = nativeHostCommandSchema.safeParse(raw)
+    if (!parsed.success || origin === 'null') return
+    const command = parsed.data
+    const context: NativeHostContext = {contract: NATIVE_HOST_CONTRACT,
+      operationId: command.operationId, hostOrigin: origin}
+    if (inFlight.has(command.operationId)) return
+    inFlight.add(command.operationId)
+    const previousOrigin = identityOrigin
+    if (command.type === 'identify' || command.type === 'logout') fence()
+    const current = generation
+    const reply = (success: boolean, result?: unknown, error?: string) => ports.respond(origin, 'native-result', {
+      ...context, audience: ports.audience, type: command.type, success,
+      ...(result === undefined ? {} : {result}), ...(error ? {error} : {}),
+    })
+    try {
+      if (command.type === 'capture-config') {
+        if (identityOrigin !== origin) throw new Error('IDENTITY_REQUIRED')
+        ports.configureCapture(origin, command.payload)
+        reply(true, {configured: true})
+      } else if (command.type === 'identify') {
+        const earlier = [...identifying]
+        const work = (async () => {
+          const previous = ports.clearIdentity()
+          if (previousOrigin) await beginRetirement(previous, previousOrigin, command.operationId)
+          else if (retirement) await beginRetirement(retirement.token, retirement.context.hostOrigin, retirement.context.operationId)
+          await Promise.all(earlier)
+          if (generation !== current) return
+          const result = await ports.identify(command.payload, context, previousOrigin ? null : previous)
+          if (generation !== current) {
+            // The late server session must not survive a switch/logout.
+            await beginRetirement(result.sessionToken as string, origin, command.operationId)
+            return
+          }
+          const ack = result.nativeAck as Record<string, unknown> | undefined
+          const user = result.user as Record<string, unknown> | undefined
+          if (!ack || ack.contract !== context.contract || ack.operationId !== context.operationId ||
+              ack.hostOrigin !== origin || ack.audience !== ports.audience || typeof ack.jti !== 'string' ||
+              typeof result.sessionToken !== 'string' || result.sessionToken.length === 0 ||
+              !user || typeof user.id !== 'string' || user.id.length === 0) {
+            if (typeof result.sessionToken === 'string') await beginRetirement(result.sessionToken, origin, command.operationId)
+            throw new Error('ACK_INVALID')
+          }
+          ports.applyIdentity(result)
+          identityOrigin = origin
+          reply(true, {jti: ack.jti, user: result.user})
+        })()
+        identifying.add(work)
+        try { await work } finally { identifying.delete(work) }
+      } else if (command.type === 'logout') {
+        const token = ports.clearIdentity()
+        const earlier = [...identifying]
+        if (previousOrigin) await beginRetirement(token, previousOrigin, command.operationId)
+        else if (retirement) await beginRetirement(retirement.token, retirement.context.hostOrigin, retirement.context.operationId)
+        await Promise.all(earlier)
+        if (retirement) await beginRetirement(retirement.token, retirement.context.hostOrigin, retirement.context.operationId)
+        if (generation === current) reply(true, {loggedOut: true})
+      } else {
+        if (identityOrigin !== origin) throw new Error('IDENTITY_REQUIRED')
+        const result = await ports.action(command.type, command.payload, context)
+        if (generation === current) reply(true, result)
+      }
+    } catch (error) {
+      if (generation === current) reply(false, undefined,
+        error instanceof Error && /^[A-Z_]+$/.test(error.message) ? error.message : 'NATIVE_OPERATION_FAILED')
+    } finally { inFlight.delete(command.operationId) }
+  }
+  return {receive, fence, retire}
+}
