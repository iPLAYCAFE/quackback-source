+import { pgTable, text, timestamp, uuid, index, primaryKey, check } from 'drizzle-orm/pg-core'
+import { sql } from 'drizzle-orm'
+import { session } from './auth'
+
+export const ipcNativeRedemption = pgTable('ipc_native_redemption', {
+  jti: text('jti').primaryKey(),
+  expiresAt: timestamp('expires_at', {withTimezone: true}).notNull(),
+  redeemedAt: timestamp('redeemed_at', {withTimezone: true}).defaultNow().notNull(),
+}, (t) => [index('ipc_native_redemption_expiry').on(t.expiresAt)])
+
+export const ipcNativeSubmission = pgTable('ipc_native_submission', {
+  principalId: text('principal_id').notNull(),
+  submissionId: text('submission_id').notNull(),
+  bodyDigest: text('body_digest').notNull(),
+  ticketId: text('ticket_id').notNull(),
+  createdAt: timestamp('created_at', {withTimezone: true}).defaultNow().notNull(),
+}, (t) => [primaryKey({columns: [t.principalId, t.submissionId]}),
+  check('ipc_native_submission_body_digest_check', sql`${t.bodyDigest} ~ '^[a-f0-9]{64}$'`)])
+
+export const ipcNativeSessionBinding = pgTable('ipc_native_session_binding', {
+  sessionId: text('session_id').primaryKey().references(() => session.id, {onDelete: 'cascade'}),
+  principalId: text('principal_id').notNull(),
+  hostOrigin: text('host_origin').notNull(),
+  audience: text('audience').notNull(),
+  jti: text('jti').notNull().unique().references(() => ipcNativeRedemption.jti),
+})
+
+export const ipcNativeRetirement = pgTable('ipc_native_retirement', {
+  tokenSha256: text('token_sha256').primaryKey(),
+  hostOrigin: text('host_origin').notNull(),
+  audience: text('audience').notNull(),
+  operationId: uuid('operation_id').notNull(),
+  expiresAt: timestamp('expires_at', {withTimezone: true}).notNull(),
+}, t => [index('ipc_native_retirement_expiry').on(t.expiresAt),
+  check('ipc_native_retirement_token_sha256_check', sql`${t.tokenSha256} ~ '^[a-f0-9]{64}$'`)])
