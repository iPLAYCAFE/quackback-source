@@ -0,0 +1,23 @@
+import { z } from 'zod'
+
+export const NATIVE_HOST_CONTRACT = 'iplaycafe.feedback/native-1' as const
+export const nativeOriginSchema = z.string().refine((value) => {
+  try {
+    const url = new URL(value)
+    return (url.protocol === 'https:' || url.protocol === 'http:') &&
+      !url.username && !url.password && url.origin === value
+  } catch { return false }
+})
+export const nativeHostContextSchema = z.object({
+  contract: z.literal(NATIVE_HOST_CONTRACT),
+  operationId: z.uuid(),
+  hostOrigin: nativeOriginSchema,
+}).strict()
+export type NativeHostContext = z.infer<typeof nativeHostContextSchema>
+
+export const nativeHostCommandSchema = z.object({
