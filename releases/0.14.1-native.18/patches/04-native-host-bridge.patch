@@ -0,0 +1,67 @@
+// @vitest-environment node
+import { afterAll, describe, expect, it } from 'vitest'
+import { createDb } from '@quackback/db/client'
+import { createId } from '@quackback/ids'
+import { sql } from 'drizzle-orm'
+import postgres from 'postgres'
+import { lookupNativeSubmission, nativeSubmissionDigest, recordNativeSubmission } from '../native-submission'
+
+const target = new URL(process.env.DATABASE_URL ?? 'postgresql://localhost/quackback_test')
+if (!['127.0.0.1', 'localhost', '[::1]'].includes(target.hostname) || !target.pathname.endsWith('_test')) {
+  throw new Error('Native concurrency regression requires a disposable loopback test database')
+}
+const first = createDb(target.toString(), { max: 1, prepare: false })
+const second = createDb(target.toString(), { max: 1, prepare: false })
+const observer = postgres(target.toString(), { max: 1, prepare: false, onnotice: () => {} })
+afterAll(async () => {
+  await Promise.all([(first as unknown as { $client: postgres.Sql }).$client.end(),
+    (second as unknown as { $client: postgres.Sql }).$client.end(), observer.end()])
+})
+
+describe('native submission concurrency on independent PostgreSQL sessions', () => {
+  it('waits for the winning transaction then reuses its immutable ticket mapping', async () => {
+    const principalId = createId('principal')
+    const ticketId = createId('ticket')
+    const submission = { submissionId: crypto.randomUUID(), digest: nativeSubmissionDigest({ title: 'Concurrent retry' }) }
+    let release!: () => void
+    let acquired!: () => void
+    const held = new Promise<void>(resolve => { release = resolve })
+    const locked = new Promise<void>(resolve => { acquired = resolve })
+    let loserSettled = false
+    let loser: Promise<unknown> | undefined
+    const winner = first.transaction(async tx => {
+      expect(await lookupNativeSubmission(tx, principalId, submission)).toBeNull()
+      await recordNativeSubmission(tx, principalId, submission, ticketId)
+      acquired()
+      await held
+    })
+    try {
+      await locked
+      loser = second.transaction(tx => lookupNativeSubmission(tx, principalId, submission))
+        .then(result => { loserSettled = true; return result })
+      // Inspect the server's actual advisory-lock waiter, rather than relying on
+      // an arbitrary delay or a same-connection savepoint pretending to race.
+      let waiting = false
+      for (let attempt = 0; attempt < 100 && !waiting; attempt++) {
+        const rows = await observer`select 1 from pg_stat_activity where wait_event = 'advisory' and datname = current_database()`
+        waiting = rows.length > 0
+        if (!waiting) await new Promise(resolve => setTimeout(resolve, 10))
+      }
+      expect(waiting).toBe(true)
+      expect(loserSettled).toBe(false)
+      release()
+      await winner
+      expect(await loser).toBe(ticketId)
+      const rows = await first.execute(sql`select ticket_id from ipc_native_submission where principal_id = ${principalId} and submission_id = ${submission.submissionId}`)
+      expect(rows).toHaveLength(1)
+      expect(rows[0].ticket_id).toBe(ticketId)
+      await expect(second.transaction(tx => lookupNativeSubmission(tx, principalId,
+        { ...submission, digest: nativeSubmissionDigest({ title: 'Changed retry' }) })))
+        .rejects.toMatchObject({ code: 'SUBMISSION_CONFLICT' })
+    } finally {
+      release()
+      await Promise.allSettled([winner, ...(loser ? [loser] : [])])
+      await first.execute(sql`delete from ipc_native_submission where principal_id = ${principalId} and submission_id = ${submission.submissionId}`)
+    }
+  })
+})
