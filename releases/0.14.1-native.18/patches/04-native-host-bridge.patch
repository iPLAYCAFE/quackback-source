@@ -0,0 +1,64 @@
+import { useEffect, useRef, useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import { useIntl } from 'react-intl'
+import type { TicketId } from '@quackback/ids'
+import { nativeReadEvidenceFn } from '@/lib/server/functions/widget/native-evidence'
+import { getWidgetAuthHeaders } from '@/lib/client/widget-auth'
+
+/** Private bytes stay in the iframe; URLs are revoked on close/switch/unmount. */
+export function WidgetNativeEvidence({ticketId, sessionVersion}: {ticketId: TicketId; sessionVersion: number}) {
+  const intl = useIntl()
+  const thai = intl.locale.startsWith('th')
+  const requests = useRef(new Set<AbortController>())
+  const urls = useRef(new Set<string>())
+  const [preview, setPreview] = useState<{url: string; video: boolean} | null>(null)
+  const [busy, setBusy] = useState(false)
+  const [failed, setFailed] = useState(false)
+  const {data} = useQuery({
+    queryKey: ['widget', 'native-evidence', sessionVersion, ticketId],
+    queryFn: () => nativeReadEvidenceFn({data: {ticketId}, headers: getWidgetAuthHeaders()}),
+    retry: false,
+  })
+  useEffect(() => () => {
+    for (const request of requests.current) request.abort()
+    for (const url of urls.current) URL.revokeObjectURL(url)
+    urls.current.clear()
+  }, [sessionVersion, ticketId])
+  function close() {
+    if (preview) { URL.revokeObjectURL(preview.url); urls.current.delete(preview.url) }
+    setPreview(null)
+  }
+  async function open(evidenceId: string) {
+    if (busy) return
+    close(); setBusy(true); setFailed(false)
+    const controller = new AbortController(); requests.current.add(controller)
+    try {
+      const response = await fetch('/api/widget/evidence/private', {
+        method: 'POST', headers: {...getWidgetAuthHeaders(), 'Content-Type': 'application/json'},
+        body: JSON.stringify({ticketId, evidenceId}), signal: controller.signal,
+      })
+      const mime = response.headers.get('content-type')?.split(';')[0] ?? ''
+      if (!response.ok || !/^(image\/(png|jpeg|webp|gif)|video\/(mp4|webm))$/.test(mime)) throw new Error('unavailable')
+      const blob = await response.blob()
+      if (controller.signal.aborted || blob.size > 50 * 1024 * 1024) throw new Error('unavailable')
+      const url = URL.createObjectURL(blob); urls.current.add(url)
+      setPreview({url, video: mime.startsWith('video/')})
+    } catch { if (!controller.signal.aborted) setFailed(true) }
+    finally { requests.current.delete(controller); if (!controller.signal.aborted) setBusy(false) }
+  }
+  const evidence = data?.reports.flatMap(report => report.evidence) ?? []
+  if (!evidence.length) return null
+  return <section className="border-b p-3 text-sm">
+    <p>{thai ? 'หลักฐานส่วนตัว' : 'Private evidence'}</p>
+    <div className="flex flex-wrap gap-2">{evidence.map((item, index) => <button key={item.evidenceId}
+      type="button" className="rounded border px-2 py-1" disabled={busy} onClick={() => void open(item.evidenceId)}>
+      {thai ? 'ดูหลักฐาน' : 'View evidence'} {index + 1}
+    </button>)}</div>
+    {failed && <p role="alert">{thai ? 'ไม่สามารถเปิดหลักฐานได้' : 'Evidence unavailable'}</p>}
+    {preview && <div>
+      <button type="button" onClick={close}>{thai ? 'ปิด' : 'Close'}</button>
+      {preview.video ? <video src={preview.url} controls className="w-full" /> :
+        <img src={preview.url} alt={thai ? 'หลักฐานส่วนตัว' : 'Private evidence'} className="w-full" />}
+    </div>}
+  </section>
+}
