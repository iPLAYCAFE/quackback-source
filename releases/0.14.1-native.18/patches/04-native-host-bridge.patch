+import { describe, expect, it } from 'vitest'
+import { nativeSubmissionDigest } from '../native-submission'
+
+describe('native submission digest', () => {
+  it('ignores JSON object key order but binds every nested field and array order', () => {
+    const report = {title: 'Broken save', fieldValues: {b: 2, a: 1}, attachments: []}
+    expect(nativeSubmissionDigest(report)).toBe(nativeSubmissionDigest({attachments: [], fieldValues: {a: 1, b: 2}, title: 'Broken save'}))
+    expect(nativeSubmissionDigest(report)).not.toBe(nativeSubmissionDigest({...report, title: 'Other report'}))
+    expect(nativeSubmissionDigest({items: [1, 2]})).not.toBe(nativeSubmissionDigest({items: [2, 1]}))
+  })
+  it('normalizes absent optional JSON fields without accepting a changed value', () => {
+    expect(nativeSubmissionDigest({title: 't'})).toBe(nativeSubmissionDigest({title: 't', description: undefined}))
+    expect(nativeSubmissionDigest({title: 't'})).not.toBe(nativeSubmissionDigest({title: 't', description: ''}))
+  })
+})
diff --git a/apps/web/src/lib/server/widget/native-host-token.ts b/apps/web/src/lib/server/widget/native-host-token.ts
new file mode 100644
index 000000000..2d7ee5a5a
--- /dev/null
+++ b/apps/web/src/lib/server/widget/native-host-token.ts
@@ -0,0 +1,108 @@
+import { z } from 'zod'
+import { db, sql } from '@/lib/server/db'
+import { nativeHostContextSchema, nativeOriginSchema } from '@/lib/shared/widget/native-host'
+export { nativeHostContextSchema } from '@/lib/shared/widget/native-host'
+const claimSchema = z.object({
+  aud: nativeOriginSchema,
+  jti: z.uuid(),
+  iat: z.number().int(),
+  exp: z.number().int(),
+  ipc: nativeHostContextSchema,
+})
+
+/** Signature is verified by upstream; this adds the host contract constraints. */
+export function readNativeHostClaims(
+  payload: unknown,
+  context: unknown,
+  audience: string,
+  now = Math.floor(Date.now() / 1000)
+) {
+  const claim = claimSchema.safeParse(payload)
+  const host = nativeHostContextSchema.safeParse(context)
+  if (!claim.success || !host.success) return null
+  const value = claim.data
+  if (value.aud !== audience || value.exp <= now || value.iat > now + 5 ||
+      value.exp - value.iat <= 0 || value.exp - value.iat > 60 ||
+      value.ipc.operationId !== host.data.operationId ||
+      value.ipc.hostOrigin !== host.data.hostOrigin) return null
+  return value
+}
+
+/** Unique insertion is the concurrency boundary; a store failure fails closed. */
+export async function consumeNativeHostToken(claim: NonNullable<ReturnType<typeof readNativeHostClaims>>) {
+  const rows = await db.execute(sql`
+    INSERT INTO ipc_native_redemption (jti, expires_at)
+    VALUES (${claim.jti}, to_timestamp(${claim.exp}))
+    ON CONFLICT (jti) DO NOTHING RETURNING jti
+  `)
+  return rows.length === 1
+}
+
+export async function bindNativeHostSession(sessionId: string, principalId: string,
+  claim: NonNullable<ReturnType<typeof readNativeHostClaims>>) {
+  await db.execute(sql`INSERT INTO ipc_native_session_binding
+    (session_id, principal_id, host_origin, audience, jti)
+    VALUES (${sessionId}, ${principalId}, ${claim.ipc.hostOrigin}, ${claim.aud}, ${claim.jti})`)
+}
+
+/** Bearer possession authorizes logout, including a failed re-identify after reload.
+ * Only the exact native binding for this host/audience may be deleted. Anonymous
+ * sessions remain available to upstream's ownership-checked merge path.
+ */
+export async function revokePreviousNativeHostSession(bearer: string, context: unknown) {
+  const host = nativeHostContextSchema.parse(context)
+  const { rawSessionToken } = await import('@/lib/server/auth/session-token')
+  const { config } = await import('@/lib/server/config')
+  await db.execute(sql`DELETE FROM session s USING ipc_native_session_binding b
+    WHERE s.id=b.session_id AND s.token=${rawSessionToken(bearer)}
+      AND s.scope IN ('widget','portal') AND b.host_origin=${host.hostOrigin}
+      AND b.audience=${new URL(config.baseUrl).origin}`)
+}
+
+/** Only a committed receipt can confirm a logout whose HTTP response was lost.
+ * Retain a hash of the credential, never its value or a user/profile identifier.
+ * This admission is logout-only; it never restores authentication or data access.
+ */
+export async function retireNativeHostSession(bearer: string, context: unknown) {
+  const host = nativeHostContextSchema.parse(context)
+  const { rawSessionToken } = await import('@/lib/server/auth/session-token')
+  const { config } = await import('@/lib/server/config')
+  const { createHash } = await import('node:crypto')
+  const token = rawSessionToken(bearer)
+  if (!token) throw new Error('NATIVE_SESSION_REVOCATION_FAILED')
+  const digest = createHash('sha256').update(token).digest('hex')
+  const audience = new URL(config.baseUrl).origin
+  return db.transaction(async tx => {
+    await tx.execute(sql`SELECT pg_advisory_xact_lock(hashtextextended(${'native-retire:' + digest}, 0))`)
+    await tx.execute(sql`DELETE FROM ipc_native_retirement WHERE expires_at<=now()`)
+    const receipt = await tx.execute(sql`SELECT token_sha256 FROM ipc_native_retirement
+      WHERE token_sha256=${digest} AND host_origin=${host.hostOrigin}
+        AND audience=${audience} AND operation_id=${host.operationId} AND expires_at>now()`)
+    if (receipt.length === 1) return {loggedOut: true}
+    const deleted = await tx.execute(sql`DELETE FROM session s USING ipc_native_session_binding b, widget_identified_session w
+      WHERE s.id=b.session_id AND w.session_id=s.id AND w.hmac_verified=true
+        AND s.token=${token} AND s.scope IN ('widget','portal')
+        AND b.host_origin=${host.hostOrigin} AND b.audience=${audience}
+      RETURNING s.id`)
+    if (deleted.length !== 1) throw new Error('NATIVE_SESSION_REVOCATION_FAILED')
+    await tx.execute(sql`INSERT INTO ipc_native_retirement
+      (token_sha256,host_origin,audience,operation_id,expires_at)
+      VALUES (${digest},${host.hostOrigin},${audience},${host.operationId},now()+interval '30 days')`)
+    return {loggedOut: true}
+  })
+}
+
+/** Every operation uses the issuer-bound host, never a caller-selected origin. */
+export async function requireBoundNativeHostSession(principalId: string, context: unknown, bearer: string) {
+  const host = nativeHostContextSchema.parse(context)
+  const { rawSessionToken } = await import('@/lib/server/auth/session-token')
+  const { config } = await import('@/lib/server/config')
+  const rows = await db.execute(sql`SELECT b.session_id FROM ipc_native_session_binding b
+    JOIN session s ON s.id=b.session_id
+    JOIN widget_identified_session w ON w.session_id=s.id AND w.hmac_verified=true
+    WHERE s.token=${rawSessionToken(bearer)} AND s.expires_at>now()
+      AND s.scope IN ('widget','portal') AND b.principal_id=${principalId}
+      AND b.host_origin=${host.hostOrigin} AND b.audience=${new URL(config.baseUrl).origin}`)
+  if (rows.length !== 1) throw new Error('NATIVE_SESSION_BINDING_REQUIRED')
+  return rows[0].session_id as string
+}
