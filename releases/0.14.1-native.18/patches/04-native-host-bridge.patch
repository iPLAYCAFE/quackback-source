@@ -0,0 +1,56 @@
+import { useCallback, useEffect, useRef } from 'react'
+import { createNativeHostController } from '@/lib/client/native-host-controller'
+import { nativeHostActionFn, nativeHostActionSchema } from '@/lib/server/functions/widget/native-host'
+import { getWidgetAuthHeaders } from '@/lib/client/widget-auth'
+import type { NativeHostContext } from '@/lib/shared/widget/native-host'
+import { configureNativeCapture } from './widget-native-capture'
+
+export interface NativeIdentifyResult {
+  sessionToken: string
+  user: {id: string; name: string; email: string; avatarUrl: string | null}
+  votedPostIds?: string[]
+  canPortalHandoff?: boolean
+}
+
+export function useNativeHostBridge(
+  applyIdentity: (result: NativeIdentifyResult) => void,
+  clearIdentity: () => string | null
+) {
+  const portsRef = useRef({applyIdentity, clearIdentity})
+  portsRef.current = {applyIdentity, clearIdentity}
+  const controllerRef = useRef<ReturnType<typeof createNativeHostController> | null>(null)
+  useEffect(() => {
+    const action = async (type: string, payload: Record<string, unknown>, context: NativeHostContext, token?: string | null) => {
+      if (type === 'logout' && !token) return {loggedOut: true}
+      const headers = token ? {Authorization: `Bearer ${token}`} : getWidgetAuthHeaders()
+      return nativeHostActionFn({data: {context, action: nativeHostActionSchema.parse({type, payload})}, headers})
+    }
+    const controller = createNativeHostController({
+      audience: window.location.origin,
+      clearIdentity: () => portsRef.current.clearIdentity(),
+      applyIdentity: (value) => portsRef.current.applyIdentity(value as unknown as NativeIdentifyResult),
+      identify: async (payload, context, previousToken) => {
+        const response = await fetch('/api/widget/identify', {
+          method: 'POST', headers: {'Content-Type': 'application/json',
+            ...(previousToken ? {Authorization: `Bearer ${previousToken}`} : {})},
+          body: JSON.stringify({ssoToken: payload.ssoToken, ipc: context,
+            ...(previousToken ? {previousToken} : {})}),
+        })
+        const value = await response.json()
+        if (!response.ok) throw new Error(value.error?.code ?? 'IDENTIFY_FAILED')
+        return value
+      },
+      action,
+      respond: (origin, name, payload) => window.parent.postMessage({type: 'quackback:event', name, payload}, origin),
+      configureCapture: configureNativeCapture,
+    })
+    controllerRef.current = controller
+    function receive(event: MessageEvent) {
+      if (event.source !== window.parent || event.data?.type !== 'quackback:native') return
+      void controller.receive(event.data.data, event.origin)
+    }
+    window.addEventListener('message', receive)
+    return () => { controller.fence(); controllerRef.current = null; window.removeEventListener('message', receive) }
+  }, [])
+  return useCallback(() => controllerRef.current?.retire() ?? Promise.resolve(), [])
+}
