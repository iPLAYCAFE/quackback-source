+// @vitest-environment happy-dom
+import { act, cleanup, render } from '@testing-library/react'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { installInMemoryLocalStorage } from '@/test/local-storage'
+import { clearWidgetToken, getWidgetToken, persistAnonymousToken, readPersistedToken } from '@/lib/client/widget-auth'
+import { WidgetAuthProvider, useWidgetAuth } from '../widget-auth-provider'
+import { authClient } from '@/lib/client/auth-client'
+import { sendToHost } from '@/lib/client/widget-bridge'
+
+installInMemoryLocalStorage()
+type NativeIdentity = {sessionToken: string; user: {id: string; name: string; email: string; avatarUrl: null}}
+const native = vi.hoisted(() => ({ apply: (_value: NativeIdentity) => {}, clear: () => null as string | null, retire: vi.fn(async () => {}) }))
+vi.mock('../use-native-host-bridge', () => ({ useNativeHostBridge: (apply: typeof native.apply, clear: typeof native.clear) => {
+  native.apply = apply; native.clear = clear; return () => native.retire()
+} }))
+vi.mock('@/lib/client/widget-bridge', () => ({sendToHost: vi.fn()}))
+vi.mock('@/lib/client/auth-client', () => ({authClient: {signIn: {anonymous: vi.fn()}}}))
+vi.mock('@/lib/shared/i18n', async orig => ({...(await orig<typeof import('@/lib/shared/i18n')>()), loadMessages: vi.fn(async () => ({}))}))
+
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>(r => {resolve = r})
+  return {promise, resolve}
+}
+let current: ReturnType<typeof useWidgetAuth>
+function Probe() { current = useWidgetAuth(); return <span>{current.user?.id ?? 'anonymous'}</span> }
+function mount() { return render(<QueryClientProvider client={new QueryClient()}>
+  <WidgetAuthProvider><Probe /></WidgetAuthProvider></QueryClientProvider>) }
+const identity = (id: string) => ({sessionToken: `session-${id}`, user: {id, name: id, email: `${id}@example.test`, avatarUrl: null}})
+async function ordinary(data: unknown) { await act(async () => {window.dispatchEvent(new MessageEvent('message', {
+  source: window.parent, data: {type: 'quackback:identify', data},
+})); await Promise.resolve()}) }
+function switchNative(id: string) { act(() => {native.clear(); native.apply(identity(id))}) }
+beforeEach(() => {clearWidgetToken(); window.localStorage.clear(); vi.clearAllMocks(); native.retire.mockReset().mockResolvedValue(undefined); vi.stubGlobal('fetch', vi.fn())})
+afterEach(() => {cleanup(); vi.unstubAllGlobals()})
+
+describe('shared identity fence across native and ordinary widget auth', () => {
+  it('preserves anonymous reload continuity when SDK default identity supersedes mount restore', async () => {
+    const old = deferred<Response>(), next = deferred<Response>()
+    persistAnonymousToken('previous-anonymous')
+    vi.stubGlobal('fetch', vi.fn().mockReturnValueOnce(old.promise).mockReturnValueOnce(next.promise))
+    mount(); await ordinary({anonymous: true})
+    await act(async () => {old.resolve(Response.json({})); await old.promise})
+    expect(getWidgetToken()).toBeNull()
+    await act(async () => {next.resolve(Response.json({})); await next.promise})
+    expect(getWidgetToken()).toBe('previous-anonymous')
+    expect(readPersistedToken()).toBe('previous-anonymous')
+    expect(authClient.signIn.anonymous).not.toHaveBeenCalled()
+  })
+  it('never adopts a persisted anonymous restore that finishes after native ACK', async () => {
+    const pending = deferred<Response>()
+    persistAnonymousToken('previous-anonymous')
+    vi.stubGlobal('fetch', vi.fn(() => pending.promise))
+    mount(); switchNative('new-native')
+    await act(async () => {pending.resolve(Response.json({})); await pending.promise})
+    expect(getWidgetToken()).toBe('session-new-native')
+    expect(current.user?.id).toBe('new-native')
+    expect(readPersistedToken()).toBeNull()
+  })
+  it('drops a late ordinary SSO response after native user switch', async () => {
+    const pending = deferred<Response>()
+    vi.stubGlobal('fetch', vi.fn(() => pending.promise))
+    mount(); await ordinary({ssoToken: 'ordinary-SSO'}); switchNative('new-native')
+    await act(async () => {pending.resolve(Response.json(identity('old-ordinary'))); await pending.promise})
+    expect(getWidgetToken()).toBe('session-new-native')
+    expect(current.user?.id).toBe('new-native')
+  })
+  it('drops late anonymous mint callbacks and write continuations after native logout', async () => {
+    const pending = deferred<{data: object; error: null}>()
+    let callback!: (ctx: {response: Response}) => void
+    vi.mocked(authClient.signIn.anonymous).mockImplementationOnce(async options => {
+      callback = options!.fetchOptions!.onSuccess as typeof callback
+      return pending.promise as never
+    })
+    mount()
+    const write = vi.fn()
+    let waiting!: Promise<void>
+    act(() => {waiting = current.ensureSessionThen(write)})
+    act(() => {native.clear()})
+    await act(async () => {
+      callback({response: new Response(null, {headers: {'set-auth-token': 'late-anonymous'}})})
+      pending.resolve({data: {}, error: null}); await waiting
+    })
+    expect(getWidgetToken()).toBeNull()
+    expect(readPersistedToken()).toBeNull()
+    expect(write).not.toHaveBeenCalled()
+  })
+  it('keeps ordinary logout terminal when an older ordinary SSO response arrives', async () => {
+    const pending = deferred<Response>()
+    vi.stubGlobal('fetch', vi.fn(() => pending.promise))
+    mount(); await ordinary({ssoToken: 'ordinary-SSO'}); await ordinary(null)
+    await act(async () => {pending.resolve(Response.json(identity('old-ordinary'))); await pending.promise})
+    expect(getWidgetToken()).toBeNull()
+    expect(current.user).toBeNull()
+  })
+  it('cannot erase a newer mint promise when the previous attempt finally settles', async () => {
+    const old = deferred<{data: object; error: null}>(), next = deferred<{data: object; error: null}>()
+    vi.mocked(authClient.signIn.anonymous).mockImplementationOnce(() => old.promise as never).mockImplementationOnce(() => next.promise as never)
+    mount()
+    let first!: Promise<boolean>, second!: Promise<boolean>, third!: Promise<boolean>
+    act(() => {first = current.ensureSession()})
+    act(() => {native.clear(); second = current.ensureSession()})
+    await act(async () => {old.resolve({data: {}, error: null}); await first})
+    act(() => {third = current.ensureSession()})
+    expect(authClient.signIn.anonymous).toHaveBeenCalledTimes(2)
+    await act(async () => {next.resolve({data: {}, error: null}); await Promise.all([second, third])})
+  })
+  it('does not adopt or persist a restore response after provider unmount', async () => {
+    const pending = deferred<Response>()
+    persistAnonymousToken('previous-anonymous')
+    vi.stubGlobal('fetch', vi.fn(() => pending.promise))
+    const rendered = mount(); rendered.unmount(); clearWidgetToken()
+    await act(async () => {pending.resolve(Response.json({})); await pending.promise})
+    expect(getWidgetToken()).toBeNull()
+  })
+})
+
+
+describe('ordinary handoff waits for native retirement', () => {
+  function delayRetirement() {
+    const pending = deferred<void>()
+    native.retire.mockImplementationOnce(() => {native.clear(); return pending.promise})
+    return pending
+  }
+  it('does not exchange ordinary SSO until the owned native session is retired', async () => {
+    mount(); switchNative('old-native')
+    const retiring = delayRetirement()
+    vi.stubGlobal('fetch', vi.fn(async () => Response.json(identity('ordinary'))))
+    await ordinary({ssoToken: 'ordinary-SSO'})
+    expect(fetch).not.toHaveBeenCalled()
+    expect(getWidgetToken()).toBeNull()
+    await act(async () => {retiring.resolve(); await retiring.promise})
+    expect(fetch).toHaveBeenCalledTimes(1)
+    expect(current.user?.id).toBe('ordinary')
+  })
+  it('a pending ordinary logout cannot clear a later native identity', async () => {
+    mount(); switchNative('old-native')
+    const retiring = delayRetirement()
+    await ordinary(null)
+    switchNative('new-native')
+    await act(async () => {retiring.resolve(); await retiring.promise})
+    expect(getWidgetToken()).toBe('session-new-native')
+    expect(current.user?.id).toBe('new-native')
+  })
+  it('only the newest ordinary identity exchanges when handoffs overlap', async () => {
+    mount(); switchNative('old-native')
+    const retiring = deferred<void>()
+    native.retire.mockImplementation(() => {native.clear(); return retiring.promise})
+    vi.stubGlobal('fetch', vi.fn(async () => Response.json(identity('newest'))))
+    await ordinary({ssoToken: 'older'})
+    await ordinary({ssoToken: 'newest'})
+    expect(fetch).not.toHaveBeenCalled()
+    await act(async () => {retiring.resolve(); await retiring.promise})
+    expect(fetch).toHaveBeenCalledTimes(1)
+    expect(JSON.parse(vi.mocked(fetch).mock.calls[0][1]!.body as string).ssoToken).toBe('newest')
+  })
+  it('failed retirement blocks ordinary exchange and lazy anonymous mint', async () => {
+    mount(); switchNative('old-native')
+    native.retire.mockImplementation(() => {native.clear(); return Promise.reject(new Error('REVOCATION_FAILED'))})
+    await ordinary({ssoToken: 'ordinary-SSO'})
+    expect(fetch).not.toHaveBeenCalled()
+    expect(sendToHost).toHaveBeenCalledWith(expect.objectContaining({success: false, error: 'NATIVE_SESSION_REVOCATION_FAILED'}))
+    await act(async () => {expect(await current.ensureSession()).toBe(false)})
+    expect(authClient.signIn.anonymous).not.toHaveBeenCalled()
+    expect(getWidgetToken()).toBeNull()
+    await ordinary(null)
+    expect(vi.mocked(sendToHost).mock.calls.filter(([message]) => message.type === 'quackback:identify-result').at(-1)?.[0]).toMatchObject({success: false})
+  })
+})
