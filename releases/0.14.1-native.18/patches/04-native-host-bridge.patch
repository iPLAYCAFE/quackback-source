diff --git a/apps/web/src/lib/server/functions/widget/native-host.ts b/apps/web/src/lib/server/functions/widget/native-host.ts
new file mode 100644
index 000000000..c0124ee51
--- /dev/null
+++ b/apps/web/src/lib/server/functions/widget/native-host.ts
@@ -0,0 +1,84 @@
+import { createServerFn } from '@tanstack/react-start'
+import { z } from 'zod'
+import { createMyTicketSchema } from '@/lib/shared/schemas/tickets'
+import { nativeHostContextSchema } from '@/lib/shared/widget/native-host'
+
+const reportId = z.string().regex(/^brp_[0-9a-f-]{36}$/)
+const evidenceId = z.string().regex(/^qbe_[0-9a-f-]{36}$/)
+export const nativeHostActionSchema = z.discriminatedUnion('type', [
+  z.object({type: z.literal('create-ticket'), payload: z.object({submissionId: z.uuid(), ticket: createMyTicketSchema})}),
+  z.object({type: z.literal('list-tickets'), payload: z.object({}).strict()}),
+  z.object({type: z.literal('read-ticket'), payload: z.object({ticketId: z.string().min(1)})}),
+  z.object({type: z.literal('reply-ticket'), payload: z.object({ticketId: z.string().min(1), content: z.string().min(1).max(4000)})}),
+  z.object({type: z.literal('logout'), payload: z.object({}).strict()}),
+  z.object({type: z.literal('evidence-capability'), payload: z.object({reportId}).strict()}),
+  z.object({type: z.literal('bind-evidence'), payload: z.object({reportId, submissionId: z.uuid(),
+    ticketId: z.string().min(1), evidenceIds: z.array(evidenceId).min(1).max(5)}).strict()}),
+  z.object({type: z.literal('abort-evidence'), payload: z.object({reportId}).strict()}),
+  z.object({type: z.literal('read-evidence'), payload: z.object({ticketId: z.string().min(1)}).strict()}),
+])
+
+export const nativeHostActionFn = createServerFn({method: 'POST'})
+  .validator(z.object({context: nativeHostContextSchema, action: nativeHostActionSchema}))
+  .handler(async ({data}) => {
+    const {getRequestHeaders} = await import('@tanstack/react-start/server')
+    const bearer = getRequestHeaders().get('authorization')?.match(/^Bearer (.+)$/)?.[1]
+    if (!bearer) throw new Error('Widget token required')
+    if (data.action.type === 'logout') {
+      const {retireNativeHostSession} = await import('@/lib/server/widget/native-host-token')
+      return retireNativeHostSession(bearer, data.context)
+    }
+    const { requireWidgetAuth } = await import('../widget-auth')
+    const ctx = await requireWidgetAuth()
+    if (ctx.principal.type !== 'user') throw new Error('Verified widget identity required')
+    const {requireBoundNativeHostSession} = await import('@/lib/server/widget/native-host-token')
+    await requireBoundNativeHostSession(ctx.principal.id, data.context, bearer)
+    if (data.action.type === 'evidence-capability') {
+      const {runIssueNativeEvidenceCapability} = await import('@/lib/server/evidence/native')
+      return runIssueNativeEvidenceCapability(ctx, data.action.payload)
+    }
+    if (data.action.type === 'bind-evidence') {
+      const {runBindNativeEvidence} = await import('@/lib/server/evidence/native')
+      return runBindNativeEvidence(ctx, data.action.payload)
+    }
+    if (data.action.type === 'abort-evidence') {
+      const {runAbortNativeEvidenceBinding} = await import('@/lib/server/evidence/native')
+      return runAbortNativeEvidenceBinding(ctx, data.action.payload)
+    }
+    if (data.action.type === 'read-evidence') {
+      const {runReadNativeEvidence} = await import('@/lib/server/evidence/native')
+      return runReadNativeEvidence(ctx, data.action.payload)
+    }
+    const native = await import('../tickets')
+    if (data.action.type === 'create-ticket') {
+      const {nativeSubmissionDigest} = await import('@/lib/server/widget/native-submission')
+      return native.runCreateMyTicket(ctx, data.action.payload.ticket, {
+        submissionId: data.action.payload.submissionId,
+        digest: nativeSubmissionDigest(data.action.payload.ticket),
+      })
+    }
+    if (data.action.type === 'list-tickets') return native.runGetMyTickets(ctx)
+    const {db, tickets, ticketConversations, eq, and, isNull} = await import('@/lib/server/db')
+    // Own-ticket lookup precedes every thread read/reply. It does not depend
+    // on the native recent-50 listing and never exposes team-only ticket data.
+    const {isValidTypeId} = await import('@quackback/ids')
+    const ticketId = data.action.payload.ticketId
+    if (!isValidTypeId(ticketId, 'ticket')) throw new Error('Ticket not found')
+    const [pair] = await db.select({conversationId: ticketConversations.conversationId})
+      .from(tickets).innerJoin(ticketConversations, eq(tickets.id, ticketConversations.ticketId))
+      .where(and(eq(tickets.id, ticketId as import('@quackback/ids').TicketId),
+        eq(tickets.requesterPrincipalId, ctx.principal.id), eq(tickets.type, 'customer'),
+        eq(ticketConversations.ticketType, 'customer'), isNull(tickets.deletedAt))).limit(1)
+    if (!pair) throw new Error('Ticket not found')
+    const conversation = await import('../conversation')
+    if (data.action.type === 'reply-ticket') {
+      return conversation.runSendConversationMessage(ctx, {
+        conversationId: pair.conversationId, content: data.action.payload.content,
+      })
+    }
+    const {getRequesterTicketForConversation} = await import('@/lib/server/domains/tickets/requester.service')
+    return {
+      ticket: await getRequesterTicketForConversation(pair.conversationId, ctx.principal.id),
+      replies: await conversation.runListConversationMessages(ctx, {conversationId: pair.conversationId}),
+    }
+  })
