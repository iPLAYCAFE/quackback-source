@@ -0,0 +1,43 @@
+import { createHash } from 'node:crypto'
+import { sql, type Transaction } from '@/lib/server/db'
+import type { PrincipalId, TicketId } from '@quackback/ids'
+import { ValidationError } from '@/lib/shared/errors'
+
+export interface NativeSubmission { submissionId: string; digest: string }
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical)
+  if (value && typeof value === 'object') return Object.fromEntries(
+    Object.entries(value).filter(([, entry]) => entry !== undefined)
+      .sort(([a], [b]) => a.localeCompare(b)).map(([key, entry]) => [key, canonical(entry)])
+  )
+  return value
+}
+
+export function nativeSubmissionDigest(input: unknown): string {
+  return createHash('sha256').update(JSON.stringify(canonical(input))).digest('hex')
+}
+
+/** The lock, mapping and native ticket/pair share ONE native create transaction. */
+export async function lookupNativeSubmission(
+  tx: Transaction, principalId: PrincipalId, submission: NativeSubmission
+): Promise<TicketId | null> {
+  await tx.execute(sql`SELECT pg_advisory_xact_lock(hashtextextended(
+    ${`ipc-native:${principalId}:${submission.submissionId}`}, 0))`)
+  const rows = await tx.execute(sql`SELECT ticket_id, body_digest FROM ipc_native_submission
+    WHERE principal_id = ${principalId} AND submission_id = ${submission.submissionId}`)
+  const previous = rows[0]
+  if (!previous) return null
+  if (previous.body_digest !== submission.digest) {
+    throw new ValidationError('SUBMISSION_CONFLICT', 'Submission ID already has a different report')
+  }
+  return previous.ticket_id as TicketId
+}
+
+export async function recordNativeSubmission(
+  tx: Transaction, principalId: PrincipalId, submission: NativeSubmission, ticketId: TicketId
+) {
+  await tx.execute(sql`INSERT INTO ipc_native_submission
+    (principal_id, submission_id, body_digest, ticket_id)
+    VALUES (${principalId}, ${submission.submissionId}, ${submission.digest}, ${ticketId})`)
+}
