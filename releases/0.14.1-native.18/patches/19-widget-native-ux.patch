@@ -0,0 +1,148 @@
+// @vitest-environment happy-dom
+/**
+ * Host-armed "Report an issue" Home action: hidden until a host origin arms it,
+ * then the FIRST Home card, styled like the other action cards (icon tile,
+ * title = host label, localized subtitle), posting only to the armed origin.
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+import type { ReactNode } from 'react'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { IntlProvider } from 'react-intl'
+import th from '@/locales/th.json'
+
+vi.mock('../widget-auth-provider', () => ({
+  useWidgetAuth: () => ({ user: null, isIdentified: false }),
+}))
+// The recent-message and recent-tickets cards render too, so "first" is
+// measured against every Home card, not only the admin-ordered ones.
+vi.mock('../use-messenger-summary', () => ({
+  useConversationSummary: () => ({
+    conversation: { id: 'c1' },
+    teamName: 'Team',
+    agentsOnline: false,
+  }),
+}))
+vi.mock('../widget-resume-card', () => ({
+  WidgetResumeCard: () => <button type="button">Resume conversation</button>,
+}))
+vi.mock('../widget-recent-tickets', () => ({
+  WidgetRecentTicketsCard: () => <button type="button">Recent tickets</button>,
+}))
+vi.mock('../widget-changelog-teaser', () => ({ WidgetChangelogTeaser: () => null }))
+vi.mock('@/components/ui/scroll-area', () => ({
+  ScrollArea: ({ children }: { children?: ReactNode }) => <div>{children}</div>,
+}))
+vi.mock('framer-motion', async () => {
+  const { createElement, forwardRef } = await import('react')
+  const MOTION_PROPS = new Set(['initial', 'animate', 'exit', 'transition', 'variants'])
+  const make = (tag: string) =>
+    forwardRef<HTMLElement, Record<string, unknown>>((props, ref) => {
+      const { children, ...rest } = props
+      const dom: Record<string, unknown> = { ref }
+      for (const [key, value] of Object.entries(rest)) {
+        if (!MOTION_PROPS.has(key)) dom[key] = value
+      }
+      return createElement(tag, dom, children as ReactNode)
+    })
+  const proxy = new Proxy(
+    {},
+    { get: (_target, prop) => (typeof prop === 'string' ? make(prop) : undefined) }
+  )
+  return { m: proxy, motion: proxy, useReducedMotion: () => true }
+})
+
+import { WidgetOverview } from '../widget-overview'
+import { configureNativeCapture } from '../widget-native-capture'
+
+const HOST = 'https://paikaan.app'
+
+function renderOverview(locale = 'en', messages?: Record<string, string>) {
+  const noop = () => {}
+  return render(
+    <IntlProvider locale={locale} messages={messages}>
+      <WidgetOverview
+        tabs={{ feedback: true, messages: true, help: true, tickets: true }}
+        home={null}
+        assistant={null}
+        team={[]}
+        topArticles={[]}
+        onLeaveFeedback={noop}
+        onOpenHelp={noop}
+        onOpenHelpArticle={noop}
+        onStartConversation={noop}
+        onResumeMessenger={noop}
+        onOpenTicket={noop}
+        onSeeChangelog={noop}
+        onOpenChangelogEntry={noop}
+      />
+    </IntlProvider>
+  )
+}
+
+function homeCards(): HTMLButtonElement[] {
+  return Array.from(document.querySelectorAll('button')).filter((b) => b.textContent)
+}
+
+describe('WidgetOverview native capture action', () => {
+  beforeEach(() => {
+    act(() => configureNativeCapture('', { enabled: false }))
+  })
+  afterEach(() => {
+    cleanup()
+    vi.restoreAllMocks()
+  })
+
+  it('is absent until a host origin arms it', () => {
+    renderOverview()
+    expect(screen.queryByText('Report an issue')).toBeNull()
+    act(() => configureNativeCapture(HOST, { enabled: false, label: 'Report an issue' }))
+    expect(screen.queryByText('Report an issue')).toBeNull()
+    act(() => configureNativeCapture('', { enabled: true, label: 'Report an issue' }))
+    expect(screen.queryByText('Report an issue')).toBeNull()
+  })
+
+  it('renders first, as an action card with the host label and a subtitle', () => {
+    act(() => configureNativeCapture(HOST, { enabled: true, label: 'Report an issue' }))
+    renderOverview()
+    const cards = homeCards()
+    expect(cards.length).toBeGreaterThan(1)
+    const first = cards[0]
+    expect(first.textContent).toContain('Report an issue')
+    const texts = cards.map((b) => b.textContent)
+    expect(texts.indexOf('Resume conversation')).toBeGreaterThan(0)
+    expect(texts.indexOf('Recent tickets')).toBeGreaterThan(0)
+    expect(first.textContent).toContain('Screenshot or screen recording')
+    // Same chrome as the other Home action cards (e.g. Suggest a feature).
+    const feedback = cards.find((b) => b.textContent?.includes('Suggest a feature'))!
+    expect(first.className).toBe(feedback.className)
+    expect(first.querySelector('svg')).toBeTruthy()
+  })
+
+  it('uses the widget catalog for the subtitle (Thai)', () => {
+    act(() => configureNativeCapture(HOST, { enabled: true, label: 'แจ้งปัญหา' }))
+    renderOverview('th', th as Record<string, string>)
+    const first = homeCards()[0]
+    expect(first.textContent).toContain('แจ้งปัญหา')
+    expect(first.textContent).toContain('จับภาพหน้าจอหรืออัดวิดีโอ')
+  })
+
+  it('posts the unchanged native-capture-request to the armed origin only', () => {
+    const post = vi.spyOn(window.parent, 'postMessage').mockImplementation(() => {})
+    act(() => configureNativeCapture(HOST, { enabled: true, label: 'Report an issue' }))
+    renderOverview()
+    fireEvent.click(homeCards()[0])
+    expect(post).toHaveBeenCalledTimes(1)
+    expect(post).toHaveBeenCalledWith(
+      {
+        type: 'quackback:event',
+        name: 'native-capture-request',
+        payload: {
+          contract: 'iplaycafe.feedback/native-1',
+          audience: window.location.origin,
+          hostOrigin: HOST,
+        },
+      },
+      HOST
+    )
+  })
+})
