@@ -0,0 +1,122 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+// @ts-expect-error Node strip-types execution requires explicit source extensions.
+import * as routeModule from '../customer-agent-route.ts'
+
+const complete = {
+  aiCustomerAgentBaseUrl:
+    'https://gateway.ai.cloudflare.com/v1/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/customer/workers-ai/v1',
+  aiCustomerAgentApiKey: 'synthetic-workers-read-only',
+  aiCustomerAgentDefaultHeaders: '{"cf-aig-authorization":"Bearer synthetic-customer-gateway"}',
+  aiCustomerAgentModel: 'synthetic-customer-model',
+  aiCustomerAgentReasoningEffort: 'low',
+}
+
+test('customer route must exist independently of the global AI client', () => {
+  assert.equal(typeof routeModule.resolveCustomerAgentRoute, 'function')
+  const route = routeModule.resolveCustomerAgentRoute(complete)
+  assert.equal(route?.model, complete.aiCustomerAgentModel)
+  assert.equal(route?.openaiApiKey, complete.aiCustomerAgentApiKey)
+  assert.equal(route?.reasoningEffort, 'low')
+  for (const key of Object.keys(complete)) {
+    assert.equal(routeModule.resolveCustomerAgentRoute({ ...complete, [key]: undefined }), null)
+    assert.equal(routeModule.resolveCustomerAgentRoute({ ...complete, [key]: ' ' }), null)
+  }
+  assert.equal(routeModule.resolveCustomerAgentRoute({}), null)
+})
+
+test('invalid endpoint, headers, model or reasoning leaves the customer route off', () => {
+  for (const url of [
+    'https://api.openai.com/v1',
+    complete.aiCustomerAgentBaseUrl.replace('/workers-ai/v1', '/openai'),
+    complete.aiCustomerAgentBaseUrl.replace('cloudflare.com/', 'cloudflare.com.evil.invalid/'),
+    complete.aiCustomerAgentBaseUrl + '?secret=synthetic',
+    complete.aiCustomerAgentBaseUrl + '#fragment',
+  ])
+    assert.equal(
+      routeModule.resolveCustomerAgentRoute({ ...complete, aiCustomerAgentBaseUrl: url }),
+      null
+    )
+  for (const value of ['none', 'minimal', 'medium', 'xhigh'])
+    assert.equal(
+      routeModule.resolveCustomerAgentRoute({ ...complete, aiCustomerAgentReasoningEffort: value }),
+      null
+    )
+  for (const value of ['off', 'none', 'false'])
+    assert.equal(
+      routeModule.resolveCustomerAgentRoute({ ...complete, aiCustomerAgentModel: value }),
+      null
+    )
+  for (const value of [
+    'null',
+    '[]',
+    '{"Authorization":null}',
+    '{"authorization":"Bearer other"}',
+    '{"x-extra":"synthetic"}',
+  ])
+    assert.equal(
+      routeModule.resolveCustomerAgentRoute({ ...complete, aiCustomerAgentDefaultHeaders: value }),
+      null
+    )
+})
+
+test('direct Workers AI requires an explicit Gateway budget binding', () => {
+  const direct = {
+    ...complete,
+    aiCustomerAgentBaseUrl:
+      'https://api.cloudflare.com/client/v4/accounts/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/ai/v1',
+  }
+  assert.equal(routeModule.resolveCustomerAgentRoute(direct), null)
+  assert.equal(
+    routeModule.resolveCustomerAgentRoute({
+      ...direct,
+      aiCustomerAgentDefaultHeaders: '{"cf-aig-gateway-id":"customer"}',
+    })?.model,
+    complete.aiCustomerAgentModel
+  )
+  for (const value of [null, '', '../other', 42]) {
+    assert.equal(
+      routeModule.resolveCustomerAgentRoute({
+        ...direct,
+        aiCustomerAgentDefaultHeaders: JSON.stringify({ 'cf-aig-gateway-id': value }),
+      }),
+      null
+    )
+  }
+  assert.equal(
+    routeModule.resolveCustomerAgentRoute({
+      ...complete,
+      aiCustomerAgentDefaultHeaders: '{"cf-aig-gateway-id":"different-gateway"}',
+    }),
+    null
+  )
+})
+
+test('customer transport refuses another endpoint or model before forwarding and blocks redirects', async () => {
+  const route = routeModule.resolveCustomerAgentRoute(complete)!
+  const seen: Request[] = []
+  const transport = routeModule.customerAgentFetch(route, async (request: Request) => {
+    seen.push(request)
+    return Response.json({ synthetic: true })
+  })
+  const init = { method: 'POST', body: JSON.stringify({ model: complete.aiCustomerAgentModel }) }
+  for (const url of [
+    'https://api.openai.com/v1/chat/completions',
+    route.openaiBaseUrl + '/embeddings',
+  ])
+    await assert.rejects(() => transport(url, init), {
+      message: 'Customer agent transport refused',
+    })
+  await assert.rejects(
+    () =>
+      transport(route.openaiBaseUrl + '/chat/completions', {
+        ...init,
+        body: JSON.stringify({ model: 'global-model' }),
+      }),
+    { message: 'Customer agent transport refused' }
+  )
+  assert.equal(seen.length, 0)
+  await transport(route.openaiBaseUrl + '/chat/completions', init)
+  assert.equal(seen.length, 1)
+  assert.equal(seen[0].redirect, 'error')
+})
