new file mode 100644
--- /dev/null
+++ b/apps/web/src/lib/server/domains/ai/customer-agent-route.ts
@@ -0,0 +1,90 @@
+/** Customer support has no implicit provider, credential, model or global fallback. */
+export interface CustomerAgentConfig {
+  aiCustomerAgentBaseUrl?: string
+  aiCustomerAgentApiKey?: string
+  aiCustomerAgentDefaultHeaders?: string
+  aiCustomerAgentModel?: string
+  aiCustomerAgentReasoningEffort?: string
+}
+
+export interface CustomerAgentRoute {
+  openaiBaseUrl: string
+  openaiApiKey: string
+  openaiDefaultHeaders: string
+  model: string
+  reasoningEffort: 'low' | 'high' | 'max'
+}
+
+export function resolveCustomerAgentRoute(config: CustomerAgentConfig): CustomerAgentRoute | null {
+  const baseURL = config.aiCustomerAgentBaseUrl?.trim()
+  const apiKey = config.aiCustomerAgentApiKey?.trim()
+  const rawHeaders = config.aiCustomerAgentDefaultHeaders?.trim()
+  const model = config.aiCustomerAgentModel?.trim()
+  const effort = config.aiCustomerAgentReasoningEffort?.trim().toLowerCase()
+  if (!baseURL || !apiKey || !rawHeaders || !model || !effort) return null
+  if (['off', 'none', 'false'].includes(model.toLowerCase())) return null
+  if (effort !== 'low' && effort !== 'high' && effort !== 'max') return null
+  try {
+    const url = new URL(baseURL)
+    if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash)
+      return null
+    if (!(
+      (url.origin === 'https://gateway.ai.cloudflare.com' &&
+        /^\/v1\/[a-f0-9]{32}\/[A-Za-z0-9_-]+\/workers-ai\/v1\/?$/.test(url.pathname)) ||
+      (url.origin === 'https://api.cloudflare.com' &&
+        /^\/client\/v4\/accounts\/[a-f0-9]{32}\/ai\/v1\/?$/.test(url.pathname))
+    ))
+      return null
+    // Dedicated API key supplies Workers AI authorization. Never permit headers
+    // to replace/remove it or inherit global gateway credentials.
+    const headers: unknown = JSON.parse(rawHeaders)
+    if (!headers || typeof headers !== 'object' || Array.isArray(headers)) return null
+    const seen = new Set<string>()
+    let gatewayId: unknown
+    for (const [name, value] of Object.entries(headers)) {
+      const key = name.toLowerCase()
+      if (
+        seen.has(key) ||
+        !['cf-aig-authorization', 'cf-aig-gateway-id', 'x-stainless-lang'].includes(key)
+      )
+        return null
+      if (value !== null && typeof value !== 'string') return null
+      if (value !== null) new Headers([[key, value]])
+      if (key === 'cf-aig-gateway-id') gatewayId = value
+      seen.add(key)
+    }
+    if (url.origin === 'https://api.cloudflare.com') {
+      if (typeof gatewayId !== 'string' || !/^[A-Za-z0-9_-]+$/.test(gatewayId)) return null
+    } else if (gatewayId !== undefined && gatewayId !== url.pathname.split('/')[3]) return null
+    return {
+      openaiBaseUrl: baseURL.replace(/\/$/, ''),
+      openaiApiKey: apiKey,
+      openaiDefaultHeaders: rawHeaders,
+      model,
+      reasoningEffort: effort,
+    }
+  } catch {
+    return null
+  }
+}
+
+/** Only chat completions for the admitted customer model may carry this credential. */
+export function customerAgentFetch(
+  route: CustomerAgentRoute,
+  transport: (input: Request) => Promise<Response>
+) {
+  return async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+    const request = new Request(input, init)
+    if (request.method !== 'POST' || request.url !== route.openaiBaseUrl + '/chat/completions')
+      throw new Error('Customer agent transport refused')
+    let body: unknown
+    try {
+      body = await request.clone().json()
+    } catch {
+      throw new Error('Customer agent transport refused')
+    }
+    if (!body || typeof body !== 'object' || (body as { model?: unknown }).model !== route.model)
+      throw new Error('Customer agent transport refused')
+    return transport(new Request(request, { redirect: 'error' }))
+  }
+}
