diff --git a/packages/db/drizzle/0297_native_evidence_deletion.sql b/packages/db/drizzle/0297_native_evidence_deletion.sql
new file mode 100644
--- /dev/null
+++ b/packages/db/drizzle/0297_native_evidence_deletion.sql
@@ -0,0 +1,23 @@
+CREATE TABLE ipc_native_evidence_deletion (
+ report_id text PRIMARY KEY REFERENCES ipc_native_evidence_report(report_id),
+ binding_ref text NOT NULL REFERENCES ipc_native_evidence_binding(binding_ref),
+ phase text NOT NULL CHECK(phase IN ('deleting','deleted')),
+ requested_at timestamptz NOT NULL DEFAULT now(),
+ completed_at timestamptz,
+ CHECK((phase='deleting' AND completed_at IS NULL) OR (phase='deleted' AND completed_at IS NOT NULL))
+);
+--> statement-breakpoint
+CREATE FUNCTION ipc_native_evidence_deletion_fence() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF TG_OP='INSERT' AND NOT EXISTS(SELECT 1 FROM ipc_native_evidence_binding b
+   WHERE b.report_id=NEW.report_id AND b.binding_ref=NEW.binding_ref AND b.phase='confirmed')
+ THEN RAISE EXCEPTION 'deletion requires confirmed binding'; END IF;
+ IF TG_OP='UPDATE' AND (NEW.report_id IS DISTINCT FROM OLD.report_id OR
+   NEW.binding_ref IS DISTINCT FROM OLD.binding_ref OR NEW.requested_at IS DISTINCT FROM OLD.requested_at OR
+   OLD.phase='deleted' AND NEW IS DISTINCT FROM OLD)
+ THEN RAISE EXCEPTION 'immutable evidence deletion'; END IF;
+ RETURN NEW;
+END $$;
+--> statement-breakpoint
+CREATE TRIGGER ipc_native_evidence_deletion_intent BEFORE INSERT OR UPDATE ON ipc_native_evidence_deletion
+ FOR EACH ROW EXECUTE FUNCTION ipc_native_evidence_deletion_fence();
