+/** Delete the exact committed attachment set while retaining its customer Ticket. */
+export async function runDeleteNativeEvidence(ctx: AuthContext, input: {ticketId:string}) {
+  const server = serverConfig()
+  if (!isValidTypeId(input.ticketId,'ticket')) throw new Error('EVIDENCE_DENIED')
+  async function locked(tx:Transaction) {
+    await requireIdentifiedSession(ctx,tx)
+    const rows = await tx.execute(sql`SELECT * FROM ipc_native_evidence_report
+      WHERE ticket_id=${input.ticketId} AND principal_id=${ctx.principal.id} AND tenant_ref=${ctx.settings.id} FOR UPDATE`)
+    const row = rows[0] as unknown as ReportRow | undefined
+    const own = await tx.select({id:tickets.id}).from(tickets).where(and(
+      eq(tickets.id,input.ticketId as TicketId),eq(tickets.requesterPrincipalId,ctx.principal.id),
+      eq(tickets.type,'customer'),isNull(tickets.deletedAt))).for('update').limit(1)
+    if (rows.length !== 1 || !row || !own[0] || row.ticket_id !== input.ticketId ||
+      row.principal_id !== ctx.principal.id || row.tenant_ref !== ctx.settings.id ||
+      !row.submission_id || !row.body_digest || !row.evidence_ids?.length) throw new Error('EVIDENCE_DENIED')
+    const state = (await tx.execute(sql`SELECT * FROM ipc_native_evidence_binding WHERE report_id=${row.report_id} FOR UPDATE`))[0]
+    const tuple = nativeEvidenceBindingCommand(binding(row),{reportId:row.report_id,ticketId:row.ticket_id,
+      submissionId:row.submission_id,bodyDigest:row.body_digest,evidenceIds:row.evidence_ids})
+    if (!state || state.phase !== 'confirmed' || state.binding_ref !== tuple.command.bindingRef ||
+      state.tuple_json !== tuple.tupleJson) throw new Error('EVIDENCE_BINDING_CONFLICT')
+    await tx.execute(sql`INSERT INTO ipc_native_evidence_deletion(report_id,binding_ref,phase)
+      VALUES(${row.report_id},${tuple.command.bindingRef},'deleting') ON CONFLICT(report_id) DO NOTHING`)
+    const deletion = (await tx.execute(sql`SELECT * FROM ipc_native_evidence_deletion WHERE report_id=${row.report_id} FOR UPDATE`))[0]
+    if (!deletion || deletion.binding_ref !== tuple.command.bindingRef || !['deleting','deleted'].includes(deletion.phase as string))
+      throw new Error('EVIDENCE_BINDING_CONFLICT')
+    return {row,tuple,deletion}
+  }
+  // This commit precedes every remote request and fences metadata, old read
+  // grants and every ongoing native stream pull. Unknown outcomes never undo it.
+  const selected = await db.transaction(locked)
+  if (selected.deletion.phase !== 'deleted') {
+    await deleteBoundPrivateEvidence(binding(selected.row),selected.tuple.command,selected.row.allowed_kinds,server)
+    await db.transaction(async tx => {
+      const current = await locked(tx)
+      await tx.execute(sql`UPDATE ipc_native_evidence_deletion SET phase='deleted',completed_at=now()
+        WHERE report_id=${current.row.report_id} AND phase='deleting'`)
+    })
+  }
+  return {ticketId:input.ticketId,deleted:true}
 }
 
