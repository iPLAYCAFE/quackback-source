+/** Server only; a successful DELETE must prove both raw and sanitized terminal state. */
+export async function deleteBoundPrivateEvidence(
+  binding: EvidenceBinding,
+  command: NativeEvidenceBindingCommand,
+  allowedKinds: readonly EvidenceKind[],
+  server: NonNullable<ReturnType<typeof evidenceServerConfig>>
+) {
+  const grant = mintEvidenceCapability(binding, allowedKinds, server.signingKey, 'server_bound_delete', Date.now(), () => command.bindingRef)
+  for (const evidenceId of command.evidenceIds) {
+    const abort = new AbortController(), timer = setTimeout(() => abort.abort(), 8000)
+    try {
+      const response = await fetch(`${server.brokerOrigin}/v1/evidence/${evidenceId}`, {
+        method:'DELETE', credentials:'omit', cache:'no-store', redirect:'error', signal:abort.signal,
+        headers:{'Content-Type':'application/json',Accept:'application/json',Authorization:`Bearer ${grant.capability}`},
+        body:JSON.stringify({schemaVersion:1,evidenceId,idempotencyKey:`idem_${command.bindingRef}`}),
+      })
+      if (response.status !== 200) throw new Error()
+      const text = await response.text()
+      if (text.length > 8192) throw new Error()
+      const value = JSON.parse(text)
+      const created = timestamp(value.createdAt), raw = timestamp(value.rawDeleteBy)
+      if (Object.keys(value).sort().join() !== RESPONSE_KEYS.join() || value.schemaVersion !== 1 ||
+        value.evidenceId !== evidenceId || !allowedKinds.includes(value.kind) || value.status !== 'deleted' ||
+        !((value.outcome === 'discarded' && value.reasonCode === 'REPORTER_DISCARDED') ||
+          (value.outcome === 'expired' && value.reasonCode === 'ABSOLUTE_TTL_EXPIRED')) ||
+        created === null || raw !== created + 86400000 || timestamp(value.expiresAt) !== raw ||
+        !Number.isSafeInteger(value.sourceRevision) || value.sourceRevision < 3 ||
+        !Number.isSafeInteger(value.processingRevision) || value.processingRevision <= value.sourceRevision - 2 ||
+        value.revision !== value.processingRevision + 2 || typeof value.idempotentReplay !== 'boolean' || value.textReportMaySubmit !== true ||
+        value.deletionPending !== false || value.processingStatus !== 'deleted' || !['SOURCE_REVOKED','RETENTION_EXPIRED'].includes(value.processingReasonCode) ||
+        value.processingRequired !== false || value.sanitizedDerivativeAvailable !== false ||
+        value.sanitizedDerivativeExpiresAt !== null || value.upload !== null) throw new Error()
+    } catch { throw new Error('EVIDENCE_DELETION_UNAVAILABLE') }
+    finally { clearTimeout(timer) }
+  }
+}
