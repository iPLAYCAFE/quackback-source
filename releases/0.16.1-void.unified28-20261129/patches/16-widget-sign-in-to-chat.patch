 import type { UploadedFile } from '@/lib/shared/conversation/types'
 
 /** A rejected upload. `reason` mirrors the server's FileRejectedError reason
- *  (empty | too_large | blocked) when the rejection is definitive — a
+ *  (empty | too_large | blocked), or sign_in_required for an anonymous upload a
+ *  signed-in only workspace refuses, when the rejection is definitive — a
  *  pre-check or a server refusal that will fail again unchanged. No reason
  *  means a transient failure (network, abort-adjacent, a 500): worth a retry. */
 export class UploadError extends Error {
@@ -48,6 +49,18 @@ function errorMessageFrom(error: unknown): string | undefined {
   return undefined
 }
 
+/** The `code` of a widget-endpoint error body (`{ error: { code } }`), if any. */
+function errorCodeFrom(error: unknown): string | undefined {
+  if (
+    error &&
+    typeof error === 'object' &&
+    typeof (error as { code?: unknown }).code === 'string'
+  ) {
+    return (error as { code: string }).code
+  }
+  return undefined
+}
+
 /** Clipboard pastes often hand over a nameless Blob. Give it a name that
  *  matches its declared type so the server (and the tray) show something
  *  sensible instead of a bare extension-less "file". */
@@ -108,6 +121,20 @@ export function uploadFile(file: File, options: UploadFileOptions): Promise<Uplo
         reject(new UploadError(message ?? 'Too many uploads, slow down', 'rate_limited'))
         return
       }
+      // A body-size refusal can come from a proxy in front of the app (an HTML
+      // page, no JSON), so the status alone decides: the tile then says the
+      // family's limit instead of a bare "Upload failed".
+      if (xhr.status === 413) {
+        const maxBytes = maxBytesForFamily(familyFor(name, file.type))
+        reject(new UploadError(`Over ${formatBytes(maxBytes)}`, 'too_large'))
+        return
+      }
+      // Signed-in only workspaces refuse anonymous uploads with this code; the
+      // fix is signing in, not retrying.
+      if (xhr.status === 403 && errorCodeFrom(body.error) === 'ANONYMOUS_DISABLED') {
+        reject(new UploadError(message ?? 'Sign in to send files', 'sign_in_required'))
+        return
+      }
       reject(new UploadError(message ?? 'Upload failed', body.reason))
     }
     xhr.send(file)
