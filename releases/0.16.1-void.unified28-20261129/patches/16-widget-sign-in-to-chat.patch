index 000000000..d6d464ecd
--- /dev/null
+++ b/apps/web/src/components/widget/__tests__/widget-messenger-sign-in.test.tsx
@@ -0,0 +1,124 @@
+// @vitest-environment happy-dom
+/**
+ * With the workspace's anonymous switch off, the server refuses an anonymous
+ * conversation (and the anonymous session it would need). The messenger says
+ * so up front: an unidentified visitor gets "Sign in to chat" instead of a
+ * composer whose send would fail, and the button asks the host page to sign
+ * them in (`auth-required`). Never before identity resolves, so a visitor the
+ * host is still identifying is not told to sign in.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { IntlProvider } from 'react-intl'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+
+const threadProps = vi.fn()
+const emitEvent = vi.fn()
+const auth = {
+  user: null as { name: string } | null,
+  identityResolved: true,
+}
+
+vi.mock('@/components/shared/conversation/visitor-conversation-thread', () => ({
+  VisitorConversationThread: (props: Record<string, unknown>) => {
+    threadProps(props)
+    return <div data-testid="thread" />
+  },
+}))
+vi.mock('../widget-auth-provider', () => ({
+  useWidgetAuth: () => ({
+    user: auth.user,
+    identityResolved: auth.identityResolved,
+    ensureSession: vi.fn(),
+    sessionVersion: 0,
+    emitEvent,
+  }),
+}))
+vi.mock('../use-messenger-presence', () => ({
+  useConversationPresence: () => ({ online: false }),
+  markAgentPresentInCache: vi.fn(),
+}))
+vi.mock('../use-widget-file-upload', () => ({ useWidgetFileUpload: () => ({ upload: vi.fn() }) }))
+
+const { WidgetMessenger } = await import('../widget-messenger')
+
+function renderMessenger(props: Record<string, unknown>, messages: Record<string, string> = {}) {
+  return render(
+    <IntlProvider locale="en" messages={messages}>
+      <QueryClientProvider client={new QueryClient()}>
+        <WidgetMessenger {...props} />
+      </QueryClientProvider>
+    </IntlProvider>
+  )
+}
+
+beforeEach(() => {
+  auth.user = null
+  auth.identityResolved = true
+  threadProps.mockClear()
+  emitEvent.mockClear()
+})
+afterEach(cleanup)
+
+describe('WidgetMessenger with anonymous access off', () => {
+  it('asks an unidentified visitor to sign in instead of showing a composer', () => {
+    renderMessenger({ allowAnonymous: false })
+    expect(screen.getByTestId('widget-sign-in-to-chat')).toBeTruthy()
+    expect(screen.getByText('Sign in to chat')).toBeTruthy()
+    expect(threadProps).not.toHaveBeenCalled()
+  })
+
+  it('hands the sign-in to the host page with the auth-required event', () => {
+    renderMessenger({ allowAnonymous: false })
+    fireEvent.click(screen.getByRole('button', { name: 'Sign in' }))
+    expect(emitEvent).toHaveBeenCalledTimes(1)
+    expect(emitEvent).toHaveBeenCalledWith('auth-required', { reason: 'conversation' })
+  })
+
+  it('reads the Thai catalog', async () => {
+    const th = (await import('@/locales/th.json')).default as Record<string, string>
+    renderMessenger({ allowAnonymous: false }, th)
+    expect(screen.getByText('เข้าสู่ระบบเพื่อแชท')).toBeTruthy()
+    expect(screen.getByRole('button', { name: 'เข้าสู่ระบบ' })).toBeTruthy()
+  })
+
+  it('keeps the thread while identity is still resolving (no sign-in flash for a signed-in visitor)', () => {
+    auth.identityResolved = false
+    renderMessenger({ allowAnonymous: false })
+    expect(screen.queryByTestId('widget-sign-in-to-chat')).toBeNull()
+    expect(threadProps).toHaveBeenCalled()
+  })
+
+  it('gives way to the thread as soon as a late host identify lands', () => {
+    // The SDK's default anonymous identify resolves identity before a native
+    // host's identify ACK; the prompt then shows for that interval only.
+    const view = renderMessenger({ allowAnonymous: false })
+    expect(screen.getByTestId('widget-sign-in-to-chat')).toBeTruthy()
+    auth.user = { name: 'Owner' }
+    view.rerender(
+      <IntlProvider locale="en" messages={{}}>
+        <QueryClientProvider client={new QueryClient()}>
+          <WidgetMessenger allowAnonymous={false} />
+        </QueryClientProvider>
+      </IntlProvider>
+    )
+    expect(screen.queryByTestId('widget-sign-in-to-chat')).toBeNull()
+    expect(threadProps).toHaveBeenCalled()
+  })
+
+  it('shows the thread to an identified visitor', () => {
+    auth.user = { name: 'Owner' }
+    renderMessenger({ allowAnonymous: false })
+    expect(screen.queryByTestId('widget-sign-in-to-chat')).toBeNull()
+    expect(threadProps).toHaveBeenCalled()
+  })
+})
+
+describe('WidgetMessenger with anonymous access on (upstream default)', () => {
+  it('shows the composer thread to an anonymous visitor, as before', () => {
+    renderMessenger({})
+    expect(screen.queryByTestId('widget-sign-in-to-chat')).toBeNull()
+    expect(threadProps).toHaveBeenCalled()
+    expect(emitEvent).not.toHaveBeenCalled()
+  })
+})
