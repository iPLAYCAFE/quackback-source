--- /dev/null
+++ b/apps/web/src/components/widget/widget-sign-in-to-chat.tsx
@@ -0,0 +1,41 @@
+import { FormattedMessage } from 'react-intl'
+import { ChatBubbleOvalLeftEllipsisIcon } from '@heroicons/react/24/solid'
+
+interface WidgetSignInToChatProps {
+  /** Asks the host page to sign the visitor in (the `auth-required` event). */
+  onSignIn: () => void
+}
+
+/**
+ * Stands in for the messenger composer when the workspace has anonymous access
+ * off and the visitor is not identified. The server refuses an anonymous
+ * conversation anyway; this says so before anything is typed, and hands the
+ * sign-in to the host page, which owns the visitor's account. Help articles,
+ * boards and updates stay readable in the other tabs.
+ */
+export function WidgetSignInToChat({ onSignIn }: WidgetSignInToChatProps) {
+  return (
+    <div
+      className="flex h-full flex-col items-center justify-center px-6 py-16 text-center animate-in fade-in duration-200 motion-reduce:animate-none"
+      data-testid="widget-sign-in-to-chat"
+    >
+      <ChatBubbleOvalLeftEllipsisIcon className="mb-2 h-8 w-8 text-muted-foreground/30" />
+      <p className="text-sm font-medium text-foreground">
+        <FormattedMessage id="widget.signInToChat.title" defaultMessage="Sign in to chat" />
+      </p>
+      <p className="mt-1 text-xs text-muted-foreground">
+        <FormattedMessage
+          id="widget.signInToChat.body"
+          defaultMessage="Conversations are for signed-in users. Help articles, feedback and updates stay open to everyone."
+        />
+      </p>
+      <button
+        type="button"
+        onClick={onSignIn}
+        className="mt-4 inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
+      >
+        <FormattedMessage id="widget.signInToChat.action" defaultMessage="Sign in" />
+      </button>
+    </div>
+  )
+}
diff --git a/apps/web/src/lib/client/files/__tests__/upload-file-refusals.test.ts b/apps/web/src/lib/client/files/__tests__/upload-file-refusals.test.ts
new file mode 100644
index 000000000..f9e1a2aac
--- /dev/null
+++ b/apps/web/src/lib/client/files/__tests__/upload-file-refusals.test.ts
@@ -0,0 +1,99 @@
+// @vitest-environment happy-dom
+/**
+ * Definitive refusals that used to surface as a bare "Upload failed":
+ * - 413 from anything in front of the app (often an HTML page, not JSON) is a
+ *   size refusal, so the tile names the family's limit;
+ * - 403 ANONYMOUS_DISABLED (a signed-in only workspace) asks for a sign-in.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { uploadFile, UploadError } from '../upload-file'
+
+class FakeXHR {
+  static instances: FakeXHR[] = []
+  status = 0
+  responseText = ''
+  upload = { onprogress: null }
+  onload: (() => void) | null = null
+  onerror: (() => void) | null = null
+  onabort: (() => void) | null = null
+  constructor() {
+    FakeXHR.instances.push(this)
+  }
+  open() {}
+  setRequestHeader() {}
+  send() {}
+  abort() {}
+}
+
+function respond(status: number, responseText: string) {
+  const xhr = FakeXHR.instances.at(-1)
+  if (!xhr) throw new Error('no XHR was constructed')
+  xhr.status = status
+  xhr.responseText = responseText
+  xhr.onload?.()
+}
+
+function file(name: string, size: number, type: string): File {
+  const f = new File([new Uint8Array(16)], name, { type })
+  Object.defineProperty(f, 'size', { value: size })
+  return f
+}
+
+beforeEach(() => {
+  FakeXHR.instances = []
+  vi.stubGlobal('XMLHttpRequest', FakeXHR)
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+describe('uploadFile refusals', () => {
+  it('maps a proxy 413 (HTML body) to too_large with the video limit', async () => {
+    const promise = uploadFile(file('clip.mp4', 99 * 1024 * 1024, 'video/mp4'), {
+      endpoint: '/api/widget/files',
+    })
+    respond(413, '<html><body>413 Request Entity Too Large</body></html>')
+    const error = await promise.catch((e: unknown) => e)
+    expect(error).toBeInstanceOf(UploadError)
+    expect((error as UploadError).reason).toBe('too_large')
+    expect((error as UploadError).message).toBe('Over 100 MB')
+  })
+
+  it('maps a JSON 413 to too_large as well, whatever its message', async () => {
+    const promise = uploadFile(file('shot.png', 2048, 'image/png'), {
+      endpoint: '/api/widget/files',
+    })
+    respond(413, JSON.stringify({ error: 'Payload too large' }))
+    const error = (await promise.catch((e: unknown) => e)) as UploadError
+    expect(error.reason).toBe('too_large')
+    expect(error.message).toMatch(/^Over /)
+  })
+
+  it('maps 403 ANONYMOUS_DISABLED to sign_in_required', async () => {
+    const promise = uploadFile(file('shot.png', 2048, 'image/png'), {
+      endpoint: '/api/widget/files',
+    })
+    respond(
+      403,
+      JSON.stringify({
+        error: {
+          code: 'ANONYMOUS_DISABLED',
+          message: 'Authentication is required for this endpoint.',
+        },
+      })
+    )
+    const error = (await promise.catch((e: unknown) => e)) as UploadError
+    expect(error.reason).toBe('sign_in_required')
+  })
+
+  it('leaves any other 403 as before: the server text, no reason', async () => {
+    const promise = uploadFile(file('shot.png', 2048, 'image/png'), {
+      endpoint: '/api/widget/files',
+    })
+    respond(403, JSON.stringify({ error: { code: 'FORBIDDEN', message: 'Not allowed' } }))
+    const error = (await promise.catch((e: unknown) => e)) as UploadError
+    expect(error.reason).toBeUndefined()
+    expect(error.message).toBe('Not allowed')
+  })
+})
