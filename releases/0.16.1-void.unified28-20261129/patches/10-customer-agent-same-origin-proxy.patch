+test('same-origin /__ipc-ai/v1 proxy resolves with empty headers and enforces strict origin/header checks', async () => {
+  const sameOrigin = {
+    baseUrl: 'https://feedback.rerolla.store',
+    aiCustomerAgentBaseUrl: 'https://feedback.rerolla.store/__ipc-ai/v1',
+    aiCustomerAgentApiKey: 'synthetic-proxy-hmac',
+    aiCustomerAgentDefaultHeaders: '{}',
+    aiCustomerAgentModel: '@cf/deepseek-ai/deepseek-v4.1-flash-1017',
+    aiCustomerAgentReasoningEffort: 'low',
+  }
+  const route = routeModule.resolveCustomerAgentRoute(sameOrigin)
+  assert.equal(route?.openaiBaseUrl, 'https://feedback.rerolla.store/__ipc-ai/v1')
+  assert.equal(route?.openaiApiKey, sameOrigin.aiCustomerAgentApiKey)
+  assert.equal(route?.model, sameOrigin.aiCustomerAgentModel)
+  assert.equal(route?.reasoningEffort, 'low')
+
+  const trailingSlash = routeModule.resolveCustomerAgentRoute({
+    ...sameOrigin,
+    aiCustomerAgentBaseUrl: 'https://feedback.rerolla.store/__ipc-ai/v1/',
+  })
+  assert.equal(trailingSlash?.openaiBaseUrl, 'https://feedback.rerolla.store/__ipc-ai/v1')
+
+  for (const invalid of [
+    { ...sameOrigin, baseUrl: undefined },
+    { ...sameOrigin, baseUrl: 'https://other.example.com' },
+    { ...sameOrigin, baseUrl: 'http://feedback.rerolla.store' },
+    { ...sameOrigin, aiCustomerAgentBaseUrl: 'http://feedback.rerolla.store/__ipc-ai/v1' },
+    { ...sameOrigin, aiCustomerAgentBaseUrl: 'https://feedback.rerolla.store/__ipc-ai/v2' },
+    { ...sameOrigin, aiCustomerAgentBaseUrl: 'https://feedback.rerolla.store/__ipc-ai/v1/extra' },
+    { ...sameOrigin, aiCustomerAgentBaseUrl: 'https://feedback.rerolla.store/__ipc-ai/v1?x=1' },
+    { ...sameOrigin, aiCustomerAgentDefaultHeaders: '{"Authorization":"Bearer bad"}' },
+    { ...sameOrigin, aiCustomerAgentDefaultHeaders: '{"cf-aig-authorization":"Bearer x"}' },
+    { ...sameOrigin, aiCustomerAgentDefaultHeaders: '{"cf-aig-gateway-id":"gw"}' },
+    { ...sameOrigin, aiCustomerAgentDefaultHeaders: '{"x-custom":"nope"}' },
+  ]) {
+    assert.equal(routeModule.resolveCustomerAgentRoute(invalid), null)
+  }
+
+  const seen: Request[] = []
+  const transport = routeModule.customerAgentFetch(route!, async (request: Request) => {
+    seen.push(request)
+    return Response.json({ synthetic: true })
+  })
+  const init = { method: 'POST', body: JSON.stringify({ model: sameOrigin.aiCustomerAgentModel }) }
+  await assert.rejects(
+    () => transport('https://other.example.com/__ipc-ai/v1/chat/completions', init),
+    { message: 'Customer agent transport refused' }
+  )
+  await assert.rejects(
+    () =>
+      transport(route!.openaiBaseUrl + '/chat/completions', {
+        ...init,
+        body: JSON.stringify({ model: 'other-model' }),
+      }),
+    { message: 'Customer agent transport refused' }
+  )
+  assert.equal(seen.length, 0)
+  await transport(route!.openaiBaseUrl + '/chat/completions', init)
+  assert.equal(seen.length, 1)
+  assert.equal(seen[0].redirect, 'error')
+})
