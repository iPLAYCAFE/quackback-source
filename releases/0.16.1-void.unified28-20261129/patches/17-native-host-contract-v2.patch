@@ -0,0 +1,34 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, renderHook } from '@testing-library/react'
+import { configureNativeCapture, useNativeCaptureAction } from '../widget-native-capture'
+
+const origin = 'https://app.example.test'
+afterEach(() => {
+  act(() => configureNativeCapture('', { enabled: false }))
+  vi.restoreAllMocks()
+})
+
+describe('native capture request echoes the armed host contract', () => {
+  it.each([
+    [undefined, 'iplaycafe.feedback/native-1'],
+    ['iplaycafe.feedback/native-1', 'iplaycafe.feedback/native-1'],
+    ['iplaycafe.feedback/native-2', 'iplaycafe.feedback/native-2'],
+  ] as const)('armed with %s posts %s', (armed, expected) => {
+    const post = vi.spyOn(window.parent, 'postMessage').mockImplementation(() => {})
+    const { result } = renderHook(() => useNativeCaptureAction())
+    act(() =>
+      armed
+        ? configureNativeCapture(origin, { enabled: true }, armed)
+        : configureNativeCapture(origin, { enabled: true })
+    )
+    act(() => result.current!.request())
+    expect(post).toHaveBeenCalledWith(
+      {
+        type: 'quackback:event',
+        name: 'native-capture-request',
+        payload: { contract: expected, audience: window.location.origin, hostOrigin: origin },
+      },
+      origin
+    )
+  })
+})
