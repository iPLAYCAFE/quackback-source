index 000000000..015367c13
--- /dev/null
+++ b/apps/web/src/lib/client/__tests__/native-host-controller-contracts.test.ts
@@ -0,0 +1,104 @@
+import { describe, it, expect, vi } from 'vitest'
+import { createNativeHostController } from '../native-host-controller'
+import { nativeHostCommandSchema, nativeHostContextSchema } from '@/lib/shared/widget/native-host'
+import type { NativeHostContext } from '@/lib/shared/widget/native-host'
+
+const V1 = 'iplaycafe.feedback/native-1'
+const V2 = 'iplaycafe.feedback/native-2'
+const origin = 'https://app.example.test'
+const audience = 'https://feedback.example.test'
+function command(contract: string, type: string, payload = {}) {
+  return {contract, operationId: crypto.randomUUID(), type, payload}
+}
+function ports() {
+  return {audience, clearIdentity: vi.fn(() => 'previous'), applyIdentity: vi.fn(),
+    identify: vi.fn(async (_payload: Record<string, unknown>, context: NativeHostContext, _previous: string | null): Promise<Record<string, unknown>> => ({
+      sessionToken: 'native-session', user: {id: 'u'}, nativeAck: {...context, audience, jti: crypto.randomUUID()}})),
+    action: vi.fn(async (): Promise<Record<string, unknown>> => ({loggedOut: true})), respond: vi.fn(), configureCapture: vi.fn()}
+}
+const replies = (p: ReturnType<typeof ports>, operationId: string) =>
+  p.respond.mock.calls.filter(([, , value]) => value.operationId === operationId).map(([, , value]) => value)
+
+describe('native host contracts: exactly native-1 and native-2', () => {
+  it('accepts both literals and nothing else', () => {
+    for (const contract of [V1, V2]) {
+      expect(nativeHostCommandSchema.safeParse(command(contract, 'identify')).success).toBe(true)
+      expect(nativeHostContextSchema.safeParse({contract, operationId: crypto.randomUUID(), hostOrigin: origin}).success).toBe(true)
+    }
+    for (const contract of ['iplaycafe.feedback/native-3', 'iplaycafe.feedback/native-', 'native-2', '', 'IPLAYCAFE.FEEDBACK/NATIVE-2']) {
+      expect(nativeHostCommandSchema.safeParse(command(contract, 'identify')).success).toBe(false)
+      expect(nativeHostContextSchema.safeParse({contract, operationId: crypto.randomUUID(), hostOrigin: origin}).success).toBe(false)
+    }
+  })
+  it('ignores a command with an unknown contract entirely', async () => {
+    const p = ports(); await createNativeHostController(p).receive(command('iplaycafe.feedback/native-9', 'identify'), origin)
+    expect(p.identify).not.toHaveBeenCalled(); expect(p.respond).not.toHaveBeenCalled()
+  })
+  it('identifies a native-2 host in native-2 and echoes native-2 in the reply', async () => {
+    const p = ports(); const bridge = createNativeHostController(p); const op = command(V2, 'identify')
+    await bridge.receive(op, origin)
+    expect(p.identify.mock.calls[0][1]).toEqual({contract: V2, operationId: op.operationId, hostOrigin: origin})
+    expect(replies(p, op.operationId)).toEqual([expect.objectContaining({contract: V2, success: true, type: 'identify'})])
+  })
+  it('keeps native-1 replies in native-1', async () => {
+    const p = ports(); const bridge = createNativeHostController(p); const op = command(V1, 'identify')
+    await bridge.receive(op, origin)
+    expect(replies(p, op.operationId)).toEqual([expect.objectContaining({contract: V1, success: true})])
+  })
+  it('runs native-2 actions and capture-config with the native-2 context', async () => {
+    const p = ports(); const bridge = createNativeHostController(p)
+    await bridge.receive(command(V2, 'identify'), origin)
+    p.action.mockResolvedValueOnce({id: 'ticket'})
+    const ticket = command(V2, 'create-ticket', {title: 't'})
+    await bridge.receive(ticket, origin)
+    expect(p.action).toHaveBeenLastCalledWith('create-ticket', {title: 't'}, {contract: V2, operationId: ticket.operationId, hostOrigin: origin})
+    expect(replies(p, ticket.operationId)).toEqual([expect.objectContaining({contract: V2, success: true, result: {id: 'ticket'}})])
+    await bridge.receive(command(V2, 'capture-config', {enabled: true}), origin)
+    expect(p.configureCapture).toHaveBeenLastCalledWith(origin, {enabled: true}, V2)
+  })
+  it.each([[V1, V2], [V2, V1]])('refuses a %s identity being driven by %s commands (CONTRACT_MISMATCH, no action, no fence)', async (made, used) => {
+    const p = ports(); const bridge = createNativeHostController(p)
+    await bridge.receive(command(made, 'identify'), origin)
+    for (const type of ['create-ticket', 'list-tickets', 'upload-attachment', 'capture-config']) {
+      const op = command(used, type)
+      await bridge.receive(op, origin)
+      expect(replies(p, op.operationId)).toEqual([expect.objectContaining({contract: used, success: false, error: 'CONTRACT_MISMATCH'})])
+    }
+    expect(p.action).not.toHaveBeenCalled()
+    expect(p.configureCapture).toHaveBeenCalledTimes(1) // only the identify fence
+    const ok = command(made, 'list-tickets'); p.action.mockResolvedValueOnce({tickets: []})
+    await bridge.receive(ok, origin)
+    expect(replies(p, ok.operationId)).toEqual([expect.objectContaining({contract: made, success: true})])
+  })
+  it('re-identifying in the other contract first retires the old session in its own contract', async () => {
+    const p = ports(); const bridge = createNativeHostController(p)
+    await bridge.receive(command(V1, 'identify'), origin)
+    const upgrade = command(V2, 'identify')
+    await bridge.receive(upgrade, origin)
+    expect(p.action).toHaveBeenCalledWith('logout', {}, {contract: V1, operationId: upgrade.operationId, hostOrigin: origin}, 'previous')
+    expect(p.action.mock.invocationCallOrder[0]).toBeLessThan(p.identify.mock.invocationCallOrder[1])
+    expect(p.identify.mock.calls[1][1]).toEqual(expect.objectContaining({contract: V2}))
+    expect(replies(p, upgrade.operationId)).toEqual([expect.objectContaining({contract: V2, success: true})])
+    const ticket = command(V2, 'list-tickets'); p.action.mockResolvedValueOnce({tickets: []})
+    await bridge.receive(ticket, origin)
+    expect(replies(p, ticket.operationId)).toEqual([expect.objectContaining({success: true})])
+  })
+  it('accepts a logout in either contract and replies in the logout command contract', async () => {
+    const p = ports(); const bridge = createNativeHostController(p)
+    await bridge.receive(command(V2, 'identify'), origin)
+    const logout = command(V1, 'logout')
+    await bridge.receive(logout, origin)
+    expect(p.action).toHaveBeenCalledWith('logout', {}, {contract: V2, operationId: logout.operationId, hostOrigin: origin}, 'previous')
+    expect(replies(p, logout.operationId)).toEqual([expect.objectContaining({contract: V1, success: true, result: {loggedOut: true}})])
+  })
+  it('refuses an identify ACK whose contract differs from the command and retires that session', async () => {
+    const p = ports()
+    p.identify.mockImplementationOnce(async (_payload, context) => ({sessionToken: 'other', user: {id: 'u'},
+      nativeAck: {...context, contract: V1, audience, jti: crypto.randomUUID()}}))
+    const op = command(V2, 'identify')
+    await createNativeHostController(p).receive(op, origin)
+    expect(p.applyIdentity).not.toHaveBeenCalled()
+    expect(p.action).toHaveBeenCalledWith('logout', {}, {contract: V2, operationId: op.operationId, hostOrigin: origin}, 'other')
+    expect(replies(p, op.operationId)).toEqual([expect.objectContaining({contract: V2, success: false, error: 'ACK_INVALID'})])
+  })
+})
