@@ -0,0 +1,52 @@
+import { afterAll, afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createId } from '@quackback/ids'
+vi.mock('@/lib/server/db', async original => ({
+  ...await original<typeof import('@/lib/server/db')>(),
+  db: (await import('@/lib/server/__tests__/db-test-fixture')).testDb,
+}))
+vi.mock('@/lib/server/config', () => ({config: {baseUrl: 'https://feedback.example.test'}}))
+import { createDbTestFixture, testDb } from '@/lib/server/__tests__/db-test-fixture'
+import { session, user, widgetIdentifiedSession, sql } from '@/lib/server/db'
+import { bindNativeHostSession, consumeNativeHostToken, readNativeHostClaims, requireBoundNativeHostSession, retireNativeHostSession } from '../native-host-token'
+
+const audience = 'https://feedback.example.test'
+const hostOrigin = 'https://app.example.test'
+const V1 = 'iplaycafe.feedback/native-1' as const
+const V2 = 'iplaycafe.feedback/native-2' as const
+const fixture = await createDbTestFixture({probe: async db => {await db.execute(sql`select 1 from ipc_native_session_binding limit 0`)}})
+afterAll(fixture.close)
+
+function signed(contract: typeof V1 | typeof V2) {
+  const now = Math.floor(Date.now() / 1000)
+  const ipc = {contract, operationId: crypto.randomUUID(), hostOrigin}
+  return {ipc, claims: {aud: audience, jti: crypto.randomUUID(), iat: now, exp: now + 60, ipc}}
+}
+
+describe.skipIf(!fixture.available)('native-2 tokens on real PostgreSQL', () => {
+  beforeEach(fixture.begin)
+  afterEach(fixture.rollback)
+  it('redeems a native-2 token once; a replay of the same jti is refused in either contract', async () => {
+    const {ipc, claims} = signed(V2)
+    const read = readNativeHostClaims(claims, ipc, audience)
+    expect(read).not.toBeNull()
+    expect(await consumeNativeHostToken(read!)).toBe(true)
+    expect(await consumeNativeHostToken(read!)).toBe(false)
+    // The same jti relabelled native-1 is refused by the contract match before it reaches the store.
+    expect(readNativeHostClaims(claims, {...ipc, contract: V1}, audience)).toBeNull()
+  })
+  it('binds a native-2 session and serves and retires it from a native-2 context', async () => {
+    const {ipc, claims} = signed(V2)
+    const userId = createId('user'), principalId = createId('principal'), sessionId = crypto.randomUUID(), token = crypto.randomUUID()
+    await testDb.insert(user).values({id: userId, name: 'Synthetic native-2 session'})
+    await testDb.insert(session).values({id: sessionId, token, userId, scope: 'widget',
+      expiresAt: new Date(Date.now() + 60_000), createdAt: new Date(), updatedAt: new Date()})
+    await testDb.insert(widgetIdentifiedSession).values({sessionId, hmacVerified: true, identitySource: 'hmac'})
+    const read = readNativeHostClaims(claims, ipc, audience)!
+    expect(await consumeNativeHostToken(read)).toBe(true)
+    await bindNativeHostSession(sessionId, principalId, read)
+    await expect(requireBoundNativeHostSession(principalId, ipc, token)).resolves.toBe(sessionId)
+    await expect(retireNativeHostSession(token, ipc)).resolves.toEqual({loggedOut: true})
+    await expect(retireNativeHostSession(token, ipc)).resolves.toEqual({loggedOut: true})
+    await expect(requireBoundNativeHostSession(principalId, ipc, token)).rejects.toThrow('NATIVE_SESSION_BINDING_REQUIRED')
+  })
+})
