+
+// iPLAYCAFE: the portals run with AI_STRUCTURED_OUTPUT_STREAM=false (controller ai-adapter.ts), which
+// patch 04 implements by hiding the adapter's structuredOutputStream so the engine falls back to the
+// one-shot structuredOutput. Hold that path, and the prompt-only { text } fallback, to the real engine.
+describe('structuredChat with AI_STRUCTURED_OUTPUT_STREAM=false on the real TanStack AI engine', () => {
+  beforeEach(() => {
+    ;(mockConfig as Record<string, unknown>).aiStructuredOutputStream = false
+  })
+  afterEach(() => {
+    delete (mockConfig as Record<string, unknown>).aiStructuredOutputStream
+  })
+
+  it('sends a one-shot json_schema request and returns the validated object', async () => {
+    stubProvider([(body) => (body.stream ? sse([delta({ role: 'assistant', content: '{"text":"no"}' }), delta({}, 'stop'), USAGE]) : completion('{"text":"ok"}'))])
+
+    const result = await structuredChat({
+      model: 'm-nonstream',
+      systemPrompts: ['sys'],
+      messages: [{ role: 'user', content: 'hi' }],
+      schema: OutputSchema,
+      maxTokens: 100,
+    })
+
+    expect(result).toEqual({ text: 'ok' })
+    expect(bodies).toHaveLength(1)
+    expect(bodies[0].stream).toBeFalsy()
+    expect(bodies[0]).toHaveProperty('response_format')
+  })
+
+  it('falls back to the prompt-described schema and reads the { text } result', async () => {
+    const rejection = () =>
+      new Response(
+        JSON.stringify({ error: { message: 'response_format json_schema is not supported', param: 'response_format' } }),
+        { status: 400, headers: { 'content-type': 'application/json' } }
+      )
+    stubProvider([rejection, (body) => (body.stream ? sse([delta({ role: 'assistant', content: '{"text":"ok"}' }), delta({}, 'stop'), USAGE]) : completion('{"text":"ok"}'))])
+
+    const result = await structuredChat({
+      model: 'm-nonstream-fallback',
+      systemPrompts: ['sys'],
+      messages: [{ role: 'user', content: 'hi' }],
+      schema: OutputSchema,
+      maxTokens: 100,
+    })
+
+    expect(result).toEqual({ text: 'ok' })
+    expect(bodies).toHaveLength(2)
+    expect(bodies[1].response_format).toEqual({ type: 'json_object' })
+  })
+})
