new file mode 100644
index 000000000..9dbfa515c
--- /dev/null
+++ b/apps/web/src/lib/server/auth/proxy-peers.ts
@@ -0,0 +1,21 @@
+import { BlockList, isIP } from 'node:net'
+
+/** Authenticate the TCP peer; native code still resolves admitted headers/hops. */
+export function configuredProxyPeer(peer: string | undefined,
+  cidrs = process.env.TRUSTED_PROXY_CIDRS): string | null {
+  if (!cidrs?.trim()) return null
+  if (!peer || !isIP(peer)) return 'unknown'
+  const list = new BlockList()
+  for (const value of cidrs.split(',')) {
+    const parts = value.trim().split('/')
+    const ip = parts[0]
+    const family = isIP(ip)
+    const max = family === 6 ? 128 : 32
+    if (parts.length === 2 && !/^[0-9]+$/.test(parts[1])) return peer
+    const prefix = parts.length === 1 ? max : Number(parts[1])
+    if (!family || parts.length > 2 || !Number.isInteger(prefix) || prefix < 0 || prefix > max) return peer
+    list.addSubnet(ip, prefix, family === 6 ? 'ipv6' : 'ipv4')
+  }
+  // null delegates to the unchanged native operator header/hop resolver.
+  return list.check(peer, isIP(peer) === 6 ? 'ipv6' : 'ipv4') ? null : peer
+}
