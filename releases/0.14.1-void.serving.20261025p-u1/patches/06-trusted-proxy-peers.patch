+import { describe, it, expect } from 'vitest'
+import { configuredProxyPeer } from '../proxy-peers'
+
+describe('exposed-origin trusted proxy seam', () => {
+  it('keeps native semantics when no CIDR policy is configured', () => {
+    expect(configuredProxyPeer('203.0.113.4', '')).toBeNull()
+  })
+  it.each(['203.0.113.4', '2001:db8:bad::1'])('ignores spoofed forwarding headers from untrusted peer %s', peer => {
+    expect(configuredProxyPeer(peer, '192.0.2.0/24')).toBe(peer)
+  })
+  it.each(['192.0.2.7','::ffff:192.0.2.7'])('delegates admitted peer %s to native config', peer => {
+    expect(configuredProxyPeer(peer, '192.0.2.0/24')).toBeNull()
+  })
+  it.each(['192.0.2.0/invalid', '192.0.2.0/99', 'garbage', '192.0.2.0/24/4', '192.0.2.0/24,',
+    '192.0.2.0/', '192.0.2.0/ ', '192.0.2.0/+0', '2001:db8::/', '2001:db8::/ '])('fails closed on malformed policy %s', policy => {
+    expect(configuredProxyPeer('192.0.2.7', policy)).toBe('192.0.2.7')
+  })
+  it.each([undefined, 'garbage'])('fails closed without a real peer %s', peer => {
+    expect(configuredProxyPeer(peer, '192.0.2.0/24')).toBe('unknown')
+  })
+  it('supports admitted IPv6 peers and keeps independent direct IPv6 clients', () => {
+    expect(configuredProxyPeer('2001:db8::1', '2001:db8::/32')).toBeNull()
+  })
+})
