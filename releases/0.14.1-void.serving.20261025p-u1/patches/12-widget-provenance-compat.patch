diff --git a/packages/db/drizzle/0298_widget_identity_source.sql b/packages/db/drizzle/0298_widget_identity_source.sql
new file mode 100644
--- /dev/null
+++ b/packages/db/drizzle/0298_widget_identity_source.sql
@@ -0,0 +1,22 @@
+-- Match the retained legacy provenance contract without rewriting any legacy row,
+-- default or constraint. Native databases derive their newly introduced field
+-- from the existing HMAC bit once, before the updated writer is started.
+LOCK TABLE widget_identified_session IN ACCESS EXCLUSIVE MODE;
+--> statement-breakpoint
+DO $$ BEGIN
+  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
+    WHERE table_schema = current_schema() AND table_name = 'widget_identified_session'
+      AND column_name = 'identity_source') THEN
+    ALTER TABLE widget_identified_session ADD COLUMN identity_source text;
+    UPDATE widget_identified_session SET identity_source = CASE
+      WHEN hmac_verified THEN 'hmac' ELSE 'unverified' END;
+    ALTER TABLE widget_identified_session
+      ALTER COLUMN identity_source SET DEFAULT 'unverified',
+      ALTER COLUMN identity_source SET NOT NULL;
+    ALTER TABLE widget_identified_session
+      ADD CONSTRAINT widget_identified_session_identity_source_check CHECK (
+        identity_source IN ('unverified', 'hmac', 'insforge_exchange')
+        AND (identity_source = 'hmac') = hmac_verified
+      );
+  END IF;
+END $$;
