diff --git a/apps/web/src/lib/server/functions/widget/__tests__/native-host-attachments-review.test.ts b/apps/web/src/lib/server/functions/widget/__tests__/native-host-attachments-review.test.ts
new file mode 100644
index 0000000..90a0ba2
--- /dev/null
+++ b/apps/web/src/lib/server/functions/widget/__tests__/native-host-attachments-review.test.ts
@@ -0,0 +1,138 @@
+/**
+ * Review follow-up for native upload-attachment intake: a `{fileId}` reference
+ * is complete (url/size are optional echoes the core never trusts), and a
+ * reused submissionId with a different report surfaces as the closed native
+ * code SUBMISSION_CONFLICT instead of opaque prose.
+ */
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+vi.mock('@tanstack/react-start', () => ({
+  createServerFn: () => {
+    let schema: { parse(value: unknown): unknown },
+      handler: (value: { data: unknown }) => Promise<unknown>
+    const fn = async (value: { data: unknown }) => handler({ data: schema.parse(value.data) })
+    fn.validator = (value: typeof schema) => {
+      schema = value
+      return fn
+    }
+    fn.handler = (value: typeof handler) => {
+      handler = value
+      return fn
+    }
+    return fn
+  },
+}))
+const ports = vi.hoisted(() => ({
+  auth: vi.fn(),
+  bound: vi.fn(),
+  create: vi.fn(),
+  bearer: 'synthetic-native-bearer',
+}))
+vi.mock('@/lib/server/functions/widget-auth', () => ({ requireWidgetAuth: ports.auth }))
+vi.mock('@/lib/server/widget/native-host-token', () => ({
+  requireBoundNativeHostSession: ports.bound,
+  retireNativeHostSession: vi.fn(),
+}))
+vi.mock('@tanstack/react-start/server', () => ({
+  getRequestHeaders: () => new Headers({ authorization: `Bearer ${ports.bearer}` }),
+}))
+vi.mock('@/lib/server/functions/tickets', () => ({ runCreateMyTicket: ports.create }))
+vi.mock('@/lib/server/db', () => ({ sql: vi.fn() }))
+import { nativeHostActionFn, nativeHostActionSchema } from '../native-host'
+import { nativeSubmissionDigest } from '@/lib/server/widget/native-submission'
+import { ValidationError } from '@/lib/shared/errors'
+const invoke = nativeHostActionFn as unknown as (args: { data: unknown }) => Promise<unknown>
+const context = {
+  contract: 'iplaycafe.feedback/native-1',
+  operationId: '00000000-0000-4000-8000-000000000005',
+  hostOrigin: 'https://app.example.test',
+}
+const ctx = {
+  principal: { type: 'user', id: 'synthetic-principal', role: 'user' },
+  user: { id: 'synthetic-user' },
+  scope: 'widget',
+}
+const submissionId = '00000000-0000-4000-8000-000000000006'
+const create = (attachments: unknown) => ({
+  type: 'create-ticket',
+  payload: { submissionId, ticket: { title: 'Broken save', attachments } },
+})
+beforeEach(() => {
+  vi.resetAllMocks()
+  ports.auth.mockResolvedValue(ctx)
+  ports.bound.mockResolvedValue('session')
+  ports.create.mockResolvedValue({ id: 'ticket_x' })
+})
+
+describe('native create-ticket {fileId}-only attachments', () => {
+  it('accepts a bare fileId reference and binds the digest to exactly what the host sent', async () => {
+    const attachments = [{ fileId: 'file_1' }, { fileId: 'file_2', size: 12 }]
+    await expect(invoke({ data: { context, action: create(attachments) } })).resolves.toEqual({
+      id: 'ticket_x',
+    })
+    const ticket = { title: 'Broken save', attachments }
+    expect(ports.create).toHaveBeenCalledWith(ctx, ticket, {
+      submissionId,
+      digest: nativeSubmissionDigest(ticket),
+    })
+    // A host echoing url later is a different report body, not a silent match.
+    expect(nativeSubmissionDigest(ticket)).not.toBe(
+      nativeSubmissionDigest({
+        ...ticket,
+        attachments: [{ fileId: 'file_1', url: '/api/storage/files/1.png' }, attachments[1]],
+      })
+    )
+    expect(ports.bound.mock.invocationCallOrder[0]).toBeLessThan(
+      ports.create.mock.invocationCallOrder[0]
+    )
+  })
+  it('keeps url and size optional but still type-checked when present', () => {
+    for (const ok of [{ fileId: 'f' }, { fileId: 'f', url: '/u' }, { fileId: 'f', size: 0 }]) {
+      expect(nativeHostActionSchema.safeParse(create([ok])).success).toBe(true)
+    }
+    for (const bad of [
+      {},
+      { fileId: '' },
+      { fileId: 'f', url: '' },
+      { fileId: 'f', size: -1 },
+      { fileId: 'f', size: 1.5 },
+      { fileId: 'f', size: '1' },
+      { url: '/u', size: 1 },
+    ]) {
+      expect(nativeHostActionSchema.safeParse(create([bad])).success).toBe(false)
+    }
+  })
+})
+
+describe('native create-ticket SUBMISSION_CONFLICT', () => {
+  it('maps the core conflict ValidationError to the closed native code', async () => {
+    ports.create.mockRejectedValueOnce(
+      new ValidationError('SUBMISSION_CONFLICT', 'Submission ID already has a different report')
+    )
+    await expect(
+      invoke({ data: { context, action: create([{ fileId: 'file_1' }]) } })
+    ).rejects.toThrow(/^SUBMISSION_CONFLICT$/)
+  })
+  it('maps a conflict for a text-only report too', async () => {
+    ports.create.mockRejectedValueOnce(
+      Object.assign(new Error('Submission ID already has a different report'), {
+        code: 'SUBMISSION_CONFLICT',
+      })
+    )
+    const action = { type: 'create-ticket', payload: { submissionId, ticket: { title: 'Text' } } }
+    await expect(invoke({ data: { context, action } })).rejects.toThrow(/^SUBMISSION_CONFLICT$/)
+  })
+  it('leaves other ticket refusals and the expiry mapping unchanged', async () => {
+    ports.create.mockRejectedValueOnce(
+      new ValidationError('VALIDATION_ERROR', 'Invalid attachment')
+    )
+    await expect(
+      invoke({ data: { context, action: create([{ fileId: 'file_1' }]) } })
+    ).rejects.toThrow('Invalid attachment')
+    ports.create.mockRejectedValueOnce(
+      Object.assign(new Error('gone'), { code: 'FILE_EXPIRED' })
+    )
+    await expect(
+      invoke({ data: { context, action: create([{ fileId: 'file_1' }]) } })
+    ).rejects.toThrow(/^ATTACHMENT_EXPIRED$/)
+  })
+})
