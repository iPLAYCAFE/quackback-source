@@ -0,0 +1,60 @@
+import { describe, it, expect, vi } from 'vitest'
+import { createNativeHostController } from '../native-host-controller'
+import type { NativeHostContext } from '@/lib/shared/widget/native-host'
+const origin = 'https://app.example.test'
+const audience = 'https://feedback.example.test'
+function command(type: string, payload: Record<string, unknown> = {}) {
+  return { contract: 'iplaycafe.feedback/native-1', operationId: crypto.randomUUID(), type, payload }
+}
+function ports() {
+  return {
+    audience,
+    clearIdentity: vi.fn(() => 'previous'),
+    applyIdentity: vi.fn(),
+    identify: vi.fn(
+      async (
+        _payload: Record<string, unknown>,
+        context: NativeHostContext
+      ): Promise<Record<string, unknown>> => ({
+        sessionToken: 'native-session',
+        user: { id: 'u' },
+        nativeAck: { ...context, audience, jti: crypto.randomUUID() },
+      })
+    ),
+    action: vi.fn(async (..._args: unknown[]): Promise<unknown> => ({ id: 'ticket_x' })),
+    respond: vi.fn(),
+    configureCapture: vi.fn(),
+  }
+}
+const replyFor = (p: ReturnType<typeof ports>, op: { operationId: string }) =>
+  p.respond.mock.calls
+    .map(([, , value]) => value)
+    .filter((value) => value.operationId === op.operationId)
+
+describe('native create-ticket SUBMISSION_CONFLICT reply', () => {
+  it('relays the closed code the facade throws', async () => {
+    const p = ports()
+    const bridge = createNativeHostController(p)
+    await bridge.receive(command('identify'), origin)
+    p.action.mockRejectedValueOnce(new Error('SUBMISSION_CONFLICT'))
+    const op = command('create-ticket', {
+      submissionId: crypto.randomUUID(),
+      ticket: { title: 'Broken save', attachments: [{ fileId: 'file_1' }] },
+    })
+    await bridge.receive(op, origin)
+    expect(replyFor(p, op)).toEqual([
+      expect.objectContaining({ success: false, error: 'SUBMISSION_CONFLICT' }),
+    ])
+  })
+  it('would hide the unmapped prose, which is why the facade maps it', async () => {
+    const p = ports()
+    const bridge = createNativeHostController(p)
+    await bridge.receive(command('identify'), origin)
+    p.action.mockRejectedValueOnce(new Error('Submission ID already has a different report'))
+    const op = command('create-ticket', { submissionId: crypto.randomUUID(), ticket: { title: 'x' } })
+    await bridge.receive(op, origin)
+    expect(replyFor(p, op)).toEqual([
+      expect.objectContaining({ success: false, error: 'NATIVE_OPERATION_FAILED' }),
+    ])
+  })
+})
