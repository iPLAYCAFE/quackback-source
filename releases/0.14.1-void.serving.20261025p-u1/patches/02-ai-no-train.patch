@@ -0,0 +1,62 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+// @ts-expect-error Node strip-types execution requires explicit source extensions.
+import { getOpenAIClientOptions, parseOpenAIHeaders } from '../client-options.ts'
+
+test('accepts string/null headers and rejects malformed configuration without exposing values', () => {
+  assert.deepEqual(parseOpenAIHeaders(undefined), {})
+  assert.deepEqual(parseOpenAIHeaders('{"Authorization":null,"X-Gateway":"synthetic"}'), {
+    authorization: null,
+    'x-gateway': 'synthetic',
+  })
+  for (const value of [
+    'secret malformed',
+    'null',
+    '[]',
+    '{"x-secret":42}',
+    '{"x-secret":true}',
+    '{"x bad":"secret"}',
+    '{"x":"secret\\nvalue"}',
+    '{"X":"secret","x":null}',
+  ]) {
+    assert.throws(() => parseOpenAIHeaders(value), {
+      message:
+        'Invalid OPENAI_DEFAULT_HEADERS: expected unique HTTP header names with string or null values',
+    })
+  }
+})
+test('wire overrides remove SDK Authorization and arbitrary headers on both Request and URL inputs', async () => {
+  const original = globalThis.fetch
+  const seen: Request[] = []
+  globalThis.fetch = Object.assign(async (input: string | URL | Request, init?: RequestInit) => {
+    seen.push(new Request(input, init))
+    return Response.json({})
+  }, { preconnect: original.preconnect })
+  try {
+    const options = getOpenAIClientOptions({
+      openaiApiKey: 'synthetic-key',
+      openaiBaseUrl: 'https://gateway.example/v1',
+      openaiDefaultHeaders:
+        '{"Authorization":null,"x-remove":null,"cf-aig-authorization":"Bearer synthetic-gateway"}',
+    })
+    for (const input of [
+      'https://gateway.example/v1/chat/completions',
+      new Request('https://gateway.example/v1/chat/completions'),
+    ]) {
+      await options.fetch(input, {
+        method: 'POST',
+        headers: { Authorization: 'Bearer synthetic-key', 'x-remove': 'old', 'x-keep': 'kept' },
+        body: '{}',
+      })
+    }
+    for (const request of seen) {
+      assert.equal(request.headers.has('authorization'), false)
+      assert.equal(request.headers.has('x-remove'), false)
+      assert.equal(request.headers.get('x-keep'), 'kept')
+      assert.equal(request.headers.get('cf-aig-authorization'), 'Bearer synthetic-gateway')
+    }
+    assert.equal(seen.length, 2)
+  } finally {
+    globalThis.fetch = original
+  }
+})
diff --git a/apps/web/src/lib/server/domains/ai/__tests__/no-train.regression.node.ts b/apps/web/src/lib/server/domains/ai/__tests__/no-train.regression.node.ts
