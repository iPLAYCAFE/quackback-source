@@ -0,0 +1,45 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+// @ts-expect-error Node strip-types execution requires explicit source extensions.
+import { noTrainRequest } from '../client-options.ts'
+
+for (const endpoint of ['chat/completions', 'embeddings', 'responses']) {
+  test(`forces deny while preserving routing for ${endpoint}`, async () => {
+    const req = await noTrainRequest(`https://openrouter.ai/api/v1/${endpoint}`, {
+      method: 'POST',
+      headers: { 'content-length': '1' },
+      body: JSON.stringify({
+        model: 'fake',
+        provider: { data_collection: 'allow', require_parameters: true, order: ['fake'] },
+      }),
+    })
+    assert.deepEqual((await req.json()).provider, {
+      data_collection: 'deny',
+      require_parameters: true,
+      order: ['fake'],
+    })
+    assert.equal(req.headers.has('content-length'), false)
+  })
+}
+test('handles Request bodies and adds deny to unconfigured routing', async () => {
+  const req = await noTrainRequest(
+    new Request('https://openrouter.ai/api/v1/chat/completions', { method: 'POST', body: '{}' })
+  )
+  assert.deepEqual((await req.json()).provider, { data_collection: 'deny' })
+})
+test('fails closed on unsupported bodies and provider shapes', async () => {
+  for (const body of ['bad', '[]', '{"provider":null}', '{"provider":"allow"}']) {
+    await assert.rejects(
+      noTrainRequest('https://openrouter.ai/api/v1/chat/completions', { method: 'POST', body })
+    )
+  }
+})
+test('does not change non-OpenRouter or lookalike hosts', async () => {
+  for (const host of ['api.openai.com', 'openrouter.ai.invalid']) {
+    const req = await noTrainRequest(`https://${host}/v1/chat/completions`, {
+      method: 'POST',
+      body: '{}',
+    })
+    assert.equal(await req.text(), '{}')
+  }
+})
diff --git a/apps/web/src/lib/server/domains/ai/client-options.ts b/apps/web/src/lib/server/domains/ai/client-options.ts
new file mode 100644
index 000000000..42b8b39ae
--- /dev/null
+++ b/apps/web/src/lib/server/domains/ai/client-options.ts
@@ -0,0 +1,88 @@
+/** Enforce routing at the wire boundary for every OpenRouter AI lane. */
+export async function noTrainRequest(
+  input: string | URL | Request,
+  init?: RequestInit
+): Promise<Request> {
+  const request = new Request(input, init)
+  const url = new URL(request.url)
+  if (url.hostname !== 'openrouter.ai' || request.method !== 'POST') return request
+  if (
+    !['/chat/completions', '/embeddings', '/responses'].some((path) => url.pathname.endsWith(path))
+  ) {
+    throw new Error('Unsupported OpenRouter AI endpoint')
+  }
+  const body: unknown = await request.clone().json()
+  if (!body || typeof body !== 'object' || Array.isArray(body))
+    throw new Error('Invalid AI request body')
+  const data = body as Record<string, unknown>
+  if (
+    data.provider !== undefined &&
+    (!data.provider || typeof data.provider !== 'object' || Array.isArray(data.provider))
+  ) {
+    throw new Error('Invalid AI provider routing')
+  }
+  data.provider = {
+    ...(data.provider as Record<string, unknown> | undefined),
+    data_collection: 'deny',
+  }
+  const headers = new Headers(request.headers)
+  headers.delete('content-length')
+  return new Request(request, { headers, body: JSON.stringify(data) })
+}
+
+export const noTrainFetch = async (
+  input: string | URL | Request,
+  init?: RequestInit
+): Promise<Response> => fetch(await noTrainRequest(input, init))
+
+type ClientConfig = {
+  openaiApiKey?: string
+  openaiBaseUrl?: string
+  openaiDefaultHeaders?: string
+}
+
+/** Server-only gateway options; errors never include configured header values. */
+export function parseOpenAIHeaders(value?: string): Record<string, string | null> {
+  if (!value) return {}
+  const message =
+    'Invalid OPENAI_DEFAULT_HEADERS: expected unique HTTP header names with string or null values'
+  try {
+    const parsed: unknown = JSON.parse(value)
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error(message)
+    const headers: Record<string, string | null> = Object.create(null)
+    for (const [name, entry] of Object.entries(parsed)) {
+      const key = name.toLowerCase()
+      if (
+        !/^[!#$%&'*+\-.^_`|~0-9a-z]+$/.test(key) ||
+        Object.hasOwn(headers, key) ||
+        (entry !== null && typeof entry !== 'string')
+      )
+        throw new Error(message)
+      if (entry !== null) new Headers([[key, entry]])
+      headers[key] = entry
+    }
+    return { ...headers }
+  } catch {
+    throw new Error(message)
+  }
+}
+
+/** All OpenAI SDK and TanStack clients share the same transport policy. */
+export function getOpenAIClientOptions(config: ClientConfig) {
+  const defaultHeaders = parseOpenAIHeaders(config.openaiDefaultHeaders)
+  return {
+    apiKey: config.openaiApiKey!,
+    baseURL: config.openaiBaseUrl!,
+    defaultHeaders,
+    fetch: async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+      const request = await noTrainRequest(input, init)
+      const headers = new Headers(request.headers)
+      // Apply at the wire boundary as well: adapters may reconstruct SDK defaults.
+      for (const [name, value] of Object.entries(defaultHeaders)) {
+        if (value === null) headers.delete(name)
+        else headers.set(name, value)
+      }
+      return fetch(new Request(request, { headers }))
+    },
+  }
+}
