--- /dev/null
+++ b/apps/web/src/lib/server/auth/mail-issuance.ts
@@ -0,0 +1,19 @@
+import {createHash,randomUUID} from 'node:crypto'
+import {withEmailOperationId} from '@quackback/email/idempotency'
+import {claimMailIssuance} from './mail-issuance-store'
+
+export async function runMailIssuance(input:{email:string;callbackURL:string;operationId?:string},send:()=>Promise<void>):Promise<void>{
+  // First-party callers reuse the occurrence across network retry. Legacy callers
+  // get a new server occurrence, persisted before any external side effect.
+  const occurrence=input.operationId??`${Date.now()}.${randomUUID()}`
+  const match=/^(\d{13})\.([a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12})$/i.exec(occurrence)
+  if(!match)throw new Error('MAIL_ISSUANCE_INVALID')
+  const age=Date.now()-Number(match[1])
+  if(age>10*60*1000||age< -120000)throw new Error('MAIL_ISSUANCE_EXPIRED')
+  const hash=(value:string)=>createHash('sha256').update(value).digest('hex')
+  const claimed=await claimMailIssuance({operationKey:hash(occurrence.toLowerCase()),payloadSha:hash(JSON.stringify({email:input.email.trim().toLowerCase(),callbackURL:input.callbackURL}))})
+  // Uncertainty is durable before dispatch. A retry never re-mints capabilities
+  // or re-evaluates signup policy, so a changed policy cannot become an oracle.
+  if(!claimed.fresh)return
+  await withEmailOperationId('portal-signin',claimed.id,send)
+}
