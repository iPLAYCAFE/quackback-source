@@ -0,0 +1,37 @@
+import {createHmac,timingSafeEqual} from 'node:crypto'
+import {readBodyWithLimit} from '@/lib/server/utils/read-body'
+import {inboundAcceptDomains,isEmailInboundConfigured,workspaceSlugFromInboundAddress} from './conversation.email-channel'
+import {currentMailSlug} from './conversation.mail-slug'
+import {parseInboundEmail} from './conversation.email-inbound'
+
+export const VOID_NORMALIZED_CONTENT_TYPE='application/vnd.iplaycafe.void-mail+json'
+export function isVoidInboundRequest(request:Request):boolean{return (request.headers.get('content-type')??'').split(';')[0].trim().toLowerCase()===VOID_NORMALIZED_CONTENT_TYPE}
+const reply=(status:number)=>Response.json({status:status===200?'accepted':'refused'},{status,headers:{'cache-control':'no-store'}})
+export async function handleVoidInboundEmail(request:Request):Promise<Response>{
+  const secret=process.env.EMAIL_VOID_INBOUND_SECRET
+  if(!secret||!isEmailInboundConfigured())return reply(503)
+  const timestamp=request.headers.get('x-qb-void-timestamp')??'',signature=request.headers.get('x-qb-void-signature')??''
+  if(!/^\d{10}$/.test(timestamp)||Math.abs(Date.now()/1000-Number(timestamp))>120||!/^[a-f0-9]{64}$/.test(signature))return reply(401)
+  const bytes=await readBodyWithLimit(request,10*1024*1024)
+  if(!bytes)return reply(413)
+  const expected=createHmac('sha256',secret).update(timestamp+'.void-normalized.').update(bytes).digest()
+  if(!timingSafeEqual(expected,Buffer.from(signature,'hex')))return reply(401)
+  try{
+    const value=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes))
+    if(value?.version!=='iplaycafe.void-mail/1'||!/^void-[a-f0-9]{64}$/.test(value.deliveryId)||!Number.isInteger(value.rawSize)||value.rawSize<1||value.rawSize>10*1024*1024||typeof value.envelopeTo!=='string'||typeof value.mailSlug!=='string'||!value.email||typeof value.email!=='object')return reply(400)
+    const at=value.envelopeTo.lastIndexOf('@'),named=workspaceSlugFromInboundAddress(value.envelopeTo)
+    if(value.mailSlug!==currentMailSlug()||named.kind!=='slug'||named.slug!==value.mailSlug||!inboundAcceptDomains().has(value.envelopeTo.slice(at+1).toLowerCase()))return reply(404)
+    const email=value.email
+    if(typeof email.from!=='string'||(email.text!==undefined&&typeof email.text!=='string')||(email.html!==undefined&&typeof email.html!=='string')||(!(typeof email.text==='string'||typeof email.html==='string')&&!(Array.isArray(email.attachments)&&email.attachments.some((a:any)=>typeof a?.content==='string'&&a.content.length>0)))||email.attachments!==undefined&&(!Array.isArray(email.attachments)||email.attachments.length>30||email.attachments.some((a:any)=>typeof a?.content!=='string'||!(/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/).test(a.content))))return reply(400)
+    const safeHeaders:Record<string,string>={}
+    // Raw MIME headers are sender-controlled. No forged Authentication-Results
+    // can upgrade the stock cold-inbound sender trust gate.
+    for(const [key,v]of Object.entries(email.headers??{}))if(typeof v==='string'&&/^(message-id|in-reply-to|references|reply-to|auto-submitted|x-auto-response-suppress|precedence|list-.+)$/i.test(key))safeHeaders[key]=v
+    const parsed=parseInboundEmail({...email,to:[value.envelopeTo],headers:safeHeaders})
+    parsed.transportMessageId=value.deliveryId
+    const {ingestParsedEmail}=await import('./conversation.email-inbound.service')
+    const result=await ingestParsedEmail(parsed)
+    // A rate-limited body has not been retained; force durable upstream retry.
+    return reply(result.status==='rate_limited'?429:200)
+  }catch{return reply(503)}
+}
