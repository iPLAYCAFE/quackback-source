diff --git a/packages/email/src/void.ts b/packages/email/src/void.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a24e1760122ac73790079c26923dae93c654a518
--- /dev/null
+++ b/packages/email/src/void.ts
@@ -0,0 +1,49 @@
+import type { EmailAttachment } from './attachment'
+import { currentEmailIdempotencyKey } from './idempotency'
+
+/** No provider text/cause survives into the application logger or SQL sink. */
+export class VoidEmailError extends Error {
+  readonly retryable = false
+  constructor(readonly code:string){super(`Void mail ${code}`);this.name='VoidEmailError'}
+}
+interface VoidSendRequest {
+  from:string;to:string;subject:string;html?:string;text?:string;replyTo?:string
+  headers?:Record<string,string>;attachments?:EmailAttachment[]
+}
+async function receipt(response:Response,logicalId:string):Promise<{state:string}|null>{
+  if(!response.ok||!response.body)return null
+  const reader=response.body.getReader();let size=0;const chunks:Uint8Array[]=[]
+  try{for(;;){const chunk=await reader.read();if(chunk.done)break;size+=chunk.value.length;if(size>4096)return null;chunks.push(chunk.value)}
+    const bytes=new Uint8Array(size);let offset=0;for(const chunk of chunks){bytes.set(chunk,offset);offset+=chunk.length}
+    const value=JSON.parse(new TextDecoder().decode(bytes))
+    return value?.logicalId===logicalId&&typeof value.state==='string'?{state:value.state}:null
+  }catch{return null}finally{void reader.cancel().catch(()=>{});reader.releaseLock()}
+}
+export async function sendViaVoid(request:VoidSendRequest):Promise<void>{
+  const logicalId=currentEmailIdempotencyKey()
+  // A content hash merges distinct notifications; a random key duplicates a
+  // retried notification. Only the business caller knows its stable identity.
+  if(!logicalId)throw new VoidEmailError('LOGICAL_ID_REQUIRED')
+  const base=process.env.EMAIL_VOID_URL!.replace(/\/$/,'')
+  const headers={'authorization':`Bearer ${process.env.EMAIL_VOID_TOKEN!}`,'content-type':'application/json'}
+  const regular:Record<string,string>={},threading:{inReplyTo?:string;references?:string}={}
+  for(const [key,value]of Object.entries(request.headers??{})){
+    if(key.toLowerCase()==='in-reply-to')threading.inReplyTo=value
+    else if(key.toLowerCase()==='references')threading.references=value
+    else if(key.toLowerCase()!=='message-id')regular[key]=value
+  }
+  const body=JSON.stringify({logicalId,from:request.from,to:request.to,subject:request.subject,
+    ...(request.html!==undefined?{html:request.html}:{}),...(request.text!==undefined?{text:request.text}:{}),
+    ...(request.replyTo?{replyTo:request.replyTo}:{}),...(Object.keys(regular).length?{headers:regular}:{}),
+    ...(Object.keys(threading).length?{threading}:{}),
+    ...(request.attachments?.length?{attachments:request.attachments.map(a=>({filename:a.filename,contentType:a.contentType,contentBase64:Buffer.from(a.content).toString('base64')}))}:{})})
+  if(Buffer.byteLength(body)>5*1024*1024)throw new VoidEmailError('PRIVATE_PORTAL_REQUIRED')
+  let result:{state:string}|null=null
+  try{result=await receipt(await fetch(base+'/send',{method:'POST',headers,body,signal:AbortSignal.timeout(75000),redirect:'error'}),logicalId)}catch{}
+  if(!result||result.state==='OUTCOME_UNKNOWN'){
+    // Read-only reconciliation: never another send on an ambiguous outcome.
+    try{result=await receipt(await fetch(base+'/receipt/'+logicalId,{headers,signal:AbortSignal.timeout(10000),redirect:'error'}),logicalId)}catch{}
+  }
+  if(result?.state==='PROVIDER_ACCEPTED'||result?.state==='DELIVERED')return
+  throw new VoidEmailError(result&&['REJECTED','BOUNCED','COMPLAINED'].includes(result.state)?result.state:'OUTCOME_UNKNOWN')
+}
