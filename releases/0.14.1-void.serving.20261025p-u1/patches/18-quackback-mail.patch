index 0000000000000000000000000000000000000000..0d048930e6af2cbf16c60f124fd710fffa7cfe86
--- /dev/null
+++ b/apps/web/src/lib/server/auth/mail-issuance-store.ts
@@ -0,0 +1,36 @@
+import {randomUUID} from 'node:crypto'
+import {db,sql} from '@/lib/server/db'
+
+const PREFIX='ipc-mail-issuance:v1:'
+const RETENTION_MS=30*24*60*60*1000
+/** Reuses auth operation storage, but never creates an auth-compatible value. */
+export async function claimMailIssuance(input:{operationKey:string;payloadSha:string}):Promise<{id:string;fresh:boolean}>{
+  try{
+    return await db.transaction(async tx=>{
+      await tx.execute(sql`SELECT pg_advisory_xact_lock(hashtextextended(${input.operationKey}, 8827))`)
+      // Same 30-day horizon as the platform provider's idempotency receipt. An
+      // expired client occurrence is refused before storage, so cleanup cannot
+      // resurrect a previously dispatched operation.
+      await tx.execute(sql`DELETE FROM verification WHERE identifier LIKE ${PREFIX+'%'} AND expires_at < now()`)
+      const rows=await tx.execute(sql`SELECT id,value FROM verification WHERE CASE WHEN identifier LIKE ${PREFIX+'%'} THEN value::jsonb->>'operationKey' ELSE NULL END = ${input.operationKey} LIMIT 2`) as unknown as Array<{id:string;value:string}>
+      if(rows.length>1)throw new Error('MAIL_ISSUANCE_CONFLICT')
+      if(rows.length){
+        const value=JSON.parse(rows[0].value)
+        if(value.version!=='mail-only/v1'||value.payloadSha!==input.payloadSha)throw new Error('MAIL_ISSUANCE_CONFLICT')
+        return {id:rows[0].id,fresh:false}
+      }
+      const id=randomUUID(),identifier=PREFIX+randomUUID()
+      const value=JSON.stringify({version:'mail-only/v1',operationKey:input.operationKey,payloadSha:input.payloadSha,state:'DISPATCHED'})
+      // Identifier is opaque and never returned to a client or placed in mail.
+      // Better Auth's magic-link verifier can look up/delete arbitrary tokens;
+      // a client-derivable namespace identifier would expose this dedupe fact.
+      // The value deliberately has no email/name/OTP/auth claim.
+      await tx.execute(sql`INSERT INTO verification(id,identifier,value,expires_at,created_at,updated_at) VALUES(${id},${identifier},${value},${new Date(Date.now()+RETENTION_MS)},now(),now())`)
+      return {id,fresh:true}
+    })
+  }catch(error){
+    if(error instanceof Error&&error.message==='MAIL_ISSUANCE_CONFLICT')throw error
+    // DB/provider errors may contain SQL values or connection URLs.
+    throw new Error('MAIL_ISSUANCE_UNAVAILABLE')
+  }
+}
diff --git a/apps/web/src/lib/server/auth/mail-issuance.ts b/apps/web/src/lib/server/auth/mail-issuance.ts
