+import { describe, it, expect, vi } from 'vitest'
+import { createNativeHostController } from '../native-host-controller'
+import { nativeHostCommandSchema, type NativeHostContext } from '@/lib/shared/widget/native-host'
+const origin = 'https://app.example.test'
+const audience = 'https://feedback.example.test'
+function command(type: string, payload: Record<string, unknown> = {}) {
+  return {
+    contract: 'iplaycafe.feedback/native-1',
+    operationId: crypto.randomUUID(),
+    type,
+    payload,
+  }
+}
+function ports() {
+  return {
+    audience,
+    clearIdentity: vi.fn(() => 'previous'),
+    applyIdentity: vi.fn(),
+    identify: vi.fn(
+      async (
+        _payload: Record<string, unknown>,
+        context: NativeHostContext
+      ): Promise<Record<string, unknown>> => ({
+        sessionToken: 'native-session',
+        user: { id: 'u' },
+        nativeAck: { ...context, audience, jti: crypto.randomUUID() },
+      })
+    ),
+    action: vi.fn(async (type: string, ..._rest: unknown[]): Promise<unknown> =>
+      type === 'logout' ? { loggedOut: true } : { fileId: 'file_x' }
+    ),
+    respond: vi.fn(),
+    configureCapture: vi.fn(),
+  }
+}
+const blob = () => new Blob([new Uint8Array([1, 2, 3])], { type: 'image/png' })
+const replyFor = (p: ReturnType<typeof ports>, op: { operationId: string }) =>
+  p.respond.mock.calls
+    .map(([, , value]) => value)
+    .filter((value) => value.operationId === op.operationId)
+
+describe('native upload-attachment command', () => {
+  it('is part of the closed native-1 command set and keeps the Blob by reference', () => {
+    const file = blob()
+    const parsed = nativeHostCommandSchema.parse(
+      command('upload-attachment', { file, name: 'a.png' })
+    )
+    expect(parsed.payload.file).toBe(file)
+    expect(
+      nativeHostCommandSchema.safeParse(command('attach', { file, name: 'a.png' })).success
+    ).toBe(false)
+  })
+  it('answers IDENTITY_REQUIRED before identify and from another parent origin, without uploading', async () => {
+    const p = ports()
+    const bridge = createNativeHostController(p)
+    const early = command('upload-attachment', { file: blob(), name: 'a.png' })
+    await bridge.receive(early, origin)
+    expect(replyFor(p, early)).toEqual([
+      expect.objectContaining({ success: false, error: 'IDENTITY_REQUIRED' }),
+    ])
+    await bridge.receive(command('identify'), origin)
+    const foreign = command('upload-attachment', { file: blob(), name: 'a.png' })
+    await bridge.receive(foreign, 'https://evil.example.test')
+    expect(replyFor(p, foreign)).toEqual([
+      expect.objectContaining({ success: false, error: 'IDENTITY_REQUIRED' }),
+    ])
+    expect(p.action).not.toHaveBeenCalled()
+  })
+  it('passes the identical Blob to the iframe port after identify and returns its result', async () => {
+    const p = ports()
+    const bridge = createNativeHostController(p)
+    await bridge.receive(command('identify'), origin)
+    const file = blob()
+    const op = command('upload-attachment', { file, name: 'a.png' })
+    await bridge.receive(op, origin)
+    expect(p.action).toHaveBeenCalledWith(
+      'upload-attachment',
+      { file, name: 'a.png' },
+      expect.objectContaining({
+        operationId: op.operationId,
+        hostOrigin: origin,
+      })
+    )
+    expect((p.action.mock.calls[0] as unknown[])[1]).toMatchObject({ file })
+    expect(((p.action.mock.calls[0] as unknown[])[1] as { file: Blob }).file).toBe(file)
+    expect(replyFor(p, op)).toEqual([
+      expect.objectContaining({ success: true, result: { fileId: 'file_x' } }),
+    ])
+  })
+  it('keeps closed refusal codes and hides any other failure text', async () => {
+    const p = ports()
+    const bridge = createNativeHostController(p)
+    await bridge.receive(command('identify'), origin)
+    p.action.mockRejectedValueOnce(new Error('ATTACHMENT_TYPE_REFUSED'))
+    const refused = command('upload-attachment', { file: blob(), name: 'a.exe' })
+    await bridge.receive(refused, origin)
+    expect(replyFor(p, refused)).toEqual([
+      expect.objectContaining({ success: false, error: 'ATTACHMENT_TYPE_REFUSED' }),
+    ])
+    p.action.mockRejectedValueOnce(new Error('storage said: key files/abc'))
+    const opaque = command('upload-attachment', { file: blob(), name: 'a.png' })
+    await bridge.receive(opaque, origin)
+    expect(replyFor(p, opaque)).toEqual([
+      expect.objectContaining({ success: false, error: 'NATIVE_OPERATION_FAILED' }),
+    ])
+  })
+  it('fences an in-flight upload result when the identity switches', async () => {
+    const p = ports()
+    const bridge = createNativeHostController(p)
+    await bridge.receive(command('identify'), origin)
+    let resolve!: (value: unknown) => void
+    p.action.mockImplementationOnce(
+      () =>
+        new Promise((r) => {
+          resolve = r
+        })
+    )
+    const op = command('upload-attachment', { file: blob(), name: 'a.png' })
+    const pending = bridge.receive(op, origin)
+    await bridge.receive(command('identify'), origin)
+    resolve({ fileId: 'file_old_identity' })
+    await pending
+    expect(replyFor(p, op)).toHaveLength(0)
+  })
+})
