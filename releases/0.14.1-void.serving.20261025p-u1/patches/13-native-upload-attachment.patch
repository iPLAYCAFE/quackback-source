+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { uploadNativeAttachment, isNativeAttachmentName } from '../native-host-attachment'
+import { clearWidgetToken, setWidgetToken } from '@/lib/client/widget-auth'
+import { MAX_ATTACHMENT_BYTES, MAX_VIDEO_ATTACHMENT_BYTES } from '@/lib/shared/files/file-types'
+
+interface Sent {
+  method: string
+  url: string
+  headers: Record<string, string>
+  body: unknown
+}
+const sent: Sent[] = []
+let respond: (xhr: FakeXhr) => void = () => {}
+
+/** The real shared composer helper runs; only the network object is fake. */
+class FakeXhr {
+  status = 0
+  responseText = ''
+  upload: { onprogress: ((event: ProgressEvent) => void) | null } = { onprogress: null }
+  onload: (() => void) | null = null
+  onerror: (() => void) | null = null
+  onabort: (() => void) | null = null
+  private request: Sent = { method: '', url: '', headers: {}, body: null }
+  open(method: string, url: string) {
+    this.request.method = method
+    this.request.url = url
+  }
+  setRequestHeader(key: string, value: string) {
+    this.request.headers[key.toLowerCase()] = value
+  }
+  abort() {
+    this.onabort?.()
+  }
+  send(body: unknown) {
+    this.request.body = body
+    sent.push(this.request)
+    queueMicrotask(() => respond(this))
+  }
+}
+function reply(status: number, body: unknown) {
+  respond = (xhr) => {
+    xhr.status = status
+    xhr.responseText = JSON.stringify(body)
+    xhr.onload?.()
+  }
+}
+const stored = {
+  fileId: 'file_01kexample',
+  url: '/api/storage/files/x.png',
+  name: 'report.png',
+  contentType: 'image/png',
+  size: 4,
+  family: 'image',
+}
+const bytes = () => new Uint8Array([0x89, 0x50, 0x4e, 0x47])
+
+beforeEach(() => {
+  sent.length = 0
+  vi.stubGlobal('XMLHttpRequest', FakeXhr)
+  setWidgetToken('synthetic-native-session')
+  reply(201, stored)
+})
+afterEach(() => {
+  vi.unstubAllGlobals()
+  clearWidgetToken()
+})
+
+describe('native upload-attachment', () => {
+  it('posts the exact Blob bytes through the widget file endpoint with the widget session', async () => {
+    const blob = new Blob([bytes()], { type: 'image/png' })
+    await expect(uploadNativeAttachment({ file: blob, name: 'report.png' })).resolves.toEqual({
+      fileId: stored.fileId,
+      url: stored.url,
+      name: 'report.png',
+      size: 4,
+      mimeType: 'image/png',
+    })
+    expect(sent).toHaveLength(1)
+    expect(sent[0].method).toBe('POST')
+    expect(sent[0].url).toBe('/api/widget/files?name=report.png')
+    expect(sent[0].headers.authorization).toBe('Bearer synthetic-native-session')
+    expect(sent[0].headers['content-type']).toBe('image/png')
+    const body = sent[0].body as File
+    expect(body).toBeInstanceOf(Blob)
+    expect(body.name).toBe('report.png')
+    expect(new Uint8Array(await body.arrayBuffer())).toEqual(bytes())
+  })
+  it('encodes the display name in the query and returns the stored name and type', async () => {
+    reply(201, { ...stored, name: 'รายงาน 1.webm', contentType: 'video/webm' })
+    const result = await uploadNativeAttachment({
+      file: new Blob([bytes()], { type: 'video/webm' }),
+      name: 'รายงาน 1.webm',
+    })
+    expect(sent[0].url).toBe(`/api/widget/files?name=${encodeURIComponent('รายงาน 1.webm')}`)
+    expect(result).toMatchObject({ name: 'รายงาน 1.webm', mimeType: 'video/webm' })
+  })
+  it.each([
+    ['a string', 'aGVsbG8='],
+    ['an ArrayBuffer', new ArrayBuffer(4)],
+    ['a typed array', bytes()],
+    ['a JSON-serialised Blob', JSON.parse(JSON.stringify(new Blob([bytes()])))],
+    ['null', null],
+  ])('refuses %s instead of a structured-clone Blob without any request', async (_label, file) => {
+    await expect(uploadNativeAttachment({ file, name: 'report.png' })).rejects.toThrow(
+      'ATTACHMENT_INVALID'
+    )
+    expect(sent).toHaveLength(0)
+  })
+  it('refuses an empty Blob and widened or missing payload keys', async () => {
+    const blob = new Blob([bytes()], { type: 'image/png' })
+    for (const payload of [
+      { file: new Blob([]), name: 'report.png' },
+      { file: blob },
+      { name: 'report.png' },
+      { file: blob, name: 'report.png', ticketId: 'ticket_x' },
+    ]) {
+      await expect(uploadNativeAttachment(payload)).rejects.toThrow('ATTACHMENT_INVALID')
+    }
+    expect(sent).toHaveLength(0)
+  })
+  it('refuses a Blob above the existing family cap before the network', async () => {
+    const image = new Blob([bytes()], { type: 'image/png' })
+    Object.defineProperty(image, 'size', { value: MAX_ATTACHMENT_BYTES + 1 })
+    await expect(uploadNativeAttachment({ file: image, name: 'report.png' })).rejects.toThrow(
+      'ATTACHMENT_TOO_LARGE'
+    )
+    const video = new Blob([bytes()], { type: 'video/webm' })
+    Object.defineProperty(video, 'size', { value: MAX_VIDEO_ATTACHMENT_BYTES + 1 })
+    await expect(uploadNativeAttachment({ file: video, name: 'screen.webm' })).rejects.toThrow(
+      'ATTACHMENT_TOO_LARGE'
+    )
+    expect(sent).toHaveLength(0)
+  })
+  it('admits a video up to the video cap', async () => {
+    const video = new Blob([bytes()], { type: 'video/webm' })
+    Object.defineProperty(video, 'size', { value: MAX_ATTACHMENT_BYTES + 1 })
+    reply(201, { ...stored, contentType: 'video/webm', name: 'screen.webm' })
+    await expect(
+      uploadNativeAttachment({ file: video, name: 'screen.webm' })
+    ).resolves.toMatchObject({ mimeType: 'video/webm' })
+  })
+  it('refuses names that are empty, too long, path-like, padded or contain control characters', async () => {
+    const control = 'a' + String.fromCharCode(0) + '.png'
+    const newline = 'a' + String.fromCharCode(10) + '.png'
+    const del = 'a' + String.fromCharCode(127) + '.png'
+    for (const name of [
+      '',
+      'x'.repeat(256),
+      'dir/report.png',
+      'dir\\report.png',
+      '../report.png',
+      '..',
+      '.',
+      ' report.png',
+      'report.png ',
+      control,
+      newline,
+      del,
+      42,
+      undefined,
+    ]) {
+      expect(isNativeAttachmentName(name)).toBe(false)
+      await expect(uploadNativeAttachment({ file: new Blob([bytes()]), name })).rejects.toThrow(
+        'ATTACHMENT_INVALID'
+      )
+    }
+    expect(isNativeAttachmentName('x'.repeat(251) + '.png')).toBe(true)
+    expect(sent).toHaveLength(0)
+  })
+  it.each([
+    [413, { error: 'Over 25 MB', reason: 'too_large' }, 'ATTACHMENT_TOO_LARGE'],
+    [415, { error: 'Refused', reason: 'blocked' }, 'ATTACHMENT_TYPE_REFUSED'],
+    [400, { error: 'Empty', reason: 'empty' }, 'ATTACHMENT_INVALID'],
+    [
+      429,
+      { error: { code: 'RATE_LIMITED', message: 'Too many uploads, slow down' } },
+      'ATTACHMENT_RATE_LIMITED',
+    ],
+    [
+      401,
+      { error: { code: 'AUTH_REQUIRED', message: 'Valid widget session required' } },
+      'ATTACHMENT_UPLOAD_FAILED',
+    ],
+    [503, { error: 'File storage is not configured' }, 'ATTACHMENT_UPLOAD_FAILED'],
+    [500, { error: 'Upload failed' }, 'ATTACHMENT_UPLOAD_FAILED'],
+    [201, { url: '/api/storage/files/x.png' }, 'ATTACHMENT_UPLOAD_FAILED'],
+  ])('maps HTTP %i to a closed code', async (status, body, code) => {
+    reply(status, body)
+    await expect(
+      uploadNativeAttachment({
+        file: new Blob([bytes()], { type: 'image/png' }),
+        name: 'report.png',
+      })
+    ).rejects.toThrow(new RegExp(`^${code}$`))
+  })
+  it('maps a transport failure to ATTACHMENT_UPLOAD_FAILED', async () => {
+    respond = (xhr) => xhr.onerror?.()
+    await expect(
+      uploadNativeAttachment({ file: new Blob([bytes()]), name: 'report.png' })
+    ).rejects.toThrow('ATTACHMENT_UPLOAD_FAILED')
+  })
+})
