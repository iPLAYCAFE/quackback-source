+  },
+})
+beforeEach(() => {
+  vi.resetAllMocks()
+  ports.auth.mockResolvedValue(ctx)
+  ports.bound.mockResolvedValue('session')
+  ports.create.mockResolvedValue({ id: 'ticket_x' })
+})
+describe('native create-ticket attachments', () => {
+  it('passes uploaded file references to the native ticket core with an attachment-bound digest', async () => {
+    const attachments = [attachment(1), attachment(2)]
+    await expect(invoke({ data: { context, action: create(attachments) } })).resolves.toEqual({
+      id: 'ticket_x',
+    })
+    const ticket = { title: 'Broken save', description: 'Screenshot attached', attachments }
+    expect(ports.create).toHaveBeenCalledWith(ctx, ticket, {
+      submissionId,
+      digest: nativeSubmissionDigest(ticket),
+    })
+    expect(nativeSubmissionDigest(ticket)).not.toBe(
+      nativeSubmissionDigest({ ...ticket, attachments: [attachment(1)] })
+    )
+    expect(ports.bound.mock.invocationCallOrder[0]).toBeLessThan(
+      ports.create.mock.invocationCallOrder[0]
+    )
+  })
+  it('strips host-only keys such as mimeType so the digest is stable for the same files', async () => {
+    await invoke({
+      data: {
+        context,
+        action: create([{ ...attachment(1), name: 'a.png', mimeType: 'image/png' }]),
+      },
+    })
+    expect(ports.create.mock.calls[0][1].attachments).toEqual([{ ...attachment(1), name: 'a.png' }])
+  })
+  it('accepts the conversation maximum and refuses more before any authority or ticket work', async () => {
+    const full = Array.from({ length: MAX_CONVERSATION_ATTACHMENTS }, (_, n) => attachment(n))
+    expect(nativeHostActionSchema.safeParse(create(full)).success).toBe(true)
+    await expect(
+      invoke({ data: { context, action: create([...full, attachment(99)]) } })
+    ).rejects.toThrow()
+    expect(ports.auth).not.toHaveBeenCalled()
+    expect(ports.create).not.toHaveBeenCalled()
+  })
+  it.each([
+    ['a reference without fileId', { url: '/api/storage/files/1.png', size: 1 }],
+    ['an empty fileId', { fileId: '', url: '/api/storage/files/1.png', size: 1 }],
+    ['a negative size', { fileId: 'file_1', url: '/api/storage/files/1.png', size: -1 }],
+    ['a missing url', { fileId: 'file_1', size: 1 }],
+  ])('refuses %s', async (_label, value) => {
+    await expect(invoke({ data: { context, action: create([value]) } })).rejects.toThrow()
+    expect(ports.create).not.toHaveBeenCalled()
+  })
+  it('keeps text-only native reports unchanged', async () => {
+    const action = {
+      type: 'create-ticket',
+      payload: { submissionId, ticket: { title: 'Text only' } },
+    }
+    await invoke({ data: { context, action } })
+    expect(ports.create).toHaveBeenCalledWith(
+      ctx,
+      { title: 'Text only' },
+      { submissionId, digest: nativeSubmissionDigest({ title: 'Text only' }) }
+    )
+  })
+  it('maps a swept upload to ATTACHMENT_EXPIRED and passes other refusals through', async () => {
+    ports.create.mockRejectedValueOnce(
+      Object.assign(new Error('This file is no longer available. Attach it again.'), {
+        code: 'FILE_EXPIRED',
+      })
+    )
+    await expect(invoke({ data: { context, action: create([attachment(1)]) } })).rejects.toThrow(
+      /^ATTACHMENT_EXPIRED$/
+    )
+    ports.create.mockRejectedValueOnce(
+      Object.assign(new Error('Invalid attachment'), { code: 'VALIDATION_ERROR' })
+    )
+    await expect(invoke({ data: { context, action: create([attachment(1)]) } })).rejects.toThrow(
+      'Invalid attachment'
+    )
+  })
+  it('refuses an unbound session before the ticket core sees any attachment', async () => {
+    ports.bound.mockRejectedValueOnce(new Error('NATIVE_SESSION_BINDING_REQUIRED'))
+    await expect(invoke({ data: { context, action: create([attachment(1)]) } })).rejects.toThrow(
+      'NATIVE_SESSION_BINDING_REQUIRED'
+    )
+    expect(ports.create).not.toHaveBeenCalled()
+  })
+  it('never routes upload-attachment through the server facade', () => {
+    expect(
+      nativeHostActionSchema.safeParse({ type: 'upload-attachment', payload: { name: 'a.png' } })
+        .success
+    ).toBe(false)
+  })
+})
