+/**
+ * Real-DB witness for native upload-attachment + create-ticket: a file the
+ * identified requester stored through the widget pipeline is linked to the
+ * native Ticket's opening message, a same-submission retry never relinks or
+ * duplicates it, and another principal's upload is refused before any Ticket,
+ * pair or native submission mapping exists. Runs in the rollback fixture.
+ */
+import { describe, it, expect, beforeEach, afterEach, afterAll, vi } from 'vitest'
+import {
+  createId,
+  type PrincipalId,
+  type TicketId,
+  type TicketStatusId,
+  type UserId,
+} from '@quackback/ids'
+
+vi.mock('@/lib/server/db', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/db')>()),
+  db: (await import('@/lib/server/__tests__/db-test-fixture')).testDb,
+}))
+vi.mock('@/lib/server/config', () => ({
+  config: { s3PublicUrl: undefined, baseUrl: 'http://localhost:3000' },
+  getBaseUrl: () => 'http://localhost:3000',
+}))
+vi.mock('@/lib/server/storage/s3', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/storage/s3')>()),
+  uploadObject: vi.fn(async (key: string) => `/api/storage/${key}?read=sig`),
+  getPublicUrlOrNull: (key: string | null | undefined) =>
+    key ? `/api/storage/${key}?read=fresh` : null,
+}))
+vi.mock('@/lib/server/storage/trusted-url', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/storage/trusted-url')>()),
+  isTrustedAttachmentUrl: (url: string) =>
+    typeof url === 'string' && url.startsWith('/api/storage/'),
+}))
+vi.mock('@/lib/server/jobs/job-queue', () => ({
+  enqueueJob: vi.fn(async () => ({ inserted: true, jobId: 'job_x' })),
+}))
+vi.mock('@/lib/server/realtime/conversation-channels', () => ({
+  publishTicketEvent: vi.fn(),
+  publishConversationEvent: vi.fn(),
+  publishConversationMessage: vi.fn(),
+  publishAgentConversationEvent: vi.fn(),
+  publishConversationUpdate: vi.fn(),
+  publishTyping: vi.fn(),
+}))
+vi.mock('../ticket.webhooks', () => ({
+  emitTicketCreated: vi.fn().mockResolvedValue(undefined),
+  emitTicketStatusChanged: vi.fn().mockResolvedValue(undefined),
+  emitTicketAssigned: vi.fn().mockResolvedValue(undefined),
+  emitTicketReplied: vi.fn().mockResolvedValue(undefined),
+  emitTicketNoteAdded: vi.fn().mockResolvedValue(undefined),
+  emitTicketExternalStatusChanged: vi.fn().mockResolvedValue(undefined),
+}))
+vi.mock('../../conversation/conversation.webhooks', () => ({
+  emitConversationCreated: vi.fn().mockResolvedValue(undefined),
+  emitMessageCreated: vi.fn().mockResolvedValue(undefined),
+  emitMessageNoteCreated: vi.fn().mockResolvedValue(undefined),
+  emitMessageDeleted: vi.fn().mockResolvedValue(undefined),
+  emitConversationStatusChanged: vi.fn().mockResolvedValue(undefined),
+  emitConversationAssigned: vi.fn().mockResolvedValue(undefined),
+  emitConversationPriorityChanged: vi.fn().mockResolvedValue(undefined),
+  emitConversationCsatSubmitted: vi.fn().mockResolvedValue(undefined),
+  emitConversationCsatCommentAdded: vi.fn().mockResolvedValue(undefined),
+}))
+vi.mock('../../conversation/conversation.notify', () => ({
+  notifyVisitorMessage: vi.fn().mockResolvedValue(undefined),
+  notifyAgentReply: vi.fn().mockResolvedValue(undefined),
+  notifyConversationStarted: vi.fn().mockResolvedValue(undefined),
+}))
+vi.mock('@/lib/server/domains/assistant/assistant.orchestrator', () => ({
+  runAssistantTurnForConversation: vi.fn().mockResolvedValue(undefined),
+}))
+
+import { createDbTestFixture, testDb } from '@/lib/server/__tests__/db-test-fixture'
+import {
+  conversationMessages,
+  files,
+  principal,
+  settings,
+  ticketConversations,
+  tickets,
+  ticketStatuses,
+  user,
+  and,
+  eq,
+  sql,
+} from '@/lib/server/db'
+import { ANONYMOUS_ACTOR, type Actor } from '@/lib/server/policy/types'
+import { createTicketCore } from '../ticket.service'
+import { storeFile } from '@/lib/server/domains/files/files.service'
+import { nativeSubmissionDigest } from '@/lib/server/widget/native-submission'
+
+const fixture = await createDbTestFixture({
+  probe: async (db) => {
+    await db.select({ id: ticketConversations.ticketId }).from(ticketConversations).limit(0)
+    await db.select({ id: files.id }).from(files).limit(0)
+    await db.execute(sql`select principal_id from ipc_native_submission limit 0`)
+  },
+})
+const suffix = () => `${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`
+const pdf = () => new TextEncoder().encode('%PDF-1.7\n' + 'x'.repeat(200))
+
+async function seedPrincipal(): Promise<PrincipalId> {
+  const userId = createId('user') as UserId
+  const principalId = createId('principal') as PrincipalId
+  await testDb.insert(user).values({ id: userId, name: `U-${suffix()}` })
+  await testDb
+    .insert(principal)
+    .values({ id: principalId, userId, role: 'user', type: 'user', createdAt: new Date() })
+  return principalId
+}
+function requesterActor(principalId: PrincipalId): Actor {
+  return { ...ANONYMOUS_ACTOR, principalId, principalType: 'user' }
+}
+async function seedDefaultStatus() {
+  await testDb
+    .insert(settings)
+    .values({ name: 'Test WS', slug: `test_${suffix()}`, createdAt: new Date() })
+  await testDb
+    .update(ticketStatuses)
+    .set({ isDefault: false })
+    .where(eq(ticketStatuses.isDefault, true))
+  await testDb.insert(ticketStatuses).values({
+    id: createId('ticket_status') as TicketStatusId,
+    name: 'T-Received',
+    slug: `t_received_${suffix()}`,
+    category: 'open',
+    publicStage: 'received',
+    position: 100,
+    isDefault: true,
+  })
+}
+async function upload(owner: PrincipalId) {
+  return storeFile({
+    bytes: pdf(),
+    name: 'report.pdf',
+    source: 'visitor',
+    uploadedById: owner,
+    unverifiedSender: false,
+  })
+}
+function nativeInput(requester: PrincipalId, fileId: string) {
+  // The wire shape the native facade admits; the core rebuilds the rest from the row.
+  const ticket = {
+    title: 'Broken save',
+    description: 'See the attached report',
+    attachments: [{ fileId, url: '/api/storage/claimed-by-host', size: 1 }],
+  }
+  return {
+    type: 'customer' as const,
+    ...ticket,
+    attachments: ticket.attachments as never,
+    requesterPrincipalId: requester,
+    withBackingConversation: true,
+    nativeSubmission: { submissionId: crypto.randomUUID(), digest: nativeSubmissionDigest(ticket) },
+  }
+}
+
+describe.skipIf(!fixture.available)('native Ticket attachments (real DB, rolled back)', () => {
+  beforeEach(fixture.begin)
+  afterEach(fixture.rollback)
+  afterAll(fixture.close)
+
+  it("links the requester's own upload to the opening message and replays without relinking", async () => {
+    await seedDefaultStatus()
+    const me = await seedPrincipal()
+    const row = await upload(me)
+    const input = nativeInput(me, row.id)
+    const created = await createTicketCore(input, requesterActor(me))
+    const [pair] = await testDb
+      .select()
+      .from(ticketConversations)
+      .where(eq(ticketConversations.ticketId, created.id as TicketId))
+    const messages = await testDb
+      .select()
+      .from(conversationMessages)
+      .where(eq(conversationMessages.conversationId, pair!.conversationId))
+    expect(messages).toHaveLength(1)
+    expect(messages[0]).toMatchObject({ principalId: me, senderType: 'visitor', ticketId: null })
+    expect(messages[0].attachments).toEqual([
+      expect.objectContaining({
+        fileId: row.id,
+        name: 'report.pdf',
+        contentType: 'application/pdf',
+        size: row.size,
+      }),
+    ])
+    const [linked] = await testDb.select().from(files).where(eq(files.id, row.id))
+    expect(linked.messageId).toBe(messages[0].id)
+    expect(linked.attachedAt).not.toBeNull()
+
+    const retried = await createTicketCore(input, requesterActor(me))
+    expect(retried.id).toBe(created.id)
+    expect(
+      await testDb
+        .select()
+        .from(conversationMessages)
+        .where(eq(conversationMessages.conversationId, pair!.conversationId))
+    ).toHaveLength(1)
+    const [after] = await testDb.select().from(files).where(eq(files.id, row.id))
+    expect(after.messageId).toBe(messages[0].id)
+    expect(after.attachedAt?.getTime()).toBe(linked.attachedAt?.getTime())
+  })
+
+  it("refuses another principal's upload before any Ticket, pair or submission mapping", async () => {
+    await seedDefaultStatus()
+    const me = await seedPrincipal()
+    const other = await seedPrincipal()
+    const foreign = await upload(other)
+    const input = nativeInput(me, foreign.id)
+    await expect(createTicketCore(input, requesterActor(me))).rejects.toThrow('Invalid attachment')
+    expect(
+      await testDb.select().from(tickets).where(eq(tickets.requesterPrincipalId, me))
+    ).toHaveLength(0)
+    const mapping = await testDb.execute(
+      sql`select 1 from ipc_native_submission where principal_id = ${me}`
+    )
+    expect(mapping).toHaveLength(0)
+    const [untouched] = await testDb
+      .select()
+      .from(files)
+      .where(and(eq(files.id, foreign.id)))
+    expect(untouched.messageId).toBeNull()
+    expect(untouched.attachedAt).toBeNull()
+  })
+})
