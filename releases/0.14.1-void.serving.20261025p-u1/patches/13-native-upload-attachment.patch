+// @vitest-environment happy-dom
+import { act, cleanup, renderHook } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const ports = vi.hoisted(() => ({ upload: vi.fn(), action: vi.fn() }))
+vi.mock('@tanstack/react-start', () => ({
+  createServerFn: () => {
+    const fn = Object.assign(async () => undefined, { validator: () => fn, handler: () => fn })
+    return fn
+  },
+}))
+vi.mock('@/lib/server/functions/widget/native-host', async (original) => ({
+  ...(await original<typeof import('@/lib/server/functions/widget/native-host')>()),
+  nativeHostActionFn: ports.action,
+}))
+vi.mock('@/lib/client/native-host-attachment', () => ({ uploadNativeAttachment: ports.upload }))
+vi.mock('../widget-native-capture', () => ({ configureNativeCapture: vi.fn() }))
+import { useNativeHostBridge } from '../use-native-host-bridge'
+
+const hostOrigin = 'https://app.example.test'
+const contract = 'iplaycafe.feedback/native-1'
+let replies: Array<Record<string, unknown>> = []
+function command(type: string, payload: Record<string, unknown>) {
+  return { contract, operationId: crypto.randomUUID(), type, payload }
+}
+async function send(value: ReturnType<typeof command>) {
+  await act(async () => {
+    window.dispatchEvent(
+      new MessageEvent('message', {
+        source: window.parent,
+        origin: hostOrigin,
+        data: { type: 'quackback:native', data: value },
+      })
+    )
+    for (let i = 0; i < 10; i++) await Promise.resolve()
+  })
+}
+function resultFor(value: ReturnType<typeof command>) {
+  return replies.find((reply) => reply.operationId === value.operationId)
+}
+beforeEach(() => {
+  replies = []
+  ports.upload.mockReset()
+  ports.action.mockReset()
+  vi.spyOn(window.parent, 'postMessage').mockImplementation(((message: {
+    payload: Record<string, unknown>
+  }) => {
+    replies.push(message.payload)
+  }) as typeof window.postMessage)
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(async (_url: string, init: { body: string }) => {
+      const body = JSON.parse(init.body) as { ipc: Record<string, unknown> }
+      return Response.json({
+        sessionToken: 'native-session',
+        user: { id: 'user_native', name: 'N', email: 'n@example.test', avatarUrl: null },
+        nativeAck: { ...body.ipc, audience: window.location.origin, jti: crypto.randomUUID() },
+      })
+    })
+  )
+})
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+})
+
+describe('native iframe upload-attachment routing', () => {
+  it('refuses before identify, then hands the same structured-clone Blob to the widget uploader', async () => {
+    renderHook(() =>
+      useNativeHostBridge(
+        () => {},
+        () => null
+      )
+    )
+    const blob = new Blob([new Uint8Array([1, 2, 3])], { type: 'image/png' })
+    const early = command('upload-attachment', { file: blob, name: 'report.png' })
+    await send(early)
+    expect(resultFor(early)).toMatchObject({
+      success: false,
+      error: 'IDENTITY_REQUIRED',
+      type: 'upload-attachment',
+    })
+    expect(ports.upload).not.toHaveBeenCalled()
+
+    const identify = command('identify', { ssoToken: 'synthetic-sso' })
+    await send(identify)
+    expect(resultFor(identify)).toMatchObject({ success: true })
+
+    const uploaded = {
+      fileId: 'file_x',
+      url: '/api/storage/files/x.png',
+      name: 'report.png',
+      size: 3,
+      mimeType: 'image/png',
+    }
+    ports.upload.mockResolvedValueOnce(uploaded)
+    const upload = command('upload-attachment', { file: blob, name: 'report.png' })
+    await send(upload)
+    expect(ports.upload).toHaveBeenCalledTimes(1)
+    expect(ports.upload.mock.calls[0][0].file).toBe(blob)
+    expect(ports.upload.mock.calls[0][0].name).toBe('report.png')
+    expect(ports.action).not.toHaveBeenCalled()
+    expect(resultFor(upload)).toMatchObject({
+      success: true,
+      result: uploaded,
+      hostOrigin,
+      contract,
+    })
+  })
+  it('returns the closed refusal code from the uploader', async () => {
+    renderHook(() =>
+      useNativeHostBridge(
+        () => {},
+        () => null
+      )
+    )
+    await send(command('identify', { ssoToken: 'synthetic-sso' }))
+    ports.upload.mockRejectedValueOnce(new Error('ATTACHMENT_RATE_LIMITED'))
+    const upload = command('upload-attachment', {
+      file: new Blob([new Uint8Array([1])]),
+      name: 'a.png',
+    })
+    await send(upload)
+    expect(resultFor(upload)).toMatchObject({ success: false, error: 'ATTACHMENT_RATE_LIMITED' })
+  })
+})
