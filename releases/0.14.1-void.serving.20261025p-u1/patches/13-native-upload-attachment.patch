@@ -0,0 +1,99 @@
+/**
+ * Native host `upload-attachment`: host-provided bytes become an ordinary
+ * Quackback file through the same widget upload endpoint and helper the
+ * messenger composer uses. The host never receives a storage credential; it
+ * gets a file id that only this identified requester can attach to a Ticket.
+ *
+ * The controller has already enforced the native identity gate and fences the
+ * reply by identity generation. This module validates the structured-clone
+ * Blob and name, uploads, and maps every refusal to a closed error code.
+ */
+import { uploadFile, UploadError } from '@/lib/client/files/upload-file'
+import { getWidgetAuthHeaders } from '@/lib/client/widget-auth'
+import { familyFor, maxBytesForFamily } from '@/lib/shared/files/file-types'
+import type { UploadedFile } from '@/lib/shared/conversation/types'
+
+export const NATIVE_ATTACHMENT_NAME_MAX = 255
+
+export interface NativeAttachmentResult {
+  fileId: string
+  url: string
+  name: string
+  size: number
+  mimeType: string
+}
+
+export type NativeAttachmentUpload = (file: File) => Promise<UploadedFile>
+
+const defaultUpload: NativeAttachmentUpload = (file) =>
+  uploadFile(file, { endpoint: '/api/widget/files', headers: getWidgetAuthHeaders() })
+
+/** A display name only: no path, no control character, no dot-only name. */
+export function isNativeAttachmentName(value: unknown): value is string {
+  if (typeof value !== 'string') return false
+  const length = [...value].length
+  if (length < 1 || length > NATIVE_ATTACHMENT_NAME_MAX) return false
+  if (value.trim() !== value || /^\.+$/.test(value)) return false
+  for (const character of value) {
+    const code = character.codePointAt(0) ?? 0
+    if (code < 0x20 || code === 0x7f || character === '/' || character === '\\') return false
+  }
+  return true
+}
+
+function refusal(code: string): Error {
+  return new Error(code)
+}
+
+/** Server and transport refusals, by the reason the shared helper reports. */
+function mapUploadError(error: unknown): Error {
+  const reason = error instanceof UploadError ? error.reason : undefined
+  if (reason === 'too_large') return refusal('ATTACHMENT_TOO_LARGE')
+  if (reason === 'blocked') return refusal('ATTACHMENT_TYPE_REFUSED')
+  if (reason === 'empty') return refusal('ATTACHMENT_INVALID')
+  if (reason === 'rate_limited') return refusal('ATTACHMENT_RATE_LIMITED')
+  return refusal('ATTACHMENT_UPLOAD_FAILED')
+}
+
+export async function uploadNativeAttachment(
+  payload: Record<string, unknown>,
+  upload: NativeAttachmentUpload = defaultUpload
+): Promise<NativeAttachmentResult> {
+  const keys = Object.keys(payload)
+  if (keys.length !== 2 || !('file' in payload) || !('name' in payload)) {
+    throw refusal('ATTACHMENT_INVALID')
+  }
+  const { file, name } = payload
+  // A structured-clone Blob only. JSON, data URLs, strings and buffers are refused.
+  if (!(file instanceof Blob) || !isNativeAttachmentName(name)) throw refusal('ATTACHMENT_INVALID')
+  if (file.size <= 0) throw refusal('ATTACHMENT_INVALID')
+  if (file.size > maxBytesForFamily(familyFor(name, file.type)))
+    throw refusal('ATTACHMENT_TOO_LARGE')
+
+  let uploaded: UploadedFile
+  try {
+    uploaded = await upload(new File([file], name, { type: file.type }))
+  } catch (error) {
+    throw mapUploadError(error)
+  }
+  if (
+    !uploaded ||
+    typeof uploaded.fileId !== 'string' ||
+    !uploaded.fileId ||
+    typeof uploaded.url !== 'string' ||
+    !uploaded.url ||
+    typeof uploaded.size !== 'number'
+  ) {
+    throw refusal('ATTACHMENT_UPLOAD_FAILED')
+  }
+  return {
+    fileId: uploaded.fileId,
+    url: uploaded.url,
+    name: typeof uploaded.name === 'string' && uploaded.name ? uploaded.name : name,
+    size: uploaded.size,
+    mimeType:
+      typeof uploaded.contentType === 'string' && uploaded.contentType
+        ? uploaded.contentType
+        : 'application/octet-stream',
+  }
+}
diff --git a/apps/web/src/lib/server/domains/tickets/__tests__/native-ticket-attachments.test.ts b/apps/web/src/lib/server/domains/tickets/__tests__/native-ticket-attachments.test.ts
